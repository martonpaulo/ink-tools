{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    // The shared package lives outside this folder (#93); its react and react-native imports
    // resolve from this plugin's node_modules, as packages/ui-kit/plugin-config.js does for Metro.
    "paths": {
      "@ink-tools/ui-kit": ["../../packages/ui-kit/src"],
      "@ink-tools/ui-kit/*": ["../../packages/ui-kit/src/*"],
      // sn-adapter's official tier (#101); ink-core for the page types it names.
      "@ink-tools/sn-adapter/official": ["../../packages/sn-adapter/src/official"],
      "@ink-tools/ink-core": ["../../packages/ink-core/src"],
      "@ink-tools/ink-core/pinyin-data": ["../../packages/ink-core/pinyin-data"],
      // Ink2Pic's picture search, shared for the picture buttons (#125).
      "@ink-tools/picture-search": ["../../packages/picture-search/src"],
      // Its device and insert tiers, the file store and «Insert best picture» (#142).
      "@ink-tools/picture-search/*": ["../../packages/picture-search/src/*"],
      "*": ["./node_modules/@types/*", "./node_modules/*"]
    }
  },
  "include": ["**/*", "../../packages/ui-kit/src", "../../packages/sn-adapter/src/official"]
}
