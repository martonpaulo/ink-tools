{
  "name": "ink-tools-packages",
  "private": true,
  "workspaces": ["sn-adapter", "sync-core", "ink-core", "picture-search", "puzzle-core"],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "jest",
    "test:native": "node native-build/package-tests.cjs",
    "validate": "npm run typecheck && npm test && npm run test:native && npm run dry",
    "dry": "python3 ../scripts/dry_check.py --root picture-search"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.25.0",
    "@types/jest": "^29.5.13",
    "babel-jest": "^29.7.0",
    "jest": "^29.6.3",
    "typescript": "5.9.3"
  }
}
