{
  "gates": [
    {"name": "docs", "command": "python3 plugins/ink2pic/scripts/text_check.py . && python3 plugins/ink2pic/scripts/issue_links.py .", "covers": "links, anchors, invisible characters and linked issue references in every Markdown file"},
    {"name": "packages", "command": "cd packages && npm run validate", "covers": "sn-adapter, sync-core and ink-core (ui-kit runs in the bridge and ink2pic gates, #93)"},
    {"name": "bridge", "command": "cd plugins/bridge && npm run validate", "covers": "the Bridge plugin and the ui-kit package's lint and tests"},
    {"name": "lingo", "command": "cd plugins/lingo && npm run validate", "covers": "the Lingo plugin"},
    {"name": "probe", "command": "cd plugins/probe && npm run validate", "covers": "the probe plugin and its JVM tests"},
    {"name": "snadb", "command": "cd cli/snadb && make validate", "covers": "the snadb CLI and its contract tests"},
    {"name": "design", "command": "node --test design/covers/", "covers": "the InkHub cover template filler"},
    {"name": "ink2pic", "command": "cd plugins/ink2pic && npm run validate", "covers": "the Ink2Pic plugin and its JVM tests"}
  ],
  "rules": [
    {"path": "*.md", "gates": ["docs"]},
    {"path": "docs/", "gates": ["docs"]},
    {"path": "gates.json", "gates": ["docs"]},
    {"path": "scripts/gates.py", "gates": ["docs"]},
    {"path": ".github/workflows/scan.yml", "gates": ["docs"]},
    {"path": "packages/", "gates": ["packages"]},
    {"path": "packages/ui-kit/", "gates": ["bridge", "ink2pic", "lingo"]},
    {"path": "packages/ink-core/", "gates": ["packages", "ink2pic"]},
    {"path": ".github/workflows/validate-packages.yml", "gates": ["packages"]},
    {"path": "plugins/bridge/", "gates": ["bridge"]},
    {"path": ".github/workflows/validate-bridge.yml", "gates": ["bridge"]},
    {"path": "plugins/lingo/", "gates": ["lingo"]},
    {"path": ".github/workflows/validate-lingo.yml", "gates": ["lingo"]},
    {"path": "plugins/probe/", "gates": ["probe"]},
    {"path": ".github/workflows/validate-probe.yml", "gates": ["probe"]},
    {"path": "cli/snadb/", "gates": ["snadb"]},
    {"path": ".github/workflows/validate-snadb.yml", "gates": ["snadb"]},
    {"path": "plugins/ink2pic/", "gates": ["ink2pic"]},
    {"path": ".github/workflows/validate-ink2pic.yml", "gates": ["ink2pic"]},
    {"path": "design/", "gates": ["design"]}
  ]
}
