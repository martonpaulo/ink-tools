class Failure(Exception):
    """A failed call, carrying the stable exit code and the fields a JSON reader sees."""

    def __init__(self, code: int, kind: str, message: str, next_step: str = "", cause: str = "", extra=None, text: str = ""):
        super().__init__(message)
        self.code = code
        self.kind = kind
        self.message = message
        advised_cause, advised_step = FAILURE_ADVICE[kind]
        self.cause = cause or advised_cause
        self.next_step = next_step or advised_step
        self.extra = extra or {}
        self.text = text  # what a plain reader sees on stdout alongside the error


USB_RESTORE = f"connect the USB cable and run: adb tcpip {ADB_PORT}"
REFUSED = "Connection refused"
# The service Android's Wireless debugging announces with its port, which is new after each restart (#1).
MDNS_CONNECT_SERVICE = "_adb-tls-connect._tcp"
MDNS_ROW_FIELDS = 3  # an `adb mdns services` row: instance name, service type, HOST:PORT
# What a failed connection says about the tablet, measured on a Manta: the first match decides.
# A refused port comes first: a stale `adb` server can repeat `No route to host` after the tablet woke with ADB off.
UNREACHABLE_STATES = (
    ((REFUSED,), "restarted", "ADB over Wi-Fi is off, usually after a restart", f"To restore it, {USB_RESTORE}", f"adb tcpip {ADB_PORT}"),
    (("No route to host",), "asleep", "the tablet is asleep, or its Wi-Fi is off", "Wake the tablet, then try again.", "inkctl status"),
    (("timed out", "not known", "nodename nor servname", "resolution"), "off_network", "the address does not answer on this network", f"Is it on this Wi-Fi? After a restart, {USB_RESTORE}", "inkctl status"),
)


def mdns_port(listing: str, host: str) -> str:
    """The port of the `adb mdns services` row of the TLS connect service at exactly `host`, else "".
    A row of another device never counts, so a stale announcement cannot redirect a command."""
    for line in listing.splitlines():
        fields = line.split()
        if len(fields) == MDNS_ROW_FIELDS and fields[1].rstrip(".") == MDNS_CONNECT_SERVICE:
            row_host, _, row_port = fields[2].rpartition(":")
            if row_host == host and row_port.isdigit():
                return row_port
    return ""


def unreachable(serial: str, evidence: str = "") -> Failure:
    """Name why the device does not answer, from what the connection attempt reported."""
    for needles, state, cause, advice, next_step in UNREACHABLE_STATES:
        if any(needle in evidence for needle in needles):
            return Failure(EXIT_UNREACHABLE, "unreachable", f"{serial}: {cause}. {advice}", next_step, cause, {"state": state})
    return Failure(
        EXIT_UNREACHABLE,
        "unreachable",
        f"{serial} does not answer. Is it on this Wi-Fi? After a restart, {USB_RESTORE}",
        extra={"state": "no_answer"},
    )


# The person's sentence for each copy key of an InternalFailure (#294).
INTERNAL_COPY = {
    "languageNotSet": "The handwriting language did not change on the tablet. Run inkctl lang get to see the folder, then try again; restart the tablet if it keeps failing.",
    "turnedOff": "This command is turned off in this version of inkctl because a firmware update changed a tablet feature it uses; run inkctl firmware check to see the change, then update Ink Tools.",
}
UNREAD = "unread"  # what the log says for a fingerprint or an app version that could not be read


class InternalFailure(Failure):
    """The Python adapter's failure value for a Supernote internal (#294, docs/architecture.md › Layer
    rules, «A failure reads as a sentence»), as sn-adapter's src/failure.ts defines it: the person
    reads one sentence, chosen by a copy key from INTERNAL_COPY; the agent's log carries the registry
    item, the method, the firmware fingerprint, the app versions and the whole cause chain."""

    def __init__(self, item_id: str, method: str, copy_key: str, environment: dict, cause, code: int = EXIT_FAILED):
        item = next((entry for entry in REGISTRY_ITEMS if entry["id"] == item_id), None)
        if item is None:
            raise ValueError(f"no registry item {item_id}")
        sentence = INTERNAL_COPY.get(copy_key)
        if not sentence:
            raise ValueError(f"no copy for {copy_key}")
        self.item, self.method, self.copy_key, self.environment, self.internal_cause = item, method, copy_key, environment, cause
        log = self.agent_log()
        super().__init__(code, "internal_failure", sentence, extra={"registry": item_id, "log": log}, text=log)

    def agent_log(self) -> str:
        """One header line of every field, then each cause with its stack, outermost first."""
        apps = ",".join(f"{app}@{version}" for app, version in self.environment.get("apps", {}).items()) or UNREAD
        header = " ".join((
            f"registry={self.item['id']}", f"level={self.item['level']}", f"owner={self.item['owner']}",
            f"active={self.item['active']}", f"method={self.method}",
            f"firmware={self.environment.get('firmware') or UNREAD}", f"apps={apps}",
        ))
        return "\n".join([header, *(f"cause {entry}" for entry in cause_chain(self.internal_cause))])


def require_on(item_id: str, method: str, device) -> None:
    """Before acting, the kill switch (#293): a command whose registry item is turned off stops and
    says so, with the item's reason in the log; it never takes another path."""
    item = next((entry for entry in REGISTRY_ITEMS if entry["id"] == item_id), None)
    if item is None:
        raise ValueError(f"no registry item {item_id}")
    if item["off"] is not None:
        raise InternalFailure(item_id, method, "turnedOff", device_environment(device),
                              f"{item_id} is turned off {item['off']}")


def cause_chain(cause) -> list[str]:
    """Each exception of the chain, outermost first, as `Class: message` and its stack; a loop ends it.
    A cause that is not an exception is one entry of its text."""
    chain, seen = [], set()
    while cause is not None and id(cause) not in seen:
        seen.add(id(cause))
        if not isinstance(cause, BaseException):
            chain.append(f"{type(cause).__name__}: {cause}")
            break
        stack = "".join(traceback.format_tb(cause.__traceback__)).rstrip()
        chain.append(f"{type(cause).__name__}: {cause}" + (f"\n{stack}" if stack else ""))
        cause = cause.__cause__ or cause.__context__
    return chain


def device_environment(device) -> dict:
    """The tablet's `Build.FINGERPRINT` and each vendor app's versionCode, in one shell call (#293, #294)."""
    output = device.shell(f"getprop {FINGERPRINT_PROPERTY}; pm list packages --show-versioncode")
    lines = output.splitlines()
    firmware = lines[0].strip() if lines else ""
    apps = {}
    for match in map(PACKAGE_VERSION.fullmatch, (line.strip() for line in lines[1:])):
        if match and match["package"].startswith(RATTA_PACKAGE_PREFIX):
            apps[match["package"]] = int(match["code"])
    return {"firmware": firmware, "apps": dict(sorted(apps.items()))}


def not_found(what: str, next_step: str = "") -> Failure:
    return Failure(EXIT_NOT_FOUND, "not_found", f"not found: {what}", next_step)


def bad_usage(message: str) -> Failure:
    return Failure(EXIT_USAGE, "usage", message)


def stale(message: str) -> Failure:
    return Failure(EXIT_STALE, "stale", f"{message}; take a new snapshot")


def remote_path(path: str) -> str:
    """A device path in its shared-storage spelling, case kept: relative to SHARED_ROOT, or an alias
    such as /sdcard resolved, as the note app answers a note opened under an alias by that alias, and
    Probe's test-note guard and Device Link's helper know only SHARED_ROOT (#312)."""
    if not path.startswith("/"):
        return f"{SHARED_ROOT}/{path}".rstrip("/")
    for alias in SHARED_ALIASES:
        if path == alias or path.startswith(f"{alias}/"):
            return SHARED_ROOT + path[len(alias):]
    return path


def read_address() -> str:
    address = os.environ.get("SUPERNOTE_ADDRESS", "")
    found = next((file for file in (ADDRESS_FILE, LEGACY_ADDRESS_FILE) if file.is_file()), None)
    if not address and found:
        lines = found.read_text().splitlines()
        address = lines[0].strip() if lines else ""
    if not address:
        raise bad_usage(f"no address; write the device's IP in {ADDRESS_FILE}")
    return address


def call_verb(args: tuple[str, ...]) -> str:
    """The name of an ADB call without its arguments, which may name a private note."""
    words = args[1].split() if args[0] in ("shell", "exec-out") and len(args) > 1 else []
    if words and SIMPLE_WORD.fullmatch(words[0]):
        return f"{args[0]} {words[0]}"
    return args[0]


class RunLog:
    """What one run did. It keeps verbs and timings, and only the masked result reaches a file or a terminal."""

    def __init__(self):
        self.trace = False
        self.paths = False
        self.secrets: list[str] = []
        self.calls: list[dict] = []
        self.started = time.monotonic()
        self.started_at = datetime.now(timezone.utc)

    def clean(self, text: str) -> str:
        for secret in self.secrets:
            text = text.replace(secret, ADDRESS_MASK)
        return CREDENTIAL.sub(CREDENTIAL_MASK, text)

    def call(self, args: tuple[str, ...], started: float, code) -> None:
        name = self.clean(" ".join(args) if self.paths else call_verb(args))
        entry = {"call": name, "seconds": round(time.monotonic() - started, TIMING_DIGITS), "exit": code}
        self.calls.append(entry)
        if self.trace:
            print(f"trace: {name} {entry['seconds']} s exit {code}", file=sys.stderr, flush=True)

    def seconds(self) -> float:
        """The run's time so far, as `inkctl history` and `--time` print it."""
        return round(time.monotonic() - self.started, TIMING_DIGITS)

    def finish(self, command: str, code: int, kind, before: str = "", after: str = "") -> None:
        """Add this run's line. A log that cannot be written never changes the command's result."""
        line = self.clean(json.dumps({
            "time": self.started_at.isoformat(timespec="seconds"),
            "command": command,
            "seconds": self.seconds(),
            "exit": code,
            "error": kind,
            "app_before": before,
            "app_after": after,
            "calls": self.calls,
        }, ensure_ascii=False))
        if self.trace:
            print(f"trace: {line}", file=sys.stderr, flush=True)
        try:
            append_history(line)
        except (OSError, ValueError) as error:
            print(f"inkctl: the run log was not written: {error}", file=sys.stderr)


def append_history(line: str) -> None:
    HISTORY_FILE.parent.mkdir(parents=True, exist_ok=True)
    HISTORY_FILE.touch(mode=PRIVATE_FILE_MODE, exist_ok=True)
    with HISTORY_FILE.open("a", encoding="utf-8") as stream:
        stream.write(f"{line}\n")
    if HISTORY_FILE.stat().st_size > HISTORY_MAX_BYTES:
        lines = HISTORY_FILE.read_text(encoding="utf-8", errors="replace").splitlines(keepends=True)
        handle, partial = tempfile.mkstemp(dir=HISTORY_FILE.parent, suffix=".partial")
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.writelines(lines[len(lines) // 2 :])
        os.replace(partial, HISTORY_FILE)


class Device:
    """One ADB connection. Every call has a time limit, so a silent device cannot hang an agent."""

    def __init__(self, serial: str, log: RunLog, wifi: str | None = None, link: str = LINK_WIFI):
        self.serial = serial  # the serial every call goes to: the USB one or the Wi-Fi address
        self.wifi = serial if wifi is None else wifi  # HOST:PORT of Wi-Fi ADB, or "" when none is recorded
        self.link = link
        self.log = log
        self.awake = False  # this run has woken the screen once
        self.screen: list[dict] | None = None  # the last screen read, until a call that can change the screen (#286)

    def adb(self, *args: str, timeout: float = CALL_TIMEOUT, serial: bool = True, stdin: bytes | None = None):
        """`stdin` carries a value that must never reach argv, such as a secret. Without one, the call
        reads nothing: `adb shell` forwards inherited input, so an earlier call would swallow a piped
        secret before `secret set` reads it."""
        prefix = ["adb", "-s", self.serial] if serial else ["adb"]
        if args and args[0] == "shell" and any(arg.startswith(SCREEN_CHANGING) for arg in args[1:]):
            self.screen = None
        started = time.monotonic()
        feed = {"input": stdin} if stdin is not None else {"stdin": subprocess.DEVNULL}
        try:
            done = subprocess.run([*prefix, *args], **feed, capture_output=True, timeout=timeout, check=False)
        except subprocess.TimeoutExpired as error:
            self.log.call(args, started, None)
            raise unreachable(self.serial) from error
        except FileNotFoundError as error:
            raise Failure(EXIT_FAILED, "no_adb", "adb is not installed") from error
        self.log.call(args, started, done.returncode)
        return done

    def stream(self, args: list[str], seconds: float):
        """Yield the lines a call prints, until it ends or the time limit passes."""
        started = time.monotonic()
        process = subprocess.Popen(
            ["adb", "-s", self.serial, *args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
        )
        pending = b""
        try:
            with selectors.DefaultSelector() as selector:
                selector.register(process.stdout, selectors.EVENT_READ)
                while (left := seconds - (time.monotonic() - started)) > 0 and selector.select(left):
                    chunk = os.read(process.stdout.fileno(), FOLLOW_CHUNK)
                    if not chunk:
                        if process.wait():
                            raise Failure(EXIT_FAILED, "device_error", f"{args[0]} ended with an error")
                        break
                    *complete, pending = (pending + chunk).split(b"\n")
                    yield from (line.decode(errors="replace").rstrip("\r") for line in complete)
            if pending:
                yield pending.decode(errors="replace")
        finally:
            process.kill()
            process.wait()
            self.log.call(tuple(args), started, process.returncode)

    def is_ready(self) -> bool:
        return self.adb("get-state").stdout.strip() == b"device"

    def request_connection(self) -> str:
        done = self.adb("connect", self.serial, timeout=CONNECT_TIMEOUT, serial=False)
        return (done.stdout + done.stderr).decode(errors="replace")

    def probe(self) -> str:
        """Empty when the Wi-Fi ADB port answers, otherwise why it does not."""
        if not self.wifi:
            return "no Wi-Fi address is recorded"
        host, _, port = self.wifi.rpartition(":")
        try:
            with socket.create_connection((host, int(port)), PROBE_TIMEOUT):
                return ""
        except OSError as error:
            return str(error)

    def connect(self) -> None:
        if self.is_ready():
            return
        if self.link == LINK_USB:  # `adb devices` listed it a moment ago; a cable has no connect step
            raise Failure(EXIT_UNREACHABLE, "unreachable", f"{self.serial} on USB is not ready; check the cable", "adb devices", extra={"state": "usb_not_ready"})
        reply = self.request_connection()
        if self.is_ready():
            return
        port_problem = self.probe()
        if not port_problem:  # the port answers, so the local ADB server holds a dead connection
            self.adb("kill-server", serial=False)
            reply = self.request_connection()
            if self.is_ready():
                return
        evidence = f"{port_problem} {reply}"
        if REFUSED in evidence and self.follow_mdns_port():
            return
        raise unreachable(self.serial, evidence)

    def follow_mdns_port(self) -> bool:
        """After a restart, Wireless debugging listens on a new port (#1): connect once to the port the
        tablet announces over mDNS, and only when the announced address is the stored one."""
        host, _, port = self.wifi.rpartition(":")
        listing = self.adb("mdns", "services", serial=False).stdout.decode(errors="replace")
        announced = mdns_port(listing, host)
        if not announced or announced == port:
            return False
        stored = self.serial
        moved = f"{host}:{announced}"
        self.log.secrets.insert(0, moved)  # before the bare host, so the whole address is masked
        self.serial = self.wifi = moved
        self.request_connection()
        if self.is_ready():
            return True
        self.serial = self.wifi = stored  # the failure names the stored address, which the owner knows
        return False

    def shell(self, command: str, timeout: float = CALL_TIMEOUT, missing: str = "") -> str:
        """Run a device shell command and return its output; `missing` names what a not-found is."""
        done = self.adb("shell", command, timeout=timeout)
        output = done.stdout.decode(errors="replace")
        if done.returncode == 0:
            return output
        problem = (done.stderr.decode(errors="replace") + output).strip()
        if missing and any(error in problem for error in NOT_FOUND_ERRORS):
            raise not_found(missing)
        raise Failure(EXIT_FAILED, "device_error", problem or f"device call failed: {command}")

    def wake(self) -> None:
        """Turn the screen on, doing nothing if it is on. `am start -W` hangs on a sleeping screen.
        Once per run: a second wake would only drop the screen read the run already holds. The key
        press is sent only when the power state does not read Awake: it took 1.0 s of a 4.7 s
        `ink write` with the screen on (device round 13, #286)."""
        if self.awake:
            return
        if SCREEN_AWAKE not in self.shell("dumpsys power | grep -m1 mWakefulness= || true"):
            self.shell("input keyevent WAKEUP")
        self.awake = True

    def test(self, condition: str) -> bool:
        return self.shell(f"if [ {condition} ]; then echo yes; else echo no; fi").strip() == "yes"

    def activity(self) -> str:
        output = self.shell("dumpsys activity activities | grep -m1 mResumedActivity || true")
        match = RESUMED.search(output)
        return match.group(1) if match else ""

    def elements(self, attempts: int = DUMP_ATTEMPTS) -> list[dict]:
        for _ in range(attempts):
            dump = self.adb("exec-out", "uiautomator", "dump", "/dev/tty").stdout.decode(errors="replace")
            if IDLE_ERROR not in dump:
                self.screen = parse_elements(dump)
                return self.screen
        raise Failure(EXIT_BUSY, "busy", f"the screen did not settle after {attempts} tries; try again")

    def shown(self) -> list[dict]:
        """The screen read this run already holds, when no call since could have changed the screen; else a new read."""
        return self.screen if self.screen is not None else self.elements()

    def capture(self, destination: str) -> int:
        """Save a screen capture whole or not at all, and return its size."""
        data = self.adb("exec-out", "screencap", "-p").stdout
        if not data.startswith(PNG_SIGNATURE):
            raise Failure(EXIT_FAILED, "device_error", "the device did not return a PNG")
        folder = os.path.dirname(os.path.abspath(destination))
        handle, partial = tempfile.mkstemp(dir=folder, suffix=".partial")
        with os.fdopen(handle, "wb") as stream:
            stream.write(data)
        os.replace(partial, destination)
        return len(data)


def vertical_span(found: re.Match) -> tuple[int, int]:
    _, top, _, bottom = (int(value) for value in found.groups())
    return top, bottom


def has_more(node, list_bottom: int):
    """Whether a list continues below the screen, as far as one read can tell: True, False or None.

    shortcut: vertical lists only; add the right edge when a horizontal list matters."""
    edges = [BOUNDS.fullmatch(child.get("bounds", "")) for child in node]
    children = [vertical_span(found) for found in edges if found]
    if not children:
        return None
    top, bottom = max(children, key=lambda child: child[1])
    gap = list_bottom - bottom
    if gap <= LIST_EDGE:
        return True
    return False if gap >= bottom - top else None


def parse_elements(dump: str) -> list[dict]:
    """The screen's addressable nodes, numbered. Ratta's custom views rarely set `clickable`, so
    a node counts when it has a resource id, a description or text, or when it can scroll."""
    start, end = dump.find(HIERARCHY_OPEN), dump.rfind(HIERARCHY_CLOSE)
    if start < 0 or end < 0:
        raise Failure(EXIT_FAILED, "device_error", f"no screen tree came back: {dump.strip()[:ERROR_EXCERPT]}")
    elements: list[dict] = []
    for node in ElementTree.fromstring(dump[start : end + len(HIERARCHY_CLOSE)]).iter("node"):
        element_id = node.get("resource-id", "").rpartition("/")[2]
        desc, text = node.get("content-desc", ""), node.get("text", "")
        match = BOUNDS.fullmatch(node.get("bounds", ""))
        scrollable = node.get("scrollable") == "true"
        if not match or not (element_id or desc or text or scrollable):
            continue
        left, top, right, bottom = (int(value) for value in match.groups())
        if right <= left or bottom <= top:
            continue
        elements.append({
            "ref": f"@e{len(elements) + 1}",
            "id": element_id,
            "desc": desc,
            "text": text,
            "class": node.get("class", "").rpartition(".")[2],
            "bounds": [left, top, right, bottom],
            "x": (left + right) // 2,
            "y": (top + bottom) // 2,
            "scrollable": scrollable,
            "more": has_more(node, bottom) if scrollable else None,
        })
    return elements


def take_snapshot(device: Device) -> dict:
    """Read the screen and remember where each reference points. Only positions and ids are kept:
    what the screen says stays out of the file."""
    activity = device.activity()
    elements = device.elements()
    snapshot = {"activity": activity, "elements": elements}
    pages = shown_pages(elements)
    if pages:
        # A paged screen says when more follows, as a scrolling list does (#5).
        snapshot["pages"] = {"page": pages[0], "total": pages[1], "more": pages[0] < pages[1]}
    save_snapshot(snapshot)
    return snapshot


def save_snapshot(snapshot: dict) -> None:
    SNAPSHOT_FILE.parent.mkdir(parents=True, exist_ok=True)
    kept = [{key: element[key] for key in ("ref", "id", "x", "y")} for element in snapshot["elements"]]
    SNAPSHOT_FILE.touch(mode=PRIVATE_FILE_MODE, exist_ok=True)
    SNAPSHOT_FILE.write_text(json.dumps({"activity": snapshot["activity"], "elements": kept}))


def snapshot_lines(snapshot: dict) -> list[str]:
    lines = [f"activity: {snapshot['activity']}"]
    for element in snapshot["elements"]:
        labels = [f'{key}="{element[key]}"' for key in ("id", "desc", "text") if element[key]]
        lines.append(" ".join(part for part in (
            element["ref"] or "-", element["class"], *labels, str(element["bounds"]), list_mark(element),
        ) if part))
    if "pages" in snapshot:
        pages = snapshot["pages"]
        lines.append(f"pages {pages['page']} / {pages['total']} more={'yes' if pages['more'] else 'no'}")
    return lines


def list_mark(element: dict) -> str:
    if element.get("offscreen"):
        return "offscreen"
    if not element["scrollable"]:
        return ""
    more = {True: "yes", False: "no", None: "unknown"}[element["more"]]
    return f"scrollable more={more}"


def element_place(element: dict) -> tuple:
    return (element["id"], element["x"], element["y"])


def resolve_ref(device: Device, reference: str) -> dict:
    """A reference holds only for the screen it was read from; pressing an old one could draw on a note."""
    if not SNAPSHOT_FILE.is_file():
        raise stale("no snapshot yet")
    saved = json.loads(SNAPSHOT_FILE.read_text())
    if device.activity() != saved["activity"]:
        raise stale("the screen changed since the last snapshot")
    # One activity can show many screens, such as two notes, so the layout must also match.
    if [element_place(item) for item in device.elements()] != [element_place(item) for item in saved["elements"]]:
        raise stale("the screen changed since the last snapshot")
    for element in saved["elements"]:
        if element["ref"] == reference:
            return element
    raise not_found(f"{reference} in the last snapshot", "inkctl snapshot")


def find_selector(elements: list[dict], selector: str) -> list[dict]:
    key, separator, value = selector.partition(":")
    if not separator or key not in ("id", "desc", "text"):
        raise bad_usage(f"target must be @eN, id:X, desc:X or text:X, not: {selector}")
    return [element for element in elements if element[key] == value]


def resolve_target(device: Device, target: str) -> dict:
    if target.startswith("@"):
        return resolve_ref(device, target)
    matches = find_selector(device.elements(), target)
    if not matches:
        raise not_found(target, "inkctl snapshot")
    if len(matches) > 1:
        raise Failure(EXIT_NOT_FOUND, "ambiguous", f"{len(matches)} elements match {target}; use a snapshot reference")
    return matches[0]


def shared_path(path: str) -> str:
    """One spelling of a shared-storage path: absolute, case-folded (shared storage ignores case), aliases resolved."""
    path = "/" + posixpath.normpath(path).lstrip("/").casefold()
    for alias in SHARED_ALIASES:
        if path == alias or path.startswith(f"{alias}/"):
            path = SHARED_ROOT.casefold() + path[len(alias):]
    return path


def in_test_notes(path: str) -> bool:
    """Whether a path is the test notes folder or lies inside it (#193): those notes need no --allow-notes."""
    path, tests = shared_path(path), TEST_NOTES_FOLDER.casefold()
    return path == tests or path.startswith(f"{tests}/")


def touches_notes(path: str) -> bool:
    """Whether a path is the notes folder, holds it, lies inside it, or is a note."""
    path = shared_path(path)
    notes = NOTES_FOLDER.casefold()
    inside = path == notes or path.startswith(f"{notes}/")
    return inside or notes.startswith(f"{path.rstrip('/')}/") or path.endswith(NOTE_SUFFIX)


def test_note_on_screen(device: Device) -> bool:
    """Whether the open note is a test note: a title the note shows names a note under Note/Tests/
    and no note outside it. The shell cannot read the open note's path, so the title is the
    evidence; anything unproven counts as the owner's note (#193)."""
    titles = {element["text"] for element in device.elements() if element["id"] == NOTE_TITLE_ID and element["text"]}
    if not titles:
        return False
    found = device.shell(f"find {shlex.quote(NOTES_FOLDER)} -name '*{NOTE_SUFFIX}' 2>/dev/null; true").splitlines()
    named = [path for path in found if path.rpartition("/")[2].removesuffix(NOTE_SUFFIX) in titles]
    return bool(named) and all(in_test_notes(path) for path in named)


def plugin_view_fills_screen(device: Device) -> bool:
    """Whether a plugin view covers the whole screen, so no note shows behind it (#421): a node of
    the host's package whose bounds are the full screen. A screen that does not settle counts as none."""
    full = f'bounds="[0,0][{PAGE_WIDTH},{PAGE_HEIGHT}]"'
    for _ in range(DUMP_ATTEMPTS):
        dump = device.adb("exec-out", "uiautomator", "dump", "/dev/tty").stdout.decode(errors="replace")
        if IDLE_ERROR not in dump:
            return any(PLUGIN_VIEW_MARK in node and full in node for node in dump.split("<node")[1:])
    return False


def note_screen_allowed(device: Device, allow_notes: bool) -> bool:
    """A note on the screen is the owner's unless proven a test note, or hidden by a full-screen plugin view (#421)."""
    return (allow_notes or device.activity() != NOTE_ACTIVITY or test_note_on_screen(device)
            or plugin_view_fills_screen(device))


def protected(what: str) -> Failure:
    return Failure(EXIT_PROTECTED, "protected", f"{what} is protected; pass --allow-notes to read it")


def after_action(device: Device, args: argparse.Namespace, before: str, result: dict) -> tuple[dict, list[str]]:
    """Add what the action changed to its result, and the fresh views the caller asked for."""
    now = device.activity()
    result.update({"activity_before": before, "activity": now, "changed": before != now})
    lines = [f"activity: {before} -> {now}" if before != now else f"activity: {now}"]
    if args.screen and not note_screen_allowed(device, args.allow_notes):
        result["screen_refused"] = "a note is on the screen; pass --allow-notes to capture it"
        lines.append(f"screen: {result['screen_refused']}")
    elif args.screen:
        result["screen"] = args.screen
        result["screen_bytes"] = device.capture(args.screen)
        lines.append(f"screen: {args.screen}")
    if args.snapshot:
        snapshot = take_snapshot(device)
        result["elements"] = snapshot["elements"]
        lines.extend(snapshot_lines(snapshot)[1:])
    return result, lines


def press(device: Device, args: argparse.Namespace, x: int, y: int, result: dict) -> tuple[dict, str]:
    device.wake()
    before = device.activity()
    device.shell(f"input tap {x} {y}")
    result.update({"x": x, "y": y})
    done, lines = after_action(device, args, before, result)
    return done, "\n".join(lines)


def start_activity(device: Device, arguments: str) -> None:
    device.wake()
    output = device.shell(f"am start -W {arguments}".rstrip(), timeout=START_TIMEOUT)
    if "Error" in output or "Status: ok" not in output:
        raise Failure(EXIT_FAILED, "device_error", output.strip())


def save_open_note(device: Device, args: argparse.Namespace) -> dict:
    """Save the note open on screen through Device Link's `save-note` (#426). Opening another note by
    intent does not save the open one: a native lasso delete and a Collection paste were missing from
    the file after a switch (device round 10). A save that fails stops the switch."""
    try:
        return run_action(device, "device-link", "save-note", {}, args.timeout)
    except Failure as failure:
        raise Failure(failure.code, failure.kind, f"the open note did not save, so no other note was opened: {failure.message}", failure.next_step) from failure


def start_note(device: Device, args: argparse.Namespace, path: str, extras: list[str], page: int | None = None) -> tuple[dict, str]:
    """Open the note; with a page, also prove the page it shows before the screen is read. A note
    already open is saved first, so the switch keeps what was done on it (#426)."""
    before = device.activity()
    saved = save_open_note(device, args) if before == NOTE_ACTIVITY else None
    quoted = " ".join(shlex.quote(part) for part in extras)
    start_activity(device, f"-a android.intent.action.VIEW -n {NOTE_ACTIVITY} {quoted}")
    result, opened = {"path": path}, [f"opened: {path}"]
    if saved is not None:
        result["saved"] = saved.get("openNote")
        opened.insert(0, f"saved first: {saved.get('openNote')}")
    if page is not None:
        result["page"] = show_page(device, args, page)
        opened.append(f"page: {page}")
    done, lines = after_action(device, args, before, result)
    return done, "\n".join([*opened, *lines])


def page_counter(device: Device) -> int | None:
    """The page the note shows, counted from 1, read from the bottom bar's «N / total» counter."""
    for element in device.elements():
        found = PAGE_COUNTER.fullmatch(element["text"]) if element["id"] == NOTE_TITLE_ID else None
        if found:
            return int(found.group(1))
    return None


def show_page(device: Device, args: argparse.Namespace, page: int) -> int:
    """Move the open note to a page, counted from 1, and prove it from the page counter on screen.
    The note app ignores the `page` extra when the note was opened before and shows its last page
    (#220), so Probe's `jumpToPage` (from 0) does the move. Its `getCurrentPageNum` answer is not
    the shown page (late, and stuck on page 10 in the 2026-11-25 round), so the screen proves it."""
    helper_call(device, args, {"op": "jumpToPage", "page": page - 1})
    shown = None
    for _ in range(PAGE_READS):
        shown = page_counter(device)
        if shown == page:
            return page
        time.sleep(WAIT_INTERVAL)
    if shown is None:
        raise Failure(EXIT_FAILED, "device_error", "the note's page counter «N / total» is not on the screen", HELPER_LOG_STEP)
    raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", f"the note shows page {shown}, not page {page}", HELPER_LOG_STEP, extra={"page": shown})


def need_note_suffix(path: str) -> None:
    if not path.endswith(NOTE_SUFFIX):
        raise bad_usage(f"a note path ends in {NOTE_SUFFIX}: {path}")


def command_note_open(device: Device, args: argparse.Namespace):
    need_note_suffix(args.path)
    path = remote_path(args.path)
    extras = note_extras(path, args.page)
    if not device.test(f"-f {shlex.quote(path)}"):
        raise not_found(path)
    return start_note(device, args, path, extras, args.page)


def note_extras(path: str, page: int | None) -> list[str]:
    """The Launcher's extras; the page extra still serves a note opened for the first time."""
    extras = ["--es", "file_path", path, "--es", "from_app", "launcher"]
    if page is None:
        return extras
    if page < 1:
        raise bad_usage(f"a page is counted from 1: {page}")
    return extras + ["--ei", "page", str(page - 1)]


def fixture_rects(fixture: dict) -> dict:
    return {"label": FIXTURE_LABEL, **fixture["rects"]}


def fixture_line(fixture: dict) -> str:
    rects = "; ".join(f"{item} {rect}" for item, rect in fixture_rects(fixture).items())
    return f"{fixture['page']:>2} {fixture['name']}: {fixture['content']}. Rects: {rects}. Serves: {', '.join(fixture['serves'])}"


def find_fixture(name: str) -> dict:
    for fixture in FIXTURES:
        if fixture["name"] == name:
            return fixture
    raise bad_usage(f"no fixture is named {name!r}; the names: {', '.join(item['name'] for item in FIXTURES)}")


def command_fixture(device: Device, args: argparse.Namespace):
    """Open the fixtures note at a fixture's page and prove the page; optionally lasso one rect (#220)."""
    if args.list_fixtures:
        listed = [{**fixture, "rects": fixture_rects(fixture)} for fixture in FIXTURES]
        data = {"note": FIXTURES_NOTE, "map": FIXTURES_MAP, "fixtures": listed}
        return data, "\n".join([f"{FIXTURES_NOTE} (page map: {FIXTURES_MAP})", *map(fixture_line, FIXTURES)])
    if not args.name:
        raise bad_usage("name a fixture, or pass --list")
    fixture = find_fixture(args.name)
    rects = fixture_rects(fixture)
    if args.lasso and args.lasso not in rects:
        raise bad_usage(f"{fixture['name']} has no rect {args.lasso!r}; its rects: {', '.join(rects)}")
    if not device.test(f"-f {shlex.quote(FIXTURES_NOTE)}"):
        raise Failure(EXIT_NOT_FOUND, "not_found", f"{FIXTURES_NOTE} is not on the tablet; this command never creates it: rebuild it by hand as the page map says, {FIXTURES_MAP}", FIXTURES_MAP)
    data, text = start_note(device, args, FIXTURES_NOTE, note_extras(FIXTURES_NOTE, fixture["page"]), fixture["page"])
    data["fixture"] = fixture["name"]
    if args.lasso:
        left, top, right, bottom = rects[args.lasso]
        answer = helper_call(device, args, {"op": "lassoRect", "rect": {"left": left, "top": top, "right": right, "bottom": bottom}})
        data["lasso"], lassoed = lasso_answer(answer)
        text = f"{text}\n{lassoed}"
    return data, text


def command_note_new(device: Device, args: argparse.Namespace):
    """The Launcher's own call: the extras name the folder and the bare name, not the file."""
    need_note_suffix(args.path)
    path = remote_path(args.path)
    if device.test(f"-e {shlex.quote(path)}"):
        raise Failure(EXIT_EXISTS, "exists", f"{path} exists; a new note never replaces one")
    folder, _, name = path.rpartition("/")
    extras = [
        "--es", "file_path", folder,
        "--es", "currentPath", folder,
        "--ei", "note_mode", NOTE_MODE_NORMAL,
        "--es", "note_name", name.removesuffix(NOTE_SUFFIX),
        "--ez", "note_direction", "false",
        "--es", "note_style", NOTE_BLANK_STYLE,
    ]
    return start_note(device, args, path, extras)


class TableParser(html.parser.HTMLParser):
    """Every table cell's text and first link, row by row."""

    def __init__(self):
        super().__init__()
        self.rows: list[list[dict]] = []
        self.cell = None

    def handle_starttag(self, tag, attrs):
        if tag == "tr":
            self.rows.append([])
        elif tag in ("td", "th") and self.rows:
            self.cell = {"text": "", "link": ""}
            self.rows[-1].append(self.cell)
        elif tag == "a" and self.cell is not None and not self.cell["link"]:
            self.cell["link"] = dict(attrs).get("href") or ""

    def handle_endtag(self, tag):
        if tag in ("td", "th"):
            self.cell = None

    def handle_data(self, data):
        if self.cell is not None:
            self.cell["text"] = " ".join(f"{self.cell['text']} {data}".split())


def open_url(url: str):
    return urllib.request.urlopen(url, timeout=DOWNLOAD_READ_TIMEOUT)


def newest_firmware(column: str) -> dict:
    """The version and link in this model's column. A page that has changed stops the command."""
    with open_url(FIRMWARE_PAGE) as answer:
        table = TableParser()
        table.feed(answer.read().decode(errors="replace"))
    for header, row in zip(table.rows, table.rows[1:]):
        names = [cell["text"] for cell in header]
        if column in names and len(row) == len(names) and row[names.index(column)]["link"]:
            cell = row[names.index(column)]
            return {"version": cell["text"], "url": cell["link"]}
    raise Failure(EXIT_FAILED, "device_error", f"Ratta's page has no firmware for {column}; it may have changed", next_step=FIRMWARE_PAGE)


def version_tuple(text: str):
    """The three numbers of a public version. The tablet's build id holds none: it reads like E103.2610191001.2559."""
    match = VERSION_NUMBER.search(text)
    return tuple(int(part) for part in match[1].split(".")) if match else None


def network_failure(error: Exception) -> Failure:
    return Failure(EXIT_FAILED, "network_error", f"Ratta's site did not answer: {error}")


def refuse_firmware(message: str) -> Failure:
    return Failure(EXIT_FIRMWARE_REFUSED, "firmware_refused", message)


def need_official_source(url: str) -> None:
    parts = urllib.parse.urlsplit(url)
    if parts.scheme != "https" or parts.hostname != FIRMWARE_HOST:
        raise refuse_firmware(f"only https://{FIRMWARE_HOST} is accepted, not: {url}")


def download_firmware(url: str, destination: str) -> str:
    """Save the file and return its SHA-256. A redirect to another host stops before a byte is written."""
    need_official_source(url)
    digest = hashlib.sha256()
    started = time.monotonic()
    with open_url(url) as answer, open(destination, "wb") as stream:
        need_official_source(answer.geturl())
        while chunk := answer.read(FOLLOW_CHUNK):
            if time.monotonic() - started >= DOWNLOAD_TIMEOUT:
                raise Failure(EXIT_TIMEOUT, "timeout", f"the download took more than {DOWNLOAD_TIMEOUT:g} s")
            digest.update(chunk)
            stream.write(chunk)
    return digest.hexdigest()


def device_model(device: Device) -> str:
    """The tablet's model from its board, `Manta` or `Nomad`; the board name itself when it is not known."""
    return model_of_board(device.shell(f"getprop {BOARD_PROPERTY}"))


def model_of_board(board: str) -> str:
    board = board.strip()
    return BOARD_MODELS.get(board, board)


def environment_fingerprint(environment: dict) -> str:
    """SHA-256 of `Build.FINGERPRINT`, each vendor app with its versionCode in name order, and the
    registry's version (#293), the Helper's Watch.fingerprint text; versions are labels, never gates."""
    lines = [f"firmware={environment['firmware']}", *(f"{app}={code}" for app, code in sorted(environment["apps"].items())),
             f"registry={REGISTRY_VERSION}"]
    return hashlib.sha256("\n".join(lines).encode()).hexdigest()


def board_changed(device: Device):
    board = device.shell(f"getprop {BOARD_PROPERTY}").strip()
    return None if board in BOARD_MODELS else f"the board {board or '(empty)'} is none the registry names"


def route_probe(kind: str, name: str, dynamic: bool = False):
    """A probe over doctor's read-only check of one call: None when it holds; raises WatchUnknown when it cannot be seen now."""
    def probe(device: Device, seen: dict):
        exists = call_exists(device, {"kind": kind, "name": name, "dynamic": dynamic}, seen["providers"], seen["broadcasts"])
        if exists is None:
            raise WatchUnknown(f"the {kind} {name} registers only while its app runs; open the app and check again")
        return None if exists else f"no {kind} {name} on this firmware"
    return probe


class WatchUnknown(Exception):
    """A probe that cannot tell now: its item reads unprobed with this reason, never ok."""


# inkctl's own probes, by registry item (#293): each only reads. The Helper probes the providers,
# PluginHost's service, classes and call numbers on the tablet; the rest name their probe elsewhere.
WATCH_PROBES = {
    "note.activity": route_probe("activity", NOTE_ACTIVITY),
    "calendar.sync-broadcast": route_probe("receiver", CALENDAR_SYNC_ACTION, dynamic=True),
    "todo.sync-trigger": route_probe("provider", TASKS_URI),
    "pluginhost.plugin-list": route_probe("provider", PLUGIN_URI),
    "system.device-identity": lambda device, seen: board_changed(device),
}
WATCH_STATUSES = ("ok", "broken", "unprobed")
WATCH_FOLDER = Path.home() / ".cache/inkctl/watch"  # one result file per environment fingerprint
WATCH_LAST_FILE = WATCH_FOLDER / "last"  # the fingerprint inkctl last saw on connect
WATCH_CARD_ID = "firmware-check"  # the Inbox card each run updates, by this stable id
HELPER_WATCH_LINE = re.compile(r"watch (?P<fingerprint>[0-9a-f]+)(?P<items>.*)")


def helper_watch(device: Device) -> tuple[dict, str]:
    """The Helper's own results by item id, as {id: (status, detail)}, and why there are none."""
    try:
        code, answer = bridge_result(device, "watch", force=True)
    except Failure as failure:
        return {}, failure.message
    match = HELPER_WATCH_LINE.fullmatch(answer.removeprefix("ok ").removeprefix("failed ").strip())
    if code not in (BRIDGE_OK, BRIDGE_FAILED) or not match:
        return {}, f"the Ink Tools Helper did not answer the watch ({BRIDGE_RESULTS.get(code, code)}): {answer or 'no answer'}; {BRIDGE_NEXT_STEP}"
    results = {}
    for entry in match["items"].split(" | ")[1:]:
        item_id, _, rest = entry.partition(" ")
        status, _, detail = rest.partition(" ")
        if status in WATCH_STATUSES:
            results[item_id] = (status, detail)
    return results, ""


def watch_results(device: Device) -> list[dict]:
    """One result per registry item, in the registry's order: ok, broken with what changed, or
    unprobed with its reason. A kill switch that is off, or an item with no safe probe, is never probed."""
    seen = {"providers": device.shell(PROVIDERS_DUMP), "broadcasts": device.shell(BROADCASTS_DUMP)}
    helper, helper_missing = helper_watch(device)
    results = []
    for item in REGISTRY_ITEMS:
        probe = WATCH_PROBES.get(item["id"])
        if item["off"]:
            status, detail = "unprobed", f"turned off {item['off']}"
        elif item["unprobed"]:
            status, detail = "unprobed", item["unprobed"]
        elif probe:
            try:
                changed = probe(device, seen)
                status, detail = ("broken", changed) if changed else ("ok", "")
            except WatchUnknown as unknown:
                status, detail = "unprobed", str(unknown)
            except Failure as failure:
                status, detail = "broken", failure.message
        elif item["id"] in helper:
            status, detail = helper[item["id"]]
        elif item["probe"].startswith(BRIDGE_PROBE_PREFIX) and helper_missing:
            status, detail = "unprobed", helper_missing
        else:
            status, detail = "unprobed", f"probed by {item['probe']}"
        results.append({"id": item["id"], "level": item["level"], "owner": item["owner"], "status": status, "detail": detail})
    return results


def firmware_check(device: Device) -> tuple[dict, str]:
    """Every probe once: the table, its result file and the card object (#293)."""
    environment = device_environment(device)
    fingerprint = environment_fingerprint(environment)
    results = watch_results(device)
    broken = [result for result in results if result["status"] == "broken"]
    card = {
        "id": WATCH_CARD_ID,
        "title": f"Firmware check: {len(broken)} of {len(results)} internals broken" if broken else f"Firmware check: nothing broken in {len(results)} internals",
        "lines": [f"{result['id']} ({result['owner']}): {result['detail']}" for result in broken],
    }
    data = {
        "fingerprint": fingerprint, "firmware": environment["firmware"], "apps": environment["apps"],
        "registry": REGISTRY_VERSION, "items": results,
        "counts": {status: sum(result["status"] == status for result in results) for status in WATCH_STATUSES},
        "card": card,
    }
    WATCH_FOLDER.mkdir(parents=True, exist_ok=True)
    (WATCH_FOLDER / f"{fingerprint}.json").write_text(json.dumps(data, ensure_ascii=False, indent=1) + "\n")
    WATCH_LAST_FILE.write_text(fingerprint + "\n")
    lines = [f"fingerprint: {fingerprint}", f"firmware: {environment['firmware']}"]
    lines += [f"{result['id']}\t{result['level']}\t{result['status']}" + (f"\t{result['detail']}" if result["detail"] else "") for result in results]
    return data, "\n".join(lines)


def command_firmware_check(device: Device, args: argparse.Namespace):
    data, text = firmware_check(device)
    if data["counts"]["broken"]:
        raise Failure(EXIT_CALL_MISSING, "missing_call", f"{data['counts']['broken']} internals are broken on this firmware", extra=data, text=text)
    return data, text


def watch_on_connect(device: Device) -> None:
    """The fingerprint check on connect (#293): when the tablet's environment differs from the one
    inkctl last saw, run every probe once and say so on stderr. The first sighting only records it;
    a watch failure never stops the command that connected."""
    try:
        fingerprint = environment_fingerprint(device_environment(device))
        last = WATCH_LAST_FILE.read_text().strip() if WATCH_LAST_FILE.is_file() else ""
        if fingerprint == last:
            return
        if not last:
            WATCH_FOLDER.mkdir(parents=True, exist_ok=True)
            WATCH_LAST_FILE.write_text(fingerprint + "\n")
            return
        data, _ = firmware_check(device)
        print(f"inkctl: the tablet changed since the last run; firmware check: {data['counts']['broken']} broken, "
              f"{data['counts']['ok']} ok, {data['counts']['unprobed']} unprobed; details: inkctl firmware check", file=sys.stderr)
    except (Failure, OSError) as error:
        print(f"inkctl: the firmware check on connect did not run: {error}", file=sys.stderr)


def command_firmware(device: Device, args: argparse.Namespace):
    if args.action == "check":
        return command_firmware_check(device, args)
    installed = args.installed or device.shell("getprop ro.build.display.id").strip()
    model = device_model(device)
    column = FIRMWARE_COLUMNS.get(model)
    if not column:
        raise Failure(EXIT_FAILED, "device_error", f"no known firmware file for this model: {model}", next_step=FIRMWARE_PAGE)
    try:
        newest = newest_firmware(column)
    except (urllib.error.URLError, http.client.HTTPException, TimeoutError) as error:
        raise network_failure(error) from error
    published, current = version_tuple(newest["version"]), version_tuple(installed)
    if not published:
        raise Failure(EXIT_FAILED, "device_error", f"no version number in Ratta's page: {newest['version']}", next_step=FIRMWARE_PAGE)
    newer = published > current if current else None
    data = {"model": model, "installed": installed, "newest": newest["version"], "url": newest["url"], "newer": newer}
    answer = {True: "yes", False: "no", None: "unknown: pass --installed X.Y.Z, as Settings > About shows"}[newer]
    text = f"installed: {installed}\nnewest: {newest['version']}\nnewer: {answer}"
    if not args.download:
        return data, text
    if newer is None:
        raise refuse_firmware(f"this tablet's build id holds no public version; pass --installed X.Y.Z, as Settings > About shows: {installed}")
    if not newer:
        raise refuse_firmware(f"{newest['version']} is not newer than {installed}; a downgrade can cause a boot loop")
    url = newest["url"]
    need_official_source(url)
    level = re.search(r"level: (\d+)", device.shell("dumpsys battery | grep level"))
    if not level or int(level[1]) < FIRMWARE_MIN_BATTERY:
        raise refuse_firmware(f"the battery must be at {FIRMWARE_MIN_BATTERY}% or more")
    with tempfile.TemporaryDirectory() as folder:
        local = os.path.join(folder, os.path.basename(FIRMWARE_TARGET))
        try:
            digest = download_firmware(url, local)
        except (urllib.error.URLError, http.client.HTTPException, TimeoutError) as error:
            raise network_failure(error) from error
        if not zipfile.is_zipfile(local):
            raise refuse_firmware("the download is not a whole zip file")
        pushed = push_file(device, local, remote_path(FIRMWARE_TARGET), args.overwrite, FIRMWARE_TRANSFER_TIMEOUT)
    copied = device.shell(f"sha256sum {shlex.quote(pushed['path'])}", timeout=FIRMWARE_TRANSFER_TIMEOUT).split()
    if not copied or copied[0] != digest:
        raise Failure(EXIT_FAILED, "device_error", f"{pushed['path']} differs from the download; remove it before updating")
    data.update({"path": pushed["path"], "bytes": pushed["bytes"], "sha256": digest, "next": FIRMWARE_NEXT_STEP})
    return data, f"{text}\ncopied: {pushed['path']} ({pushed['bytes']} bytes)\n{FIRMWARE_NEXT_STEP}"


def call_exists(device: Device, call: dict, providers: str, broadcasts: str):
    """Read-only: ask the package manager, and start or send nothing. None means it cannot be known now."""
    if call["kind"] == "provider":
        return f"[{call['name'].removeprefix('content://').partition('/')[0]}]" in providers
    if call["kind"] == "activity":
        return "No activity found" not in device.shell(f"cmd package resolve-activity --brief -n {call['name']}")
    if "No receivers found" not in device.shell(f"cmd package query-receivers --brief -a {call['name']}"):
        return True
    if call["name"] in broadcasts:
        return True
    return None if call.get("dynamic") else False


def parse_package_routes(output: str) -> tuple[list[dict], list[dict]]:
    """The components with an intent filter, and the provider authorities, of one `dumpsys package`."""
    found: dict[tuple, dict] = {}
    providers, section, current, authority = [], "", None, ""
    for line in output.splitlines():
        if line.strip() and not line.startswith(" "):
            section, current = line.strip(), None
        elif section in ROUTE_KINDS:
            component, action = ROUTE_COMPONENT.fullmatch(line), ROUTE_ACTION.fullmatch(line)
            if component:
                kind = ROUTE_KINDS[section][0]
                current = found.setdefault((kind, component[1]), {"kind": kind, "name": component[1], "filters": [], "query": ROUTE_KINDS[section][1]})
            elif action and current and action[1] not in current["filters"]:
                current["filters"].append(action[1])
        elif section == PROVIDER_SECTION:
            named, provider = ROUTE_AUTHORITY.fullmatch(line), ROUTE_PROVIDER.fullmatch(line)
            if named:
                authority = named[1]
            elif provider:
                providers.append({
                    "authority": authority,
                    "component": provider[1],
                    "exported": None,
                    "operations": PROVIDER_OPERATIONS.get(authority),
                })
    return list(found.values()), providers


def add_component_details(device: Device, components: list[dict]) -> list[dict]:
    """Keep the exported components, with their permission, asked in one shell call."""
    if not components:
        return []
    script = "; ".join(
        f"echo {ROUTE_MARK}{index}; cmd package {component['query']} -n {shlex.quote(component['name'])}"
        for index, component in enumerate(components)
    )
    parts = device.shell(script, timeout=ROUTES_TIMEOUT).split(ROUTE_MARK)[1:]
    exported = []
    for part in parts:
        number, _, details = part.partition("\n")
        component = dict(components[int(number)])
        component.pop("query")
        state, permission = ROUTE_EXPORTED.search(details), ROUTE_PERMISSION.search(details)
        if state and state[1] == "true":
            exported.append({**component, "permission": permission[1] if permission and permission[1] != "null" else None})
    return exported


def package_routes(device: Device, package: str) -> dict:
    output = device.shell(f"dumpsys package {shlex.quote(package)}")
    if f"Package [{package}]" not in output:
        raise not_found(f"package {package}", "inkctl apps")
    components, providers = parse_package_routes(output)
    return {"package": package, "components": add_component_details(device, components), "providers": providers}


def route_lines(entry: dict) -> list[str]:
    lines = [f"package: {entry['package']}"]
    for item in entry["components"]:
        lines.append(f"{item['kind']}\t{item['name']}\tpermission={item['permission'] or '-'}\tfilters={','.join(item['filters']) or '-'}")
    for item in entry["providers"]:
        operations = "; ".join(f"{name}: {result}" for name, result in (item["operations"] or {}).items()) or "operations not proven"
        lines.append(f"provider\t{item['authority']}\t{item['component']}\t{operations}")
    return lines


def command_routes(device: Device, args: argparse.Namespace):
    if args.package:
        packages = [args.package]
    else:
        listed = device.shell("pm list packages").split()
        packages = sorted(line.removeprefix("package:") for line in listed if line.removeprefix("package:").startswith(RATTA_PACKAGE_PREFIX))
    entries = [package_routes(device, package) for package in packages]
    jobs = [{key: route[key] for key in ("job", "command", "kind", "name")} for route in JOB_ROUTES]
    lines = [line for entry in entries for line in route_lines(entry)]
    lines += [f"job\t{item['job']}\t{item['command']}\t{item['kind']} {item['name']}" for item in jobs]
    lines += [f"job\t{item['job']}\tneeds {item['needs']}" for item in JOBS_WITHOUT_ROUTE]
    return {"packages": entries, "jobs": jobs, "jobs_without_route": list(JOBS_WITHOUT_ROUTE)}, "\n".join(lines)


def command_doctor(device: Device, args: argparse.Namespace):
    firmware = device.shell("getprop ro.build.display.id").strip()
    providers = device.shell(PROVIDERS_DUMP)
    broadcasts = device.shell(BROADCASTS_DUMP)
    calls = [
        {"kind": call["kind"], "name": call["name"], "exists": call_exists(device, call, providers, broadcasts)}
        for call in DIRECT_CALLS
    ]
    data = {"firmware": firmware, "calls": calls, "missing": sum(call["exists"] is False for call in calls)}
    words = {True: "ok", False: "MISSING", None: "unknown"}
    lines = [f"firmware: {firmware}", *(f"{words[call['exists']]}\t{call['kind']}\t{call['name']}" for call in calls)]
    text = "\n".join(lines)
    if data["missing"]:
        raise Failure(EXIT_CALL_MISSING, "missing_call", f"{data['missing']} calls are gone from this firmware", extra=data, text=text)
    return data, text


def parse_listing(output: str) -> list[dict]:
    entries = []
    for match in map(LS_LINE.fullmatch, output.splitlines()):
        if match:
            entries.append({
                "name": match["name"].split(" -> ")[0].rpartition("/")[2],
                "type": "dir" if match["mode"].startswith("d") else "file",
                "bytes": int(match["size"]),
                "modified": f"{match['date']}T{match['time']}{match['hours']}:{match['minutes']}",
            })
    return entries


def command_status(device: Device, args: argparse.Namespace):
    output = device.shell(
        f"getprop ro.build.display.id; getprop {BOARD_PROPERTY}; wm size; dumpsys battery | grep level; "
        "dumpsys activity activities | grep -m1 mResumedActivity || true"
    )
    lines = output.splitlines()
    first = lines[0].strip() if output.strip() else ""
    board = lines[1] if len(lines) > 1 else ""
    size = re.search(r"Physical size: (\S+)", output)
    level = re.search(r"level: (\d+)", output)
    resumed = RESUMED.search(output)
    data = {
        "serial": device.serial,
        "model": model_of_board(board),
        "firmware": first,
        "screen": size.group(1) if size else "",
        "battery": int(level.group(1)) if level else None,
        "activity": resumed.group(1) if resumed else "",
        "link": device.link,
        # An answer over Wi-Fi proves Wi-Fi ADB is on (#37); over the cable the port is asked (#171).
        "wifi_adb": "on" if device.link == LINK_WIFI or not device.probe() else "off",
    }
    return data, "\n".join(f"{key}: {value}" for key, value in data.items())


def command_files_ls(device: Device, args: argparse.Namespace):
    path = remote_path(args.path)
    entries = parse_listing(device.shell(f"ls -lA --full-time {shlex.quote(path)}", missing=path))
    text = "\n".join(
        f"{entry['type']}\t{entry['bytes']}\t{entry['modified']}\t{entry['name']}" for entry in entries
    )
    return {"path": path, "entries": entries}, text


def transfer(device: Device, *args: str, missing: str, timeout: float = TRANSFER_TIMEOUT) -> None:
    done = device.adb(*args, timeout=timeout)
    if done.returncode == 0:
        return
    problem = (done.stderr.decode(errors="replace") + done.stdout.decode(errors="replace")).strip()
    if any(error in problem for error in NOT_FOUND_ERRORS):
        raise not_found(missing)
    raise Failure(EXIT_FAILED, "device_error", problem)


def command_files_pull(device: Device, args: argparse.Namespace):
    path = remote_path(args.path)
    if touches_notes(path) and not args.allow_notes and not in_test_notes(path):
        raise protected(path)
    transfer(device, "pull", path, args.local_path, missing=path)
    return {"path": path, "local": args.local_path}, f"pulled: {path} -> {args.local_path}"


def push_file(device: Device, local: str, path: str, overwrite: bool, timeout: float = TRANSFER_TIMEOUT) -> dict:
    """Copy one file and prove it arrived whole. A folder as destination keeps the file's name."""
    if not os.path.isfile(local):
        raise not_found(local)
    if device.test(f"-d {shlex.quote(path)}"):
        path = f"{path.rstrip('/')}/{os.path.basename(local)}"
    replaced = device.test(f"-e {shlex.quote(path)}")
    if replaced and not overwrite:
        raise exists_failure(path)
    transfer(device, "push", local, path, missing=local, timeout=timeout)
    size = int(device.shell(f"stat -c %s {shlex.quote(path)}").strip())
    if size != os.path.getsize(local):
        raise Failure(EXIT_FAILED, "device_error", f"{path} has {size} bytes after the copy, not {os.path.getsize(local)}")
    return {"path": path, "bytes": size, "replaced": replaced}


def command_files_push(device: Device, args: argparse.Namespace):
    data = push_file(device, args.local_path, remote_path(args.path), args.overwrite)
    return data, f"pushed: {data['path']} ({data['bytes']} bytes)"


def font_name(path: str) -> str:
    """The name the text-box font menu shows for a font file."""
    return os.path.splitext(os.path.basename(path))[0]


def is_font(name: str) -> bool:
    return name.lower().endswith(FONT_SUFFIXES)


def command_font_install(device: Device, args: argparse.Namespace):
    for local in args.files:
        name = os.path.basename(local)
        if not is_font(name):
            raise bad_usage(f"a font file ends in .ttf or .otf: {local}")
        if not FONT_NAME.match(name):
            raise bad_usage(f"a font file name holds only letters, digits, spaces, '.', '-' and '_': {name}")
        if not os.path.isfile(local):
            raise not_found(local)
    folder = remote_path(FONT_FOLDER)
    device.shell(f"mkdir -p {shlex.quote(folder)}")
    fonts = []
    for local in args.files:
        pushed = push_file(device, local, f"{folder}/{os.path.basename(local)}", args.overwrite)
        fonts.append({**pushed, "name": font_name(local)})
    lines = [f"installed: {font['path']} ({font['name']})" for font in fonts]
    return {"fonts": fonts, "next": FONT_NEXT_STEP}, "\n".join([*lines, FONT_NEXT_STEP])


def installed_fonts(device: Device) -> dict[str, list[str]]:
    """Each menu name in the font folder with its files (a .ttf and an .otf can share one); no
    folder is no font."""
    folder = remote_path(FONT_FOLDER)
    if not device.test(f"-d {shlex.quote(folder)}"):
        return {}
    fonts: dict[str, list[str]] = {}
    for line in sorted(device.shell(f"find {shlex.quote(folder)} -type f").splitlines()):
        path = line.strip()
        if is_font(path):
            fonts.setdefault(font_name(path), []).append(path)
    return fonts


def command_font_list(device: Device, args: argparse.Namespace):
    rows = [{"name": name, "files": paths} for name, paths in sorted(installed_fonts(device).items())]
    text = "\n".join(f"{row['name']}: {', '.join(row['files'])}" for row in rows)
    return {"fonts": rows}, text or f"no font in {FONT_FOLDER}"


def command_font_remove(device: Device, args: argparse.Namespace):
    paths = installed_fonts(device).get(args.name)
    if not paths:
        raise not_found(f"font {args.name} in {FONT_FOLDER}", "inkctl font list")
    if not args.yes:
        names = ", ".join(os.path.basename(path) for path in paths)
        raise bad_usage(f"this removes {names}; run it again with --yes to remove them")
    for path in paths:
        device.shell(f"rm -f {shlex.quote(path)}")
        if device.test(f"-e {shlex.quote(path)}"):
            raise Failure(EXIT_FAILED, "device_error", f"{path} is still there after rm")
    return {"name": args.name, "removed": paths}, f"removed: {args.name} ({len(paths)} files)"


def broadcast(device: Device, action: str) -> dict:
    output = device.shell(f"am broadcast -a {action}").strip()
    match = re.search(r"Broadcast completed: result=(-?\d+)", output)
    if not match:
        raise Failure(EXIT_FAILED, "device_error", output or f"no answer to {action}")
    return {"action": action, "result": int(match.group(1))}


def trigger_row_exists(device: Device, task_id: str) -> bool:
    """Read only the trigger row, never another task."""
    where = shlex.quote(f"taskId='{task_id}'")
    return bool(query_rows(device, f"{CONTENT_QUERY} {TASKS_URI} --projection id --where {where}"))


def command_sync_tasks(device: Device, args: argparse.Namespace):
    """Android refuses the app's own broadcast to the `shell` user. An insert does start a sync, and
    a row already marked as deleted removes itself in that sync, so nothing stays behind."""
    task_id = uuid.uuid4().hex
    now = str(int(time.time() * MILLISECONDS))
    binds = [
        f"taskId:s:{task_id}", f"title:s:{SYNC_TRIGGER_TITLE}", "status:s:needsAction", f"lastModified:l:{now}",
        "dueTime:l:0", "completedTime:l:0", "isReminderOn:i:0", "deleted:i:1", "hasSync:i:0", "sort:i:0",
        "sortCompleted:i:0", f"sortTime:l:{now}", "plannedSort:i:0", f"plannedSortTime:l:{now}",
    ]
    arguments = " ".join(f"--bind {bind}" for bind in binds)
    output = device.shell(f"content insert --uri {TASKS_URI} {arguments}")
    if "Exception" in output or "Error" in output:
        raise Failure(EXIT_FAILED, "device_error", output.strip())
    if not trigger_row_exists(device, task_id):
        raise Failure(EXIT_FAILED, "device_error", "the provider accepted the trigger row but does not hold it")
    started = time.monotonic()
    while trigger_row_exists(device, task_id):
        if time.monotonic() - started >= args.timeout:
            raise Failure(EXIT_TIMEOUT, "timeout", f"no sync ran in {args.timeout:g} s; the hidden trigger row goes in the next sync")
        time.sleep(WAIT_INTERVAL)
    waited = round(time.monotonic() - started, 1)
    return {"app": "tasks", "route": TASKS_URI, "seconds": waited}, f"synced: tasks, after {waited} s"


def command_sync_calendar(device: Device, args: argparse.Namespace):
    """The Calendar app registers this receiver only while it runs, and an unheard broadcast still answers 0."""
    if CALENDAR_SYNC_ACTION not in device.shell(BROADCASTS_DUMP):
        raise Failure(EXIT_FAILED, "device_error", "the Calendar app is not running, so nothing would hear this; open it first", next_step="inkctl doctor")
    data = {"app": "calendar", **broadcast(device, CALENDAR_SYNC_ACTION)}
    return data, "sync asked: calendar"


def read_languages(device: Device) -> dict:
    """The active code and the installed packs, in one shell call."""
    output = device.shell(
        f"ls -1 {DICTIONARY_FOLDER}/{DICTIONARY_CURRENT} && echo {LANGUAGE_MARK} && "
        f"for pack in {DICTIONARY_FOLDER}/{DICTIONARY_PACKS}/*; do if [ -d \"$pack\" ]; then echo \"${{pack##*/}}\"; fi; done",
        missing=DICTIONARY_FOLDER,
    )
    active, _, packs = output.partition(LANGUAGE_MARK)
    codes = [name for name in active.split() if LANGUAGE_CODE.fullmatch(name)]
    installed = [name for name in packs.split() if LANGUAGE_CODE.fullmatch(name)]
    current = codes[0] if len(codes) == 1 else (EMPTY_FOLDER_LANGUAGE if not codes else None)
    return {"language": current, "files": codes, "installed": installed}


def language_text(state: dict) -> str:
    current = state["language"] or f"unknown: several files, {', '.join(state['files'])}"
    return f"language: {current}\ninstalled: {' '.join(state['installed'])}"


def command_lang_get(device: Device, args: argparse.Namespace):
    state = read_languages(device)
    return state, language_text(state)


def set_language(device: Device, state: dict, code: str) -> tuple[dict, str]:
    """Create the new file before deleting the others, so the folder is never empty, then read it back."""
    if not LANGUAGE_CODE.fullmatch(code):
        raise bad_usage(f"a language code reads like pt_BR, not: {code}")
    if code not in state["installed"]:
        raise not_found(f"language pack {code}; installed: {' '.join(state['installed'])}", "inkctl lang get")
    folder = f"{DICTIONARY_FOLDER}/{DICTIONARY_CURRENT}"
    others = " ".join(shlex.quote(f"{folder}/{other}") for other in state["files"] if other != code)
    device.shell(f"touch {shlex.quote(f'{folder}/{code}')}" + (f" && rm -f {others}" if others else ""))
    broadcast(device, LANGUAGE_CHANGED)
    after = read_languages(device)
    if after["files"] != [code]:
        raise InternalFailure("handwriting.language-file", "setLanguage", "languageNotSet", device_environment(device),
                              f"the language folder holds {after['files']} after the switch, not [{code}]")
    data = {**after, "before": state["language"]}
    return data, f"language: {state['language']} -> {code}"


def command_lang_set(device: Device, args: argparse.Namespace):
    return set_language(device, read_languages(device), args.code)


def command_lang_cycle(device: Device, args: argparse.Namespace):
    state = read_languages(device)
    cycle = [code for code in LANGUAGE_CYCLE if code in state["installed"]]
    if not cycle:
        raise not_found(f"a pack of the cycle {' '.join(LANGUAGE_CYCLE)}", "inkctl lang get")
    index = cycle.index(state["language"]) if state["language"] in cycle else -1
    return set_language(device, state, cycle[(index + 1) % len(cycle)])


def command_screen(device: Device, args: argparse.Namespace):
    if not note_screen_allowed(device, args.allow_notes):
        raise protected("a note on the screen")
    size = device.capture(args.file)
    return {"path": args.file, "bytes": size}, args.file


def element_key(element: dict) -> tuple:
    """What makes two reads show the same element. shortcut: identical rows count once; use position when that matters."""
    return (element["id"], element["desc"], element["text"], element["class"])


def swipe_list(device: Device, element: dict, forward: bool, span=(SCROLL_START, SCROLL_END), milliseconds: int = SCROLL_MILLISECONDS) -> None:
    """Swipe inside a list's own bounds, between two fractions of its height."""
    left, top, right, bottom = element["bounds"]
    x, height = (left + right) // 2, bottom - top
    start, end = top + int(height * span[0]), top + int(height * span[1])
    if not forward:
        start, end = end, start
    device.shell(f"input swipe {x} {start} {x} {end} {milliseconds}")


def scroll_to_end(device: Device, element: dict, seen: set, limit: int, stop=None) -> dict:
    """Swipe one list until two reads bring nothing new or the limit passes, collecting what appears."""
    found, steps, quiet = [], 0, 0
    while steps < limit and quiet < SCROLL_QUIET_READS:
        swipe_list(device, element, True)
        steps += 1
        fresh = [item for item in device.elements() if element_key(item) not in seen]
        seen.update(element_key(item) for item in fresh)
        found += fresh
        quiet = 0 if fresh else quiet + 1
        if stop and stop(fresh):
            return {"found": found, "steps": steps, "at_limit": False, "stopped": True}
    return {"found": found, "steps": steps, "at_limit": quiet < SCROLL_QUIET_READS, "stopped": False}


def scroll_back(device: Device, element: dict, first: list[dict], steps: int) -> bool:
    """Swipe back until the screen shows what it showed before the scan."""
    wanted = [element_key(item) for item in first]
    for _ in range(steps + SCROLL_QUIET_READS):
        swipe_list(device, element, False)
        if [element_key(item) for item in device.elements()] == wanted:
            return True
    return False


def refuse_note_editor(device: Device) -> None:
    if device.activity() == NOTE_ACTIVITY:
        raise bad_usage("scrolling on a note could draw on it; leave the note editor first")


def read_every_list(device: Device, snapshot: dict, limit: int) -> tuple[dict, list[str]]:
    """Read each list to its end and come back. Elements found off screen have no reference, because they cannot be pressed from here."""
    first, merged, lists = snapshot["elements"], list(snapshot["elements"]), []
    seen = {element_key(item) for item in first}
    SNAPSHOT_FILE.unlink(missing_ok=True)  # until the screen is proven back, the old references may point at the wrong place
    for element in [item for item in first if item["scrollable"]]:
        scan = scroll_to_end(device, element, seen, limit)
        merged += [{**item, "ref": "", "offscreen": True} for item in scan["found"]]
        returned = scan["steps"] == 0 or scroll_back(device, element, first, scan["steps"])
        lists.append({
            "ref": element["ref"],
            "steps": scan["steps"],
            "found": len(scan["found"]),
            "at_limit": scan["at_limit"],
            "returned": returned,
        })
    paging = turn_every_page(device, snapshot, seen)
    merged += [{**item, "ref": "", "offscreen": True} for item in paging.pop("elements", [])]
    if all(item["returned"] for item in lists) and paging.get("returned", True):
        save_snapshot(snapshot)
    at_limit = any(item["at_limit"] for item in lists) or paging.get("at_limit", False)
    data = {**snapshot, "elements": merged, "lists": lists, "at_limit": at_limit}
    lines = [
        f"list {item['ref']}: {item['found']} more in {item['steps']} steps"
        + ("; stopped at the limit" if item["at_limit"] else "")
        + ("" if item["returned"] else "; did not return to the start, take a new snapshot")
        for item in lists
    ]
    if paging:
        data["paging"] = paging
        lines.append(
            f"pages: {paging['found']} more in {paging['turned']} turns"
            + ("; stopped at the limit" if paging["at_limit"] else "")
            + ("" if paging["returned"] else f"; did not return to page {paging['from']}, take a new snapshot")
        )
    return data, lines


def turn_every_page(device: Device, snapshot: dict, seen: set, stop=None) -> dict:
    """Press next to the last page, collecting what each page adds (#5); {} on a screen with no pages.

    shortcut: the previous-page control is not measured yet, so it never returns to the first
    page and says so; press it here once a device shows its id."""
    if "pages" not in snapshot:
        return {}
    elements, found, turned, at_limit = snapshot["elements"], [], 0, False
    while True:
        if turned >= PICKER_MAX_PAGES:
            at_limit = True
            break
        if not next_page(device, elements, STEP_TIMEOUT):
            break
        turned += 1
        elements = device.elements()
        fresh = [item for item in elements if element_key(item) not in seen]
        seen.update(element_key(item) for item in fresh)
        found += fresh
        if stop and stop(fresh):
            break
    return {"from": snapshot["pages"]["page"], "turned": turned, "found": len(found),
            "at_limit": at_limit, "returned": turned == 0, "elements": found}


def scroll_until_found(device: Device, selector: str, limit: int):
    """Scroll until an element appears and leave it on screen, with a fresh snapshot to press it from."""
    find_selector([], selector)  # a bad selector stops before any swipe
    snapshot = take_snapshot(device)
    first = snapshot["elements"]
    matches = find_selector(first, selector)
    if matches:
        return {**snapshot, "found": matches[0], "steps": 0}
    seen = {element_key(item) for item in first}
    SNAPSHOT_FILE.unlink(missing_ok=True)  # until the screen is proven back, the old references may point at the wrong place
    returned, at_limit = True, False
    for element in [item for item in first if item["scrollable"]]:
        scan = scroll_to_end(device, element, seen, limit, lambda fresh: bool(find_selector(fresh, selector)))
        if scan["stopped"]:
            found = take_snapshot(device)
            matches = find_selector(found["elements"], selector)
            if matches:
                return {**found, "found": matches[0], "steps": scan["steps"]}
        at_limit = at_limit or scan["at_limit"]
        returned = returned and (not scan["steps"] or scroll_back(device, element, first, scan["steps"]))
    # A paged screen: turn pages until it shows the element, and stay on that page (#5).
    paging = turn_every_page(device, snapshot, seen, lambda fresh: bool(find_selector(fresh, selector)))
    if paging.get("turned"):
        found = take_snapshot(device)
        matches = find_selector(found["elements"], selector)
        if matches:
            return {**found, "found": matches[0], "steps": paging["turned"]}
        returned, at_limit = False, at_limit or paging["at_limit"]
    if returned:
        save_snapshot(snapshot)
    failure = not_found(selector, "inkctl snapshot --all")
    failure.extra = {"at_limit": at_limit}
    if at_limit:
        failure.message = f"{selector} not found before the limit of {limit} swipes; the list continues"
    raise failure


def inside(element: dict, box: dict) -> bool:
    """Whether an element's centre lies within another element's bounds."""
    left, top, right, bottom = box["bounds"]
    return left <= element["x"] <= right and top <= element["y"] <= bottom


def lasso_list(elements: list[dict]):
    """The lasso «⋯» list: a scrolling list holding `tv_button` rows. It moves with the lasso, so it is found each read."""
    rows = [element for element in elements if element["id"] == LASSO_ROW_ID and element["text"]]
    return next((element for element in elements if element["scrollable"] and any(inside(row, element) for row in rows)), None)


def read_lasso_list(device: Device) -> tuple[dict, list[dict]]:
    """The list and its rows on screen, top first, or a stop when the list is gone."""
    elements = device.elements()
    found = lasso_list(elements)
    if not found:
        raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", "the lasso «⋯» list is not on the screen; nothing more was pressed")
    rows = [element for element in elements if element["id"] == LASSO_ROW_ID and element["text"] and inside(element, found)]
    return found, sorted(rows, key=lambda row: row["y"])


def open_lasso_list(device: Device, limit: float) -> None:
    """Open the «⋯» list unless it shows. Without a lasso toolbar it stops before any press."""
    elements = device.elements()
    if lasso_list(elements):
        return
    if len(find_selector(elements, LASSO_MORE)) != 1:
        raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", "no lasso toolbar on the screen: lasso something first; nothing was pressed")
    press_element(device, find_selector(elements, LASSO_MORE)[0])
    started = time.monotonic()
    while not lasso_list(device.elements()):
        if time.monotonic() - started >= limit:
            raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", f"the lasso «⋯» list stayed closed for {limit:g} seconds; the press opened nothing")
        time.sleep(WAIT_INTERVAL)


def swipe_lasso_list(device: Device, found: dict, forward: bool) -> None:
    """Half the list's height, slowly, so the list does not fling past rows."""
    swipe_list(device, found, forward, (LASSO_SWIPE_FROM, LASSO_SWIPE_TO), LASSO_SWIPE_MILLISECONDS)


def lasso_list_to_top(device: Device, limit: int) -> None:
    previous = None
    for _ in range(limit):
        found, rows = read_lasso_list(device)
        names = [row["text"] for row in rows]
        if names == previous:
            return
        previous = names
        swipe_lasso_list(device, found, False)


def wholly_shown(row: dict, rows: list[dict]) -> bool:
    """A row cut by the list's edge is shorter than the others; press it only once most of it shows."""
    def height(item: dict) -> int:
        _, top, _, bottom = item["bounds"]
        return bottom - top

    return height(row) * 2 >= max(height(item) for item in rows)


def shown_row(rows: list[dict], wanted: str):
    return next((row for row in rows if row["text"] == wanted and wholly_shown(row, rows)), None)


def walk_lasso_list(device: Device, limit: int, wanted: str = ""):
    """Read the list from its top to its end, collecting each row once in order; stop at `wanted` when it shows whole."""
    if wanted:  # a row already on the screen needs no swipe
        _, rows = read_lasso_list(device)
        match = shown_row(rows, wanted)
        if match:
            return [row["text"] for row in rows], match
    lasso_list_to_top(device, limit)
    names, quiet = [], 0
    for _ in range(limit):
        found, rows = read_lasso_list(device)
        match = shown_row(rows, wanted)
        if match:
            return names, match
        fresh = [row["text"] for row in rows if row["text"] not in names]
        names += fresh
        quiet = 0 if fresh else quiet + 1
        if quiet >= SCROLL_QUIET_READS:
            return names, None
        swipe_lasso_list(device, found, True)
    return names, None


def command_lasso_rows(device: Device, args: argparse.Namespace):
    open_lasso_list(device, args.step_timeout)
    names, _ = walk_lasso_list(device, args.max_steps)
    return {"rows": names}, "\n".join(names)


def command_lasso_press(device: Device, args: argparse.Namespace):
    """shortcut: the first row of that name wins; check for twins when two plugins share a button name."""
    open_lasso_list(device, args.step_timeout)
    names, match = walk_lasso_list(device, args.max_steps, args.row)
    if not match:
        raise not_found(f"row {args.row} in the lasso «⋯» list", "inkctl lasso rows")
    return press(device, args, match["x"], match["y"], {"row": args.row})


# Ink and lasso through Probe's «Run Command» button (#148). inkctl pushes one command file, presses
# the button in the open note, and reads the answer Probe logs; `plugins/ink-tools-probe/src/helper.ts` owns
# the other side of this contract.
def arc(cx: float, cy: float, rx: float, ry: float, start: float, end: float) -> list[tuple[float, float]]:
    """Points along an ellipse from one angle to another, in degrees, counterclockwise when end > start."""
    steps = max(2, int(abs(end - start) / INK_ARC_DEGREES))
    return [
        (cx + rx * math.cos(math.radians(start + (end - start) * step / steps)),
         cy + ry * math.sin(math.radians(start + (end - start) * step / steps)))
        for step in range(steps + 1)
    ]


