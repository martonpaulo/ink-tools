def glyph_strokes(spec: str) -> list[list[tuple[float, float]]]:
    """The strokes of one glyph or mark spec, in grid units."""
    strokes = []
    for stroke in spec.split(";"):
        points = []
        for token in stroke.split():
            if token.startswith("a:"):
                points += arc(*(float(value) for value in token[2:].split(",")))
            else:
                x, y = token.split(",")
                points.append((float(x), float(y)))
        strokes.append(points)
    return strokes


def glyphs() -> dict:
    """The font, parsed: each letter's (width, strokes) and each mark's strokes."""
    letters = {}
    for character, spec in INK_LETTERS.items():
        width, _, strokes = spec.partition("|")
        letters[character] = (float(width), glyph_strokes(strokes))
    return {"letters": letters, "marks": {mark: glyph_strokes(spec) for mark, spec in INK_MARKS.items()}}


def text_strokes(text: str, left: float, top: float, size: float) -> list[list[list[int]]]:
    """The text as page-pixel strokes, its top-left corner at (left, top) and its x-height `size` px."""
    font = glyphs()
    unit = size / INK_X_HEIGHT
    baseline = top + INK_ASCENDER * unit
    strokes, cursor, dot, previous_centre = [], left, None, 0.0
    for character in unicodedata.normalize("NFD", text.lower()):
        if character == " ":
            cursor, dot = cursor + INK_SPACE * unit, None
            continue
        if character in font["marks"]:
            if not strokes:
                raise bad_usage(f"an accent needs a letter before it: {text}")
            if dot is not None:  # an accent on i or j takes the dot's place
                del strokes[dot]
                dot = None
            centre = previous_centre
            for mark in font["marks"][character]:
                strokes.append([(centre + x * unit, baseline - y * unit) for x, y in mark])
            continue
        if character not in font["letters"]:
            known = "".join(sorted(font["letters"]))
            raise bad_usage(f"no stroke for {character!r}; ink write knows {known}, space and the accents of á à â ã ç é ê í ó ô õ ú ü ñ")
        width, glyph = font["letters"][character]
        dot = len(strokes) + len(glyph) - 1 if character in INK_DOTTED else None
        for points in glyph:
            strokes.append([(cursor + x * unit, baseline - y * unit) for x, y in points])
        previous_centre = cursor + width / 2 * unit
        cursor += (width + INK_GAP) * unit
    return [densify(stroke) for stroke in strokes]


def densify(points: list[tuple[float, float]]) -> list[list[int]]:
    """One point at least every INK_STEP px, as a pen samples, rounded to page pixels."""
    dense = [points[0]]
    for (x1, y1), (x2, y2) in zip(points, points[1:]):
        parts = max(1, math.ceil(math.hypot(x2 - x1, y2 - y1) / INK_STEP))
        dense += [(x1 + (x2 - x1) * part / parts, y1 + (y2 - y1) * part / parts) for part in range(1, parts + 1)]
    rounded = [[round(x), round(y)] for x, y in dense]
    return rounded if len(rounded) > 1 else rounded * 2


def check_on_page(strokes: list) -> None:
    for stroke in strokes:
        for x, y in stroke:
            if not (0 <= x <= PAGE_WIDTH and 0 <= y <= PAGE_HEIGHT):
                raise bad_usage(f"the ink leaves the {PAGE_WIDTH} x {PAGE_HEIGHT} page at ({x}, {y}); move --at or lower --size")


def moved(strokes: list, left: int, top: int) -> list:
    """A saved sample moved so its top-left corner is at (left, top)."""
    xs = [x for stroke in strokes for x, _ in stroke]
    ys = [y for stroke in strokes for _, y in stroke]
    return [[[x - min(xs) + left, y - min(ys) + top] for x, y in stroke] for stroke in strokes]


def read_sample(path: str) -> list:
    """A stroke sample: {"strokes": [[[x, y], ...], ...]}, as `ink save` writes it."""
    if not os.path.isfile(path):
        raise not_found(path)
    try:
        strokes = json.loads(Path(path).read_text(encoding="utf-8"))["strokes"]
        if not strokes or not all(len(stroke) >= 2 and all(len(point) == 2 for point in stroke) for stroke in strokes):
            raise ValueError("a stroke needs two points or more")
        return [[[round(float(x)), round(float(y))] for x, y in stroke] for stroke in strokes]
    except (ValueError, KeyError, TypeError) as error:
        raise bad_usage(f"{path} holds no strokes as [[[x, y], ...], ...]: {error}") from error


def answer_parts(lines: list[str], command_id: str, since: str) -> dict:
    """The answer's chunks by number, from Probe's log lines: this command's, or an `unknown` one
    logged after the push, which means the plugin could not read the file."""
    parts = {}
    for line in lines:
        entry = parse_log(line)
        found = HELPER_ANSWER.fullmatch(entry.get("message", ""))
        if not found or found["id"] not in (command_id, HELPER_UNKNOWN_ID):
            continue
        if found["id"] == HELPER_UNKNOWN_ID and entry.get("time", "") < since:
            continue
        parts.setdefault(found["id"], {})[int(found["index"])] = (int(found["count"]), found["chunk"])
    return parts


def whole_answer(parts: dict):
    """The joined JSON when every chunk is there, else None."""
    if not parts:
        return None
    count = next(iter(parts.values()))[0]
    if sorted(parts) != list(range(1, count + 1)):
        return None
    return json.loads("".join(parts[index][1] for index in range(1, count + 1)))


def read_helper_answer(device: Device, command_id: str, since: str, limit: float):
    """Probe's whole answer to this command, or None when none came within `limit` seconds."""
    started = time.monotonic()
    while True:
        done = device.adb("logcat", "-d", "-v", "time", "-T", since, "-s", PLUGIN_LOG_TAG)
        parts = answer_parts(done.stdout.decode(errors="replace").splitlines(), command_id, since)
        answer = whole_answer(parts.get(command_id, {})) or whole_answer(parts.get(HELPER_UNKNOWN_ID, {}))
        if answer is not None:
            return answer
        if time.monotonic() - started >= limit:
            return None
        time.sleep(WAIT_INTERVAL)


def helper_listening() -> bool:
    """Whether Probe answered recently enough that it still reads its command file with no press (#286)."""
    try:
        answered = float(HELPER_ANSWERED_FILE.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        return False
    return 0 <= time.time() - answered < HELPER_LISTEN_SECONDS


def note_helper_answered() -> None:
    """Keep the time of Probe's answer; a file that cannot be written only costs the next call a press."""
    try:
        HELPER_ANSWERED_FILE.parent.mkdir(parents=True, exist_ok=True)
        HELPER_ANSWERED_FILE.write_text(f"{time.time()}\n", encoding="utf-8")
    except OSError:
        pass


def press_helper(device: Device, limit: float) -> None:
    """Press «Run Command» from the one screen read that shows it: open the note's plugin panel
    first when the button is not on screen, and read again only then (#286)."""
    shown = find_selector(device.shown(), HELPER_BUTTON)
    if len(shown) == 1:
        press_element(device, shown[0])
        return
    if not shown:
        press_element(device, expect_element(device, NOTE_PLUGINS_BUTTON, limit))
        # The panel shows 8 rows; with more plugins «Run Command» sits further down its list (#421).
        expect_screen(device, lambda elements: True if any(item["scrollable"] for item in elements)
                      or find_selector(elements, HELPER_BUTTON) else None, limit, "the plugin panel is not on the screen")
        press_element(device, scroll_until_found(device, HELPER_BUTTON, SCROLL_STEPS)["found"])
        return
    press_element(device, expect_element(device, HELPER_BUTTON, limit))


def guarded_command(command: dict, guard: str) -> dict:
    """`command` as a batch whose first step makes Probe check that the open note is in `guard` (#286)."""
    steps = command["steps"] if command["op"] == "batch" else [command]
    return {"op": "batch", "steps": [{"op": "requireNote", "folder": guard}, *steps]}


def unguarded_answer(answer: dict, command: dict) -> dict:
    """The answer `command` would have had alone, from the answer of its guarded batch (#286). A
    refused guard is a protected note, or a Probe too old to check it, which ran nothing."""
    message = str(answer.get("message", ""))
    if not answer.get("ok") and (answer.get("step") == 1 or ("step" not in answer and message.startswith("step 1:"))):
        if answer.get("code") == HELPER_OUTSIDE_FOLDER:
            raise protected("writing on a note outside Note/Tests/")
        raise Failure(EXIT_FAILED, "device_error", f"Probe could not check the open note, so nothing ran: {answer.get('code')} {message}; install Probe built from main", HELPER_LOG_STEP)
    steps = answer.get("steps", [])[1:]
    failed = {"step": answer["step"] - 1, "message": f"step {answer['step'] - 1} ({steps[-1].get('op')}): {steps[-1].get('message')}"} if "step" in answer and steps else {}
    if command["op"] == "batch":
        return {**answer, "steps": steps, **failed}
    if failed:
        return {"ok": False, "code": answer.get("code"), "message": steps[-1].get("message")}
    return steps[0] if steps else answer


@contextlib.contextmanager
def one_request_at_a_time(name: str):
    """Hold this Mac's lock on one plugin's request file from the push to the answer: a second inkctl
    that pushed to the same file meanwhile replaced or emptied the first one's request, and both failed
    (#471). The lock ends with the process, so a call that dies never holds it.
    shortcut: one lock per plugin on this Mac, whichever tablet; a second tablet waits too, and a request
    from another computer is not held off. Upgrade to one lock per tablet if two tablets are used at once."""
    REQUEST_LOCKS.mkdir(parents=True, exist_ok=True)
    with open(REQUEST_LOCKS / f"{name}.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def helper_call(device: Device, args: argparse.Namespace, command: dict, guard: str | None = None) -> dict:
    """Run one command in Probe and return its answer; a refusal or no answer is a Failure. With
    `guard`, Probe first checks that the open note is in that folder, and runs nothing outside it."""
    with one_request_at_a_time("ink-tools-probe-command"):
        return locked_helper_call(device, args, command, guard)


def locked_helper_call(device: Device, args: argparse.Namespace, command: dict, guard: str | None) -> dict:
    if device.activity() != NOTE_ACTIVITY:
        raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", "no note is open; open a test note first (inkctl note open)", "inkctl note open Note/Tests/X.note")
    command_id = uuid.uuid4().hex
    sent = guarded_command(command, guard) if guard else command
    with tempfile.TemporaryDirectory() as folder:
        local = os.path.join(folder, os.path.basename(HELPER_COMMAND_PATH))
        Path(local).write_text(json.dumps({"id": command_id, **sent}), encoding="utf-8")
        device.shell(f"mkdir -p {shlex.quote(posixpath.dirname(HELPER_COMMAND_PATH))}")
        push_file(device, local, HELPER_COMMAND_PATH, overwrite=True)
    since = device.shell(f"date {shlex.quote(HELPER_DATE_FORMAT)}").strip()
    device.wake()
    # A Probe that answered within its listen window runs the pushed file with no press (#286). Its
    # ids run once, so a press after a late answer only logs that answer again.
    answer = read_helper_answer(device, command_id, since, HELPER_LISTEN_WAIT) if helper_listening() else None
    if answer is None:
        press_helper(device, args.step_timeout)
        answer = read_helper_answer(device, command_id, since, args.timeout)
    if answer is None:
        raise Failure(EXIT_TIMEOUT, "timeout", f"Probe gave no answer in {args.timeout:g} s; is Probe installed with its permissions on Always Allow?", HELPER_LOG_STEP)
    note_helper_answered()
    if guard:
        answer = unguarded_answer(answer, command)
    if not answer.get("ok"):
        steps = {"step": answer["step"], "steps": answer.get("steps", [])} if "step" in answer else {}
        raise Failure(EXIT_FAILED, "device_error", f"Probe refused {command['op']}: {answer.get('code')} {answer.get('message')}", HELPER_LOG_STEP, extra=steps)
    return answer


def need_test_note(device: Device, allow_notes: bool, helper: bool = False) -> str | None:
    """Ink goes only on a test note, unless the caller allows the owner's notes too. The screen is
    woken first, so the read the check makes is the one «Run Command» is pressed from (#286). For a
    Probe command while Probe listens, no screen is read: the folder is returned, for helper_call's
    `guard`, and Probe checks the open note's own path before it runs anything. The screen read took
    2.2 s of a 4.7 s `ink write` (device round 13, #286)."""
    device.wake()
    if allow_notes:
        return None
    if helper and helper_listening():
        return f"{TEST_NOTES_FOLDER}/"
    if not test_note_on_screen(device):
        raise protected("writing on a note outside Note/Tests/")
    return None


def insert_ink(device: Device, args: argparse.Namespace, strokes: list) -> tuple[dict, str]:
    check_on_page(strokes)
    guard = need_test_note(device, args.allow_notes, helper=True)
    return ink_answer(strokes, helper_call(device, args, {"op": "insertStrokes", "strokes": strokes}, guard))


def ink_answer(strokes: list, answer: dict) -> tuple[dict, str]:
    points = sum(len(stroke) for stroke in strokes)
    data = {**answer, "points": points}
    return data, f"inserted: {len(strokes)} strokes, {points} points, rect {answer.get('rect')}, in {answer.get('ms')} ms"


def command_ink_write(device: Device, args: argparse.Namespace):
    return insert_ink(device, args, text_strokes(args.text, args.at[0], args.at[1], args.size))


def command_ink_strokes(device: Device, args: argparse.Namespace):
    return insert_ink(device, args, moved(read_sample(args.file), args.at[0], args.at[1]))


def command_ink_save(device: Device, args: argparse.Namespace):
    answer = helper_call(device, args, {"op": "readLasso"})
    strokes = answer.get("strokes") or []
    if not strokes:
        raise not_found("a lassoed stroke", "inkctl lasso rect X Y W H")
    sample = {"strokes": moved(strokes, 0, 0)}
    handle, partial = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(args.file)), suffix=".partial")
    with os.fdopen(handle, "w", encoding="utf-8") as stream:
        json.dump(sample, stream)
    os.replace(partial, args.file)
    return {"path": args.file, "strokes": len(strokes)}, f"saved: {len(strokes)} strokes to {args.file}"


def command_note_png(device: Device, args: argparse.Namespace):
    """The tablet's own rendering of one page, the reference the Mac reader is checked against (#261)."""
    if args.page < 1:
        raise bad_usage("the page counts from 1")
    if os.path.exists(args.local_path) and not args.overwrite:
        raise exists_failure(args.local_path)
    if not args.allow_notes and not test_note_on_screen(device):
        raise protected("rendering a note outside Note/Tests/")
    answer = helper_call(device, args, {"op": "renderPage", "page": args.page - 1})
    try:
        transfer(device, "pull", HELPER_RENDER_PATH, args.local_path, missing=HELPER_RENDER_PATH)
    finally:
        device.shell(f"rm -f {shlex.quote(HELPER_RENDER_PATH)}")
    size = os.path.getsize(args.local_path)
    data = {**answer, "page": args.page, "local": args.local_path, "bytes": size}
    text = f"page {args.page}: {args.local_path} ({size} bytes) in {answer.get('ms')} ms"
    # The tablet's PNG leaves every picture element out (device round 5, #263): say so, so the
    # PNG is never taken as proof of a picture; note-render of the pulled file draws them.
    pictures = answer.get("pictures")
    if pictures:
        noun = "picture" if pictures == 1 else "pictures"
        print(f"the tablet's page PNG leaves out the page's {pictures} {noun}; render the pulled .note with note-render to see them", file=sys.stderr, flush=True)
    elif pictures is None and "pictures" in answer:
        print("the page's pictures did not count; the tablet's page PNG leaves out any picture", file=sys.stderr, flush=True)
    return data, text


def command_note_insert_picture(device: Device, args: argparse.Namespace):
    suffix = os.path.splitext(args.file)[1].lower()
    if suffix not in PICTURE_SUFFIXES:
        raise bad_usage(f"a picture is a .png, .jpg or .jpeg file: {args.file}")
    if not os.path.isfile(args.file):
        raise not_found(args.file)
    guard = need_test_note(device, args.allow_notes, helper=True)
    # One fixed name in Probe's folder: Probe takes no other path, and the next insert replaces it.
    remote = f"{HELPER_FOLDER}/picture{suffix}"
    push_file(device, args.file, remote, overwrite=True)
    answer = helper_call(device, args, {"op": "insertPicture", "path": remote}, guard)
    return answer, f"inserted: {args.file} on page {answer.get('page', 0) + 1} in {answer.get('ms')} ms"


def command_note_insert_text(device: Device, args: argparse.Namespace):
    (x, y), (width, height) = args.at, args.size
    if width <= 0 or height <= 0:
        raise bad_usage("a text box needs a width and a height")
    if not args.text.strip():
        raise bad_usage("a text box needs text")
    rect = {"left": x, "top": y, "right": x + width, "bottom": y + height}
    check_on_page([[[rect["left"], rect["top"]], [rect["right"], rect["bottom"]]]])
    guard = need_test_note(device, args.allow_notes, helper=True)
    command = {"op": "insertTextBox", "text": args.text, "rect": rect, "fontSize": args.font_size}
    answer = helper_call(device, args, command, guard)
    return answer, f"inserted: a text box at {rect} on page {answer.get('page', 0) + 1} in {answer.get('ms')} ms"


def background_path(template: str) -> str | None:
    """The full path of a page background given as MyStyle/NAME.png or that full path, else None.
    insertNotePage takes a plugin-made PNG straight in MyStyle as the page's background (#377);
    device round 11 found insert-page refusing it (#379)."""
    folder = remote_path(PLUGIN_FOLDER) + "/"
    path = remote_path(template)
    name = path[len(folder):] if path.startswith(folder) else ""
    return path if BACKGROUND_NAME.fullmatch(name) else None


def command_note_insert_page(device: Device, args: argparse.Namespace):
    template = args.template if TEMPLATE_NAME.fullmatch(args.template) else background_path(args.template)
    if template is None:
        raise bad_usage(f"a template is a system template name such as {NOTE_BLANK_STYLE}, or a .png file in {PLUGIN_FOLDER}/: {args.template}")
    if args.page < 1:
        raise bad_usage("the page counts from 1")
    guard = need_test_note(device, args.allow_notes, helper=True)
    if template != args.template and not device.test(f"-f {shlex.quote(template)}"):
        raise not_found(template, f"inkctl files push FILE.png {PLUGIN_FOLDER}/NAME.png")
    answer = helper_call(device, args, {"op": "insertPage", "page": args.page - 1, "template": template}, guard)
    return answer, f"inserted: page {args.page} with {template} in {answer.get('ms')} ms"


def command_note_move_page(device: Device, args: argparse.Namespace):
    """Move a page of a closed note through Probe (#263): the file API has no move call, so Probe copies
    the page's elements to a new page at TO and removes the old one. The note must not be the open
    one, so the note app holds no copy of it to save over the change; the button needs another note open."""
    need_note_suffix(args.path)
    if args.from_page < 1 or args.to_page < 1:
        raise bad_usage("the pages count from 1")
    if args.from_page == args.to_page:
        raise bad_usage("FROM and TO are the same page; nothing would move")
    if args.template is not None and not TEMPLATE_NAME.fullmatch(args.template):
        raise bad_usage(f"a template is a system template name such as {NOTE_BLANK_STYLE}: {args.template}")
    path = remote_path(args.path)
    if not args.allow_notes and not in_test_notes(path):
        raise protected("moving a page of a note outside Note/Tests/")
    if not device.test(f"-f {shlex.quote(path)}"):
        raise not_found(path)
    titles = {element["text"] for element in device.elements() if element["id"] == NOTE_TITLE_ID}
    if posixpath.basename(path).removesuffix(NOTE_SUFFIX) in titles:
        raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", f"{path} is the open note; open another test note first", "inkctl note open Note/Tests/X.note")
    command = {"op": "movePage", "path": path, "from": args.from_page - 1, "to": args.to_page - 1}
    if args.template is not None:
        command["template"] = args.template
    answer = helper_call(device, args, command)
    data = {**answer, "from": args.from_page, "to": args.to_page}
    return data, f"moved: page {args.from_page} of {path} to page {args.to_page}, {answer.get('elements')} elements, template {answer.get('template')}, in {answer.get('ms')} ms"


def command_note_digest(device: Device, args: argparse.Namespace):
    """Probe reads a saved note in Note/ through the plugin file API and answers its MD5; equal to
    the tablet's own MD5 of the file, it proves a plugin can read the note's bytes (#522)."""
    need_note_suffix(args.path)
    path = remote_path(args.path)
    if not args.allow_notes and not in_test_notes(path):
        raise protected("reading a note outside Note/Tests/")
    if not device.test(f"-f {shlex.quote(path)}"):
        raise not_found(path)
    answer = helper_call(device, args, {"op": "digestFile", "path": path})
    plugin = str(answer.get("md5", "")).lower()
    listed = device.shell(f"md5sum {shlex.quote(path)}").split()
    tablet = listed[0].lower() if listed else ""
    data = {"path": path, "plugin_md5": plugin, "tablet_md5": tablet, "equal": plugin == tablet}
    if plugin != tablet:
        raise Failure(EXIT_FAILED, "device_error", f"the plugin read {plugin or 'no digest'} of {path}, the tablet has {tablet}; was the note saved in between?", "inkctl note digest PATH", extra=data)
    return data, f"read by the plugin: {path}, MD5 {plugin}, equal to the tablet's"


def edit_operations(path: str) -> list:
    """The operations of `note edit`: a JSON list, or an object with `ops`, read from PATH (#312)."""
    try:
        raw = json.loads(Path(path).read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise not_found(path)
    except (OSError, ValueError) as error:
        raise bad_usage(f"{path} is not a JSON list of operations: {error}")
    operations = raw.get("ops") if isinstance(raw, dict) else raw
    if not isinstance(operations, list) or not operations or not all(isinstance(item, dict) for item in operations):
        raise bad_usage(f"{path} holds no list of operations")
    return operations


def command_note_edit(device: Device, args: argparse.Namespace):
    """Apply the Note Editor's operations to one note through Device Link's helper, with no
    screen tap (#312). Each picture an element or a picture move names by a local `file` is copied to
    the helper's folder first; the plugin checks every operation, and its refusal is named in the answer."""
    need_note_suffix(args.path)
    path = remote_path(args.path)
    if not args.allow_notes and not in_test_notes(path):
        raise protected("editing a note outside Note/Tests/")
    operations = edit_operations(args.operations)
    folder = ACTION_PLUGINS["device-link"]["folder"]
    pictures = [element for operation in operations for element in operation.get("elements") or [] if isinstance(element, dict) and element.get("kind") == "picture"]
    # A picture moves only with its file: the helper inserts it at the new rect, then deletes the old one.
    pictures += [operation for operation in operations if operation.get("op") == "modifyElements" and "file" in operation]
    for element in pictures:
        local = str(element.get("file", ""))
        suffix = os.path.splitext(local)[1].lower()
        if suffix not in PICTURE_SUFFIXES:
            raise bad_usage(f"a picture is a .png, .jpg or .jpeg file: {local}")
        if not os.path.isfile(local):
            raise not_found(local)
    if not device.test(f"-f {shlex.quote(path)}"):
        raise not_found(path)
    device.shell(f"mkdir -p {shlex.quote(folder)}")
    for index, element in enumerate(pictures, start=1):
        remote = f"{folder}/picture-{index}{os.path.splitext(element['file'])[1].lower()}"
        push_file(device, element["file"], remote, overwrite=True)
        element["file"] = remote
    answer = run_action(device, "device-link", "edit", {"path": path, "ops": operations}, args.timeout)
    return answer, f"edited: {len(answer.get('results', []))} operations on {path} in {answer.get('ms')} ms; open note: {answer.get('openNote')}"


def command_note_templates(device: Device, args: argparse.Namespace):
    """The tablet's page templates, each by the value `note insert-page` and the editor's
    `insertPage` take, from Device Link's action `templates` (#451): the system ones by name, the
    PNGs straight in MyStyle by full path. It changes nothing on the tablet, so --read-only runs it."""
    answer = run_action(device, "device-link", "templates", {}, args.timeout)
    system, custom = answer.get("system"), answer.get("custom")
    named = lambda items, keys: isinstance(items, list) and all(isinstance(item, dict) and all(isinstance(item.get(key), str) and item[key] for key in keys) for item in items)
    if not system or not named(system, ("name",)) or not named(custom, ("name", "path")):
        raise Failure(EXIT_FAILED, "device_error", "Device Link answered no template list", logs_step("device-link"))
    data = {"system": [{"name": item["name"]} for item in system], "custom": [{"name": item["name"], "path": item["path"]} for item in custom]}
    lines = [f"system: {item['name']}" for item in data["system"]] + [f"custom: {item['name']}: {item['path']}" for item in data["custom"]]
    return data, "\n".join(lines)


def command_note_current(device: Device, args: argparse.Namespace):
    """The note open on the tablet and the page on screen, counted from 1 as the device shows it,
    from Device Link's action `current` (#320), for Note Editor's Follow Tablet. With no note open
    both are null. An answer with a note but no page index from 0 is a failure, never a page.
    With no note on screen Device Link reads no action file: the Files list on screen left the call
    waiting its whole 60 s for no answer (tablet row 155, 2026-11-28), so the screen's activity
    answers that case at once."""
    shown = device.activity()
    if shown != NOTE_ACTIVITY:
        return {"note": None, "page": None}, f"no note is open: the screen shows {shown or 'no activity'}"
    answer = run_action(device, "device-link", "current", {}, args.timeout)
    note, page = answer.get("openNote"), answer.get("page")
    if note is None and page is None:
        return {"note": None, "page": None}, "no note is open"
    if not isinstance(note, str) or not note or isinstance(page, bool) or not isinstance(page, int) or page < 0:
        raise Failure(EXIT_FAILED, "device_error", "Device Link answered no open note and page", logs_step("device-link"))
    return {"note": note, "page": page + 1}, f"page {page + 1} of {note}"


def lasso_answer(answer: dict) -> tuple[dict, str]:
    return answer, f"lassoed: {answer.get('rect')} {answer.get('counts')} in {answer.get('ms')} ms"


def lasso_rect(x: int, y: int, width: int, height: int) -> dict:
    """The page rectangle of `lasso rect X Y W H`, checked on the page."""
    if width <= 0 or height <= 0:
        raise bad_usage("a lasso needs a width and a height")
    rect = {"left": x, "top": y, "right": x + width, "bottom": y + height}
    check_on_page([[[rect["left"], rect["top"]], [rect["right"], rect["bottom"]]]])
    return rect


def command_lasso_rect(device: Device, args: argparse.Namespace):
    return lasso_answer(helper_call(device, args, {"op": "lassoRect", "rect": lasso_rect(args.x, args.y, args.width, args.height)}))


def command_lasso_last_insert(device: Device, args: argparse.Namespace):
    return lasso_answer(helper_call(device, args, {"op": "lassoLast"}))


def batch_numbers(step: dict, key: str, count: int) -> list[int]:
    value = step.get(key)
    if not isinstance(value, list) or len(value) != count or not all(isinstance(item, (int, float)) and not isinstance(item, bool) for item in value):
        raise bad_usage(f"«{key}» must be a list of {count} numbers")
    return [round(item) for item in value]


def batch_step(step, folder: str) -> tuple[dict, list | None]:
    """One step of a batch file as Probe's command, and its strokes when it inserts ink (#286)."""
    if not isinstance(step, dict) or step.get("do") not in BATCH_STEPS:
        raise bad_usage(f"«do» must be one of: {', '.join(BATCH_STEPS)}")
    kind = step["do"]
    if kind == "lasso last-insert":
        return {"op": "lassoLast"}, None
    if kind == "lasso rect":
        return {"op": "lassoRect", "rect": lasso_rect(*batch_numbers(step, "rect", len(RECT_NUMBERS)))}, None
    left, top = batch_numbers(step, "at", 2)
    if kind == "ink write":
        text, size = step.get("text"), step.get("size", INK_SIZE)
        if not isinstance(text, str) or not text or not isinstance(size, (int, float)) or isinstance(size, bool) or size <= 0:
            raise bad_usage("ink write needs «text» and a positive «size»")
        strokes = text_strokes(text, left, top, size)
    else:
        sample = step.get("file")
        if not isinstance(sample, str) or not sample:
            raise bad_usage("ink strokes needs «file», a sample as ink save writes it")
        strokes = moved(read_sample(os.path.join(folder, sample)), left, top)
    check_on_page(strokes)
    return {"op": "insertStrokes", "strokes": strokes}, strokes


def read_batch(path: str) -> list:
    """A batch file's steps: `{"steps": [...]}` or the list itself, each `{"do": ..., ...}`."""
    try:
        loaded = json.loads(Path(path).read_text(encoding="utf-8"))
    except FileNotFoundError as error:
        raise not_found(path) from error
    except (OSError, ValueError) as error:
        raise bad_usage(f"{path} is not a JSON batch: {error}") from error
    steps = loaded.get("steps") if isinstance(loaded, dict) else loaded
    if not isinstance(steps, list) or not steps:
        raise bad_usage(f"{path} holds no steps: give {{\"steps\": [{{\"do\": \"ink write\", ...}}]}}")
    return steps


def batch_line(index: int, kind: str, strokes, answer: dict) -> tuple[dict, str]:
    data, text = ink_answer(strokes, answer) if strokes is not None else lasso_answer(answer)
    return {**data, "do": kind}, f"step {index} {kind}: {text}"


def command_batch(device: Device, args: argparse.Namespace):
    """Run a file of helper steps through Probe in one push and one press (#286)."""
    folder = os.path.dirname(os.path.abspath(args.file))
    planned = []
    for index, step in enumerate(read_batch(args.file), start=1):
        try:
            planned.append((step["do"], *batch_step(step, folder)))
        except Failure as failure:
            raise Failure(failure.code, failure.kind, f"step {index}: {failure.message}", failure.next_step) from failure
    guard = need_test_note(device, args.allow_notes, helper=True) if any(strokes is not None for _, _, strokes in planned) else None
    if args.timeout is None:
        args.timeout = HELPER_TIMEOUT + BATCH_STEP_SECONDS * len(planned)
    try:
        answer = helper_call(device, args, {"op": "batch", "steps": [command for _, command, _ in planned]}, guard)
    except Failure as failure:
        if "step" not in failure.extra:
            raise
        ran = failure.extra["steps"][:-1]
        lines = [batch_line(index, kind, strokes, step)[1] for index, ((kind, _, strokes), step) in enumerate(zip(planned, ran), start=1)]
        failure.text = "\n".join(lines)
        raise
    results = [batch_line(index, kind, strokes, step) for index, ((kind, _, strokes), step) in enumerate(zip(planned, answer.get("steps", [])), start=1)]
    if len(results) != len(planned):
        raise Failure(EXIT_FAILED, "device_error", f"Probe answered {len(results)} of {len(planned)} steps", HELPER_LOG_STEP)
    data = {"ok": True, "ms": answer.get("ms"), "timeout": args.timeout, "steps": [data for data, _ in results]}
    return data, "\n".join([*(text for _, text in results), f"batch: {len(results)} steps in {answer.get('ms')} ms"])


def command_snapshot(device: Device, args: argparse.Namespace):
    if args.all or args.find:
        refuse_note_editor(device)
    if args.find:
        data = scroll_until_found(device, args.find, args.max_steps)
        return data, "\n".join(snapshot_lines(data))
    snapshot = take_snapshot(device)
    if not args.all:
        return snapshot, "\n".join(snapshot_lines(snapshot))
    data, lines = read_every_list(device, snapshot, args.max_steps)
    return data, "\n".join([*snapshot_lines(data), *lines])


def command_click(device: Device, args: argparse.Namespace):
    element = resolve_target(device, args.target)
    return press(device, args, element["x"], element["y"], {"target": args.target})


def command_tap(device: Device, args: argparse.Namespace):
    return press(device, args, args.x, args.y, {})


def command_swipe(device: Device, args: argparse.Namespace):
    device.wake()
    before = device.activity()
    device.shell(f"input swipe {args.x1} {args.y1} {args.x2} {args.y2}")
    done, lines = after_action(device, args, before, {})
    return done, "\n".join(lines)


def element_matches(device: Device, selector: str) -> bool:
    try:
        return bool(find_selector(device.elements(attempts=1), selector))
    except Failure as failure:
        if failure.code == EXIT_BUSY:
            return False  # a screen that has not settled is one more turn of the wait
        raise


def toast_seen(line: str, wanted: str) -> dict | None:
    found = TOAST_EVENT.search(line)
    if not found or wanted.casefold() not in found["text"].casefold():
        return None
    return {"text": found["text"], "package": found["package"], "event_time": int(found["time"])}


def wait_toast(device: Device, args: argparse.Namespace):
    """Read the accessibility events until a toast holding the text shows. It sees only toasts
    shown after it starts, so an agent starts it in the background and then acts."""
    if not args.value.strip():
        raise bad_usage("wait toast needs the text to look for")
    started = time.monotonic()
    # One uiautomator connection at a time: a `click` or `snapshot` by selector started during the
    # wait dumps the screen and kills `uiautomator events` (exit 137) [measured, Manta, 2026-11-27, #532].
    stopped = "uiautomator events ended early: a `click` or `snapshot` during the wait stops it; press with `inkctl tap X Y` instead"
    try:
        for line in device.stream(TOAST_EVENTS, args.timeout):
            if seen := toast_seen(line, args.value):
                waited = round(time.monotonic() - started, 1)
                return {"kind": "toast", "value": args.value, **seen, "seconds": waited}, f"toast: {seen['text']} ({seen['package']}), after {waited} s"
    except Failure as failure:
        if failure.code != EXIT_FAILED:
            raise
        raise Failure(EXIT_FAILED, "device_error", stopped, "inkctl history --failures") from failure
    if time.monotonic() - started < args.timeout:
        raise Failure(EXIT_FAILED, "device_error", stopped, "inkctl history --failures")
    raise Failure(EXIT_TIMEOUT, "timeout", f"no toast with «{args.value}» in {args.timeout:g} s")


def command_wait(device: Device, args: argparse.Namespace):
    """Poll one condition until it holds, always trying at least once."""
    if args.kind == "toast":
        return wait_toast(device, args)
    conditions = {
        "activity": lambda: args.value in device.activity(),
        "file": lambda: device.test(f"-e {shlex.quote(remote_path(args.value))}"),
        "element": lambda: element_matches(device, args.value),
    }
    if args.kind == "element":
        find_selector([], args.value)  # a bad selector stops now, not at the timeout
    condition = conditions[args.kind]
    started = time.monotonic()
    while not condition():
        if time.monotonic() - started >= args.timeout:
            raise Failure(EXIT_TIMEOUT, "timeout", f"{args.kind} {args.value} not seen in {args.timeout:g} s")
        time.sleep(WAIT_INTERVAL)
    waited = round(time.monotonic() - started, 1)
    return {"kind": args.kind, "value": args.value, "seconds": waited}, f"seen after {waited} s"


def command_apps(device: Device, args: argparse.Namespace):
    third_party = device.shell("pm list packages -3").split()
    system = device.shell("pm list packages -s").split()
    apps = [{"package": line.removeprefix("package:"), "kind": "installed"} for line in third_party]
    apps += [{"package": line.removeprefix("package:"), "kind": "system"} for line in system]
    return {"apps": apps}, "\n".join(f"{app['kind']}\t{app['package']}" for app in apps)


def parse_rows(output: str) -> list[dict]:
    """`content query` rows. A value may hold commas, so a field starts only at `, name=`."""
    rows = []
    for line in output.splitlines():
        match = ROW.match(line)
        if not match:
            continue
        pieces = ROW_FIELD.split(match.group(1))[1:]
        rows.append(dict(zip(pieces[0::2], pieces[1::2])))
    return rows


def command_plugin_ls(device: Device, args: argparse.Namespace):
    rows = plugin_rows(device)
    return {"plugins": rows}, "\n".join(json.dumps(row, ensure_ascii=False) for row in rows)


def command_plugin_push(device: Device, args: argparse.Namespace):
    if not args.file.endswith(PLUGIN_SUFFIX):
        raise bad_usage(f"a plugin file ends in {PLUGIN_SUFFIX}: {args.file}")
    data = push_file(device, args.file, remote_path(f"{PLUGIN_FOLDER}/{os.path.basename(args.file)}"), args.overwrite)
    data["next"] = PLUGIN_NEXT_STEP
    return data, f"pushed: {data['path']}\n{PLUGIN_NEXT_STEP}"


def query_rows(device: Device, call: str) -> list[dict]:
    """`content query` rows. No rows counts as empty only when the provider says so."""
    output = device.shell(call)
    rows = parse_rows(output)
    if not rows and NO_ROWS not in output:
        raise Failure(EXIT_FAILED, "device_error", output.strip() or f"no answer to: {call}")
    return rows


def plugin_rows(device: Device) -> list[dict]:
    return query_rows(device, f"{CONTENT_QUERY} {PLUGIN_URI}")


def settled_plugin_rows(device: Device, limit: float) -> list[dict]:
    """The plugin list, read again while it gives an empty answer, as it does while PluginHost
    restarts after an install (device round 5, #419), up to `limit` seconds. Any other answer, rows,
    the provider's own «no rows» or an error text, counts at once."""
    started = time.monotonic()
    while True:
        output = device.shell(f"{CONTENT_QUERY} {PLUGIN_URI}")
        if output.strip():
            rows = parse_rows(output)
            if not rows and NO_ROWS not in output:
                raise Failure(EXIT_FAILED, "device_error", output.strip())
            return rows
        if time.monotonic() - started >= limit:
            raise Failure(EXIT_FAILED, "device_error", PLUGIN_LIST_RESTARTING.format(limit=limit), PLUGIN_LIST_STEP)
        time.sleep(WAIT_INTERVAL)


def plugin_view_shown(device: Device) -> bool:
    """True when the screen holds a plugin view, a window of the host's package (#418). A screen
    that does not settle counts as none: the install's own answer then says what happened."""
    for _ in range(DUMP_ATTEMPTS):
        dump = device.adb("exec-out", "uiautomator", "dump", "/dev/tty").stdout.decode(errors="replace")
        if IDLE_ERROR not in dump:
            return PLUGIN_VIEW_MARK in dump
    return False


def shown_plugin_names(row: dict) -> list[str]:
    """The names a plugin shows, one for each language."""
    shown = row.get("name", "")
    try:
        names = list(json.loads(shown).values()) if shown.startswith("{") else [shown]
    except ValueError:
        names = [shown]
    return [name for name in names if name]


def plugin_names(row: dict) -> list[str]:
    """Every name a plugin answers to: its shown name in each language, its pluginKey and its pluginID."""
    return [name for name in (*shown_plugin_names(row), row.get("pluginKey", ""), row.get("pluginID", "")) if name]


def find_plugins(rows: list[dict], name: str) -> list[dict]:
    wanted = name.casefold()
    return [row for row in rows if wanted in (known.casefold() for known in plugin_names(row))]


def plugin_log_names(device: Device, name: str) -> list[str]:
    """The names a plugin's lines may carry. An uninstalled plugin still left lines, so its given name always counts."""
    found = find_plugins(plugin_rows(device), name)
    return list(dict.fromkeys([name, *(known for row in found for known in plugin_names(row))]))


def read_plugin_config(path: str) -> dict:
    """A plugin's id and version, from the file itself, so the read-back has something to prove."""
    if not path.endswith(PLUGIN_SUFFIX):
        raise bad_usage(f"a plugin file ends in {PLUGIN_SUFFIX}: {path}")
    if not os.path.isfile(path):
        raise not_found(path)
    try:
        with zipfile.ZipFile(path) as archive:
            member = next(name for name in archive.namelist() if name.rpartition("/")[2] == PLUGIN_CONFIG_FILE)
            config = json.loads(archive.read(member))
        code = config.get("versionCode")
        return {"id": config["pluginID"], "version": config["versionName"], "code": None if code is None else str(code)}
    except (zipfile.BadZipFile, StopIteration, KeyError, ValueError) as error:
        raise bad_usage(f"{path} holds no readable {PLUGIN_CONFIG_FILE} with pluginID and versionName") from error


def unexpected_screen(message: str) -> Failure:
    return Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", f"{message}; nothing more was pressed")


def expect_screen(device: Device, read, limit: float, missing: str):
    """Read the screen until `read` finds what this step needs in it (anything but None), or stop before anything else is pressed."""
    started = time.monotonic()
    while True:
        try:
            found = read(device.elements(attempts=1))
        except Failure as failure:
            if failure.code != EXIT_BUSY:
                raise
            found = None
        if found is not None:
            return found
        if time.monotonic() - started >= limit:
            raise unexpected_screen(f"{missing} after {limit:g} s")
        time.sleep(WAIT_INTERVAL)


def expect_element(device: Device, selector: str, limit: float) -> dict:
    """The one element this step needs, or a stop before anything else is pressed."""
    def only(elements: list[dict]):
        matches = find_selector(elements, selector)
        return matches[0] if len(matches) == 1 else None
    return expect_screen(device, only, limit, f"{selector} is not on the screen as one element")


def press_element(device: Device, element: dict) -> None:
    device.shell(f"input tap {element['x']} {element['y']}")


def read_enabled_limit(device: Device) -> dict:
    for element in device.elements():
        found = PLUGIN_ENABLED.fullmatch(element["text"])
        if found:
            return {"enabled": int(found[1]), "limit": int(found[2])}
    return {"enabled": None, "limit": None}


def shown_pages(elements: list[dict]):
    """A paged screen's `current / total` page numbers, as Ratta's pickers show them (`1 / 2`), or
    None when the screen shows no page number."""
    labels = find_selector(elements, PICKER_PAGE_NUMBER)
    match = PICKER_PAGE.fullmatch(labels[0]["text"].strip()) if labels else None
    return (int(match[1]), int(match[2])) if match else None


def picker_page(elements: list[dict]) -> tuple[int, int]:
    """The picker's `current / total` page numbers. A screen that shows none has one page."""
    return shown_pages(elements) or (1, 1)


def next_page(device: Device, elements: list[dict], limit: float) -> bool:
    """Press next and wait for the page number to change; False on the last page or a screen with no pages."""
    page, total = picker_page(elements)
    if page >= total:
        return False
    press_element(device, expect_element(device, PICKER_NEXT_PAGE, limit))
    wait_for_page_change(device, page, limit)
    return True


def wait_for_page_change(device: Device, page: int, limit: float) -> None:
    started = time.monotonic()
    while picker_page(device.elements())[0] == page:
        if time.monotonic() - started >= limit:
            raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", f"the picker stayed on page {page} after {limit:g} s; nothing more was pressed")
        time.sleep(WAIT_INTERVAL)


def turn_to_file(device: Device, name: str, limit: float) -> None:
    """Page through the file picker, which shows `1 / 2` and has no scrolling list, until the file is on screen."""
    selector = f"text:{name}"
    for _ in range(PICKER_MAX_PAGES):
        elements = device.elements()
        if find_selector(elements, selector):
            return
        if not next_page(device, elements, limit):
            break
    raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", f"{name} is not in the picker; nothing more was pressed")


def same_build(row: dict, config: dict, version) -> bool:
    """The same versionName and, when both sides carry one, the same versionCode: a device build keeps its versionName and raises only the code."""
    if version != config["version"]:
        return False
    return config["code"] is None or "versionCode" not in row or row["versionCode"] == config["code"]


def wait_for_plugin(device: Device, config: dict, limit: float, updating: bool) -> dict:
    """Prove the install from the list. An update needs the version column, or nothing proves it changed."""
    started = time.monotonic()
    while True:
        for row in settled_plugin_rows(device, max(0.0, limit - (time.monotonic() - started))):
            if row.get("pluginID") != config["id"]:
                continue
            if updating and "versionName" not in row:
                raise Failure(EXIT_FAILED, "device_error", "the plugin list has no version column, so this update cannot be proved")
            if same_build(row, config, row.get("versionName", config["version"])):
                return row
        if time.monotonic() - started >= limit:
            raise Failure(EXIT_TIMEOUT, "timeout", f"{config['id']} {config['version']} is not in the plugin list after {limit:g} s")
        time.sleep(WAIT_INTERVAL)


def host_install_line(device: Device, since: str, path: str) -> str | None:
    """PluginHost's success line for the file at `path` logged since `since`, or None while it has
    logged none; its failure line for that file fails at once."""
    done = device.adb("logcat", "-d", "-v", "time", "-T", since, "-s", HOST_INSTALL_TAG)
    for line in done.stdout.decode(errors="replace").splitlines():
        if f"pluginZipPath={path}," not in line:
            continue
        if HOST_INSTALL_FAILED in line:
            raise Failure(EXIT_FAILED, "device_error", f"PluginHost refused the update: {line.strip()}", f"inkctl logs --tag {HOST_INSTALL_TAG}")
        if HOST_INSTALL_DONE in line and HOST_UPGRADE in line:
            return line.strip()
    return None


def proven_row(device: Device, config: dict, limit: float, installed: list, since: str | None, path: str) -> dict:
    """The plugin's row once the install is proven: by the version in the list, or, for a
    same-version update (`since` set), by PluginHost's own success line for the pushed file (#310)."""
    if since is None:
        return wait_for_plugin(device, config, limit, bool(installed))
    started = time.monotonic()
    while host_install_line(device, since, path) is None:
        if time.monotonic() - started >= limit:
            raise Failure(EXIT_TIMEOUT, "timeout", f"PluginHost logged no update of {config['id']} from {path} after {limit:g} s", f"inkctl logs --tag {HOST_INSTALL_TAG}")
        time.sleep(WAIT_INTERVAL)
    return wait_for_plugin(device, config, limit, True)


def remove_package(device: Device, path: str) -> bool:
    """Remove the package an install pushed, once the plugin list proved the install: `MyStyle/`
    syncs to Supernote Cloud file by file, so each kept copy is one more file there (#409). True
    only when the read-back no longer finds it; a failed install never calls this, so its copy
    stays for a retry."""
    device.shell(f"rm -f {shlex.quote(path)}")
    if device.test(f"-e {shlex.quote(path)}"):
        print(f"the installed package is still on the tablet after rm: {path}", file=sys.stderr, flush=True)
        return False
    return True


def bridge_installed(device: Device) -> bool:
    """`pm path` prints the APK of an installed package and nothing, with exit 1, for a missing one."""
    done = device.adb("shell", f"pm path {BRIDGE_PACKAGE}")
    return done.returncode == 0 and "package:" in done.stdout.decode(errors="replace")


def require_bridge(device: Device) -> None:
    if not bridge_installed(device):
        raise Failure(EXIT_NO_BRIDGE, "no_bridge", f"{BRIDGE_PACKAGE} is not installed; {BRIDGE_NEXT_STEP}", BRIDGE_NEXT_STEP)


def bridge_call(device: Device, op: str, **extras) -> str:
    """One ordered broadcast to the bridge app; its answer, or the failure its result code names."""
    return bridge_answer(*bridge_result(device, op, **extras))


def bridge_result(device: Device, op: str, call_timeout: float = BRIDGE_CALL_TIMEOUT, **extras) -> tuple:
    """One ordered broadcast to the bridge app: its result code and answer text."""
    words = ["am", "broadcast", "-n", BRIDGE_RECEIVER, "-f", str(BRIDGE_INCLUDE_STOPPED), "--es", "op", op]
    for key, value in extras.items():
        if isinstance(value, bool):
            words += ["--ez", key, "true" if value else "false"]
            continue
        words += ["--ei" if isinstance(value, int) else "--es", key, str(value)]
    output = device.shell(shlex.join(words), timeout=call_timeout)
    match = BRIDGE_ANSWER.search(output)
    if not match:
        raise Failure(EXIT_FAILED, "device_error", output.strip()[:ERROR_EXCERPT] or "am broadcast gave no result")
    return int(match[1]), match[2] or ""


def bridge_answer(code: int, answer: str) -> str:
    """The bridge's answer text, or the failure its result code names."""
    if code == BRIDGE_OK:
        return answer
    if code == BRIDGE_NOT_RUN:
        raise Failure(EXIT_NO_BRIDGE, "no_bridge", f"the Ink Tools Helper app did not answer; {BRIDGE_NEXT_STEP}", BRIDGE_NEXT_STEP)
    if code == BRIDGE_USAGE:
        raise bad_usage(f"the bridge refused the request: {answer}")
    if code == BRIDGE_TIMEOUT_RESULT:
        raise Failure(EXIT_TIMEOUT, "timeout", f"the bridge: {answer}", BRIDGE_LOG_STEP)
    raise Failure(EXIT_FAILED, "device_error", f"the bridge ({BRIDGE_RESULTS.get(code, code)}): {answer}", BRIDGE_LOG_STEP)


def signal_activity(device: Device, state: str) -> bool:
    """Tell the Ink Tools Helper that a command starts or ends on the tablet, so its mark can show
    that inkctl is driving it (#430). Best effort: a missing or older Helper, which answers no
    receiver or a usage refusal, or a slow answer never changes the command's result or exit code."""
    try:
        bridge_result(device, ACTIVITY_OP, call_timeout=ACTIVITY_TIMEOUT, state=state)
    except Failure:
        return False
    return True


def plugin_row(device: Device, plugin_id: str) -> dict:
    """The single-plugin row, which alone carries usesPermissions."""
    rows = query_rows(device, f"{CONTENT_QUERY} {PLUGIN_URI}/{shlex.quote(plugin_id)}")
    if not rows:
        raise not_found(f"plugin {plugin_id}", PLUGIN_LIST_STEP)
    return rows[0]


def is_enabled(row: dict) -> bool:
    value = row.get("enable")
    if value is None:
        raise Failure(EXIT_FAILED, "device_error", "the plugin list has no enable column, so the change cannot be proved")
    return value.strip().lower() in PLUGIN_ON_VALUES


def permission_states(row: dict) -> dict:
    """Each permission's status from usesPermissions, a JSON list of {name, status}, as measured in
    docs/research/2026-11-pluginhost-control.md › 1; any other text stops with that text."""
    raw = row.get("usesPermissions")
    if raw is None:
        raise Failure(EXIT_FAILED, "device_error", "the plugin row has no usesPermissions column, so the permissions cannot be proved")
    try:
        items = json.loads(raw)
        if isinstance(items, list) and all(isinstance(item, dict) and "name" in item for item in items):
            return {item["name"]: int(item["status"]) if "status" in item else None for item in items}
    except (ValueError, TypeError):
        pass
    if raw.strip() in ("", "null"):
        return {}
    raise Failure(EXIT_FAILED, "device_error", f"usesPermissions is in a notation inkctl cannot read: {raw[:ERROR_EXCERPT]}")


def wait_until(limit: float, condition, message: str):
    """Poll `condition` until it gives a value, or time out with `message`."""
    started = time.monotonic()
    while True:
        value = condition()
        if value:
            return value
        if time.monotonic() - started >= limit:
            raise Failure(EXIT_TIMEOUT, "timeout", f"{message} after {limit:g} s")
        time.sleep(WAIT_INTERVAL)


def landed_despite_failure(device: Device, config: dict, limit: float):
    """The plugin's row when PluginHost answered onFailed yet holds the file's build: its binder
    thread can carry another plugin's id and refuse the callback after the update landed
    (docs/supernote.md, #225). None when the list does not prove the build."""
    for row in settled_plugin_rows(device, limit):
        if row.get("pluginID") == config["id"] and "versionName" in row and same_build(row, config, row["versionName"]):
            return row
    return None


def install_through_bridge(device: Device, args: argparse.Namespace, config: dict, installed: list, since: str | None = None) -> tuple:
    pushed = push_file(device, args.file, remote_path(f"{PLUGIN_FOLDER}/{os.path.basename(args.file)}"), args.overwrite)
    code, answer = bridge_result(device, "install", path=pushed["path"])
    # A first install refused with errorCode=100 can still leave its row in the list with its native
    # part not loaded, so no toolbar button (Manta, 2026-11-27, #533): the row proves nothing there.
    refused_first = not installed and code == BRIDGE_FAILED and HOST_FOREIGN_PLUGIN in answer
    # The list proves a failure that landed only when the version changed (#225).
    row = landed_despite_failure(device, config, args.timeout) if code == BRIDGE_FAILED and since is None and not refused_first else None
    if row is None and code == BRIDGE_FAILED and HOST_FOREIGN_PLUGIN in answer:
        # Another plugin's id on the host's binder thread refused the install; it held after a
        # plugin action ran and cleared after a host restart (measured twice, Manta, 2026-11-26, #297).
        print(f"PluginHost answered {HOST_FOREIGN_PLUGIN}: restarting {HOST_PACKAGE} and installing once more", file=sys.stderr, flush=True)
        device.shell(f"am force-stop {shlex.quote(HOST_PACKAGE)}")
        settled_plugin_rows(device, args.timeout)
        if since is not None or refused_first:
            # The second install is proven by PluginHost's own success line for the file, as a
            # same-version update is (#310): a refused first install's row may already be listed.
            since = device.shell(f"date {shlex.quote(HELPER_DATE_FORMAT)}").strip()
        code, answer = bridge_result(device, "install", path=pushed["path"])
        row = landed_despite_failure(device, config, args.timeout) if code == BRIDGE_FAILED and since is None else None
    if row is None:
        bridge_answer(code, answer)
        row = proven_row(device, config, args.timeout, installed, since, pushed["path"])
    else:
        print(f"the bridge reported a failure, but {config['id']} {config['version']} is in the plugin list: {answer}", file=sys.stderr, flush=True)
    removed = remove_package(device, pushed["path"])
    data = {
        "plugin": config["id"],
        "version": config["version"],
        "action": "updated" if installed else "installed",
        "route": "bridge",
        "path": pushed["path"],
        "enabled": None,
        "limit": None,
        "bridge": answer,
        "removed": removed,
        "row": row,
    }
    return data, f"{data['action']}: {config['id']} {config['version']}"


def host_denials(device: Device, since: str, plugin_id: str) -> list[str]:
    """PluginHost's refusals of this plugin's own files logged since `since`, such as the
    `PluginSec DENY reason=other_plugin` on its .npk that left an enable unanswered (#228). Other
    refusals, such as the CPU folder listing every enable logs, are not this plugin's."""
    done = device.adb("logcat", "-d", "-v", "time", "-T", since, "-s", "PluginSec")
    lines = done.stdout.decode(errors="replace").splitlines()
    return [line.strip() for line in lines if PLUGIN_DENIED.search(line) and plugin_id in line]


def command_plugin_enable(device: Device, args: argparse.Namespace):
    wanted = args.plugin_state == "enable"
    row = resolve_plugin(device, args.plugin)
    plugin_id = row["pluginID"]
    if is_enabled(row) == wanted:
        data = {"plugin": plugin_id, "enable": wanted, "action": "unchanged", "row": row}
        return data, f"unchanged: {plugin_id} is already {'enabled' if wanted else 'disabled'}"
    require_bridge(device)
    since = device.shell(f"date {shlex.quote(HELPER_DATE_FORMAT)}").strip()

    def changed():
        return next((item for item in plugin_rows(device) if item.get("pluginID") == plugin_id and is_enabled(item) == wanted), None)

    try:
        answer = bridge_call(device, args.plugin_state, pluginID=plugin_id)
        row = wait_until(args.timeout, changed, f"{plugin_id} is not {'enabled' if wanted else 'disabled'} in the plugin list")
    except Failure as failure:
        denials = host_denials(device, since, plugin_id) if wanted else []
        if denials:
            failure.message += f"; PluginHost refused the plugin's own files: {denials[0]}"
            failure.next_step = ENABLE_REFUSED_STEP.format(id=plugin_id)
            failure.extra = {**failure.extra, "denied": denials}
        raise
    data = {"plugin": plugin_id, "enable": wanted, "action": "enabled" if wanted else "disabled", "route": "bridge", "bridge": answer, "row": row}
    return data, f"{data['action']}: {plugin_id}"


def command_plugin_allow(device: Device, args: argparse.Namespace):
    plugin_id = resolve_plugin(device, args.plugin)["pluginID"]
    states = permission_states(plugin_row(device, plugin_id))
    names = args.permissions or sorted(states)
    if not names:
        raise bad_usage(f"{plugin_id} uses no permission; name one")
    unknown = [name for name in names if name not in states]
    if unknown:
        raise not_found(f"permission {', '.join(unknown)} in {plugin_id}'s usesPermissions", f"inkctl plugin allow {plugin_id}")
    require_bridge(device)
    answer = bridge_call(device, "allow", pluginID=plugin_id, perm=",".join(names), status=PERMISSION_STATUS_ALWAYS)

    def allowed():
        now = permission_states(plugin_row(device, plugin_id))
        return now if all(now.get(name) == PERMISSION_STATUS_ALWAYS for name in names) else None

    now = wait_until(args.timeout, allowed, f"{plugin_id}'s permissions are not all Always Allow")
    data = {"plugin": plugin_id, "permissions": {name: now[name] for name in names}, "status": PERMISSION_STATUS_ALWAYS, "route": "bridge", "bridge": answer}
    return data, f"always allowed: {plugin_id} {' '.join(names)}"


def action_answer(lines: list[str], plugin: str, request_id: str):
    """The whole answer to this request from the plugin's log lines, or None while a chunk is missing."""
    parts = {}
    for line in lines:
        found = ACTION_ANSWER.fullmatch(parse_log(line).get("message", ""))
        if found and found["plugin"] == plugin and found["id"] == request_id:
            parts[int(found["index"])] = (int(found["count"]), found["chunk"])
    return whole_answer(parts)


def action_failure(plugin: str, action: str, answer: dict) -> Failure:
    """The plugin's refusal or failure, with the exit code its answer code maps to: the channel's
    ACTION_REFUSED and ACTION_STALE are 2 and 7, inkctl's own usage and stale codes, by design."""
    message = f"{plugin} {action}: {answer.get('message')}"
    step = logs_step(plugin)
    if answer.get("code") == EXIT_USAGE:
        return Failure(EXIT_USAGE, "usage", message, step)
    if answer.get("code") == EXIT_STALE:
        return Failure(EXIT_STALE, "stale", message, f"inkctl plugin action {plugin} {action}")
    return Failure(EXIT_FAILED, "device_error", message, step)


def exists_failure(path: str) -> Failure:
    """A file inkctl would replace, refused without --overwrite."""
    return Failure(EXIT_EXISTS, "exists", f"{path} exists; pass --overwrite to replace it")


def logs_step(name: str) -> str:
    """The next step after a plugin's failed or missing answer: its own log lines."""
    return f"inkctl logs --plugin {name}"


def run_action(device: Device, name: str, action: str, request_args: dict, timeout: float) -> dict:
    """Push one request to a plugin's action file and wait for its answer in the log (#283)."""
    with one_request_at_a_time(f"{name}-action"):
        return locked_action(device, name, action, request_args, timeout)


def locked_action(device: Device, name: str, action: str, request_args: dict, timeout: float) -> dict:
    """The screen is woken first: the plugin reads its file on a native timer that counts uptime, so
    it stops while the tablet sleeps, also with the cable in (device round 11, #4)."""
    plugin = ACTION_PLUGINS[name]
    device.wake()
    now = device.shell("date +%s").strip()
    if not now.isdigit():
        raise Failure(EXIT_FAILED, "device_error", f"the tablet's time did not read: {now!r}")
    request_id = uuid.uuid4().hex
    request = {"id": request_id, "action": action, "args": request_args, "at": int(now) * MILLISECONDS}
    text = json.dumps(request)
    size = len(text.encode("utf-8"))
    if size > plugin.get("max_request_bytes", size):
        raise bad_usage(f"the {name} {action} request is {size} bytes and {name} reads at most "
                        f"{plugin['max_request_bytes']}: split it into several requests")
    since = device.shell(f"date {shlex.quote(HELPER_DATE_FORMAT)}").strip()
    with tempfile.TemporaryDirectory() as folder:
        local = os.path.join(folder, ACTION_FILE)
        Path(local).write_text(text, encoding="utf-8")
        device.shell(f"mkdir -p {shlex.quote(plugin['folder'])}")
        push_file(device, local, f"{plugin['folder']}/{ACTION_FILE}", overwrite=True)
    started = time.monotonic()
    while True:
        done = device.adb("logcat", "-d", "-v", "time", "-T", since, "-s", PLUGIN_LOG_TAG)
        answer = action_answer(done.stdout.decode(errors="replace").splitlines(), name, request_id)
        if answer is not None:
            break
        if time.monotonic() - started >= timeout:
            raise Failure(EXIT_TIMEOUT, "timeout", f"{name} gave no answer in {timeout:g} s; is it installed and on?", logs_step(name))
        time.sleep(WAIT_INTERVAL)
    if not answer.get("ok"):
        raise action_failure(name, action, answer)
    return answer


def setting_value(pair: str) -> tuple:
    """One `KEY=VALUE` of `--set`: true and false as booleans, null as none, any other value as text;
    the plugin refuses a key or a type it does not take."""
    key, sep, value = pair.partition("=")
    if not sep or not key:
        raise bad_usage(f"--set takes KEY=VALUE, not {pair!r}")
    return key, {"true": True, "false": False, "null": None}.get(value, value)


def command_plugin_action(device: Device, args: argparse.Namespace):
    """Run a plugin's own action by its request file and print the plugin's result line (#283)."""
    plugin = ACTION_PLUGINS.get(args.plugin)
    if plugin is None:
        raise bad_usage(f"{args.plugin} has no actions; plugins with actions: {', '.join(ACTION_PLUGINS)}")
    if args.action not in plugin["actions"]:
        raise bad_usage(f"{args.plugin} runs {', '.join(plugin['actions'])}, not {args.action}")
    request_args = {}
    if args.module:
        if (args.plugin, args.action) != ("account-sync", "sync"):
            raise bad_usage("--module is for account-sync sync")
        request_args["module"] = args.module
    settings = (args.plugin, args.action) == ("account-sync", "settings")
    if (args.set or args.restore) and not settings:
        raise bad_usage("--set and --restore are for account-sync settings")
    if settings and bool(args.set) == bool(args.restore):
        raise bad_usage("account-sync settings takes --set KEY=VALUE or --restore, one of them")
    if args.restore:
        request_args["restore"] = True
    elif args.set:
        request_args["set"] = dict(setting_value(pair) for pair in args.set)
    answer = run_action(device, args.plugin, args.action, request_args, args.timeout)
    return answer, str(answer.get("line", ""))


def command_ink_record(device: Device, args: argparse.Namespace):
    """Turn a plugin's pen recorder on, or off and save the tape it kept (#298)."""
    if args.state == "start":
        answer = run_action(device, args.plugin, "record-pen", {"on": True}, args.timeout)
        return answer, f"{answer.get('line', '')}; write with the pen, then: inkctl ink record stop FILE --plugin {args.plugin}"
    if not args.file:
        raise bad_usage("ink record stop needs the FILE the tape goes to")
    if os.path.exists(args.file) and not args.overwrite:
        raise exists_failure(args.file)
    answer = run_action(device, args.plugin, "record-pen", {"on": False}, args.timeout)
    tape = answer.get("tape")
    if not isinstance(tape, dict) or not tape.get("events"):
        raise Failure(EXIT_FAILED, "device_error", f"{args.plugin} recorded no pen event; was the module on while you wrote?", logs_step(args.plugin))
    handle, partial = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(args.file)), suffix=".partial")
    with os.fdopen(handle, "w", encoding="utf-8") as stream:
        json.dump(tape, stream)
    os.replace(partial, args.file)
    data = {"path": args.file, "events": len(tape["events"]), "dropped": answer.get("dropped", 0)}
    return data, f"saved: {data['events']} pen events to {args.file}, {data['dropped']} dropped"


def read_tape(path: str) -> dict:
    """The tape at `path`, checked as far as the Mac can: the plugin checks every event again."""
    if not os.path.isfile(path):
        raise not_found(path)
    if os.path.getsize(path) > PEN_TAPE_MAX_BYTES:
        raise bad_usage(f"{path} is over {PEN_TAPE_MAX_BYTES} bytes; record a shorter tape")
    try:
        tape = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError) as error:
        raise bad_usage(f"{path} is not a pen tape: {error}")
    if not isinstance(tape, dict) or tape.get("version") != PEN_TAPE_VERSION or not isinstance(tape.get("events"), list) or not tape["events"]:
        raise bad_usage(f"{path} is not a version {PEN_TAPE_VERSION} pen tape with events")
    return tape


def command_ink_replay(device: Device, args: argparse.Namespace):
    """Play a pen tape to the plugin on the open test note, and print what it played (#298)."""
    tape = read_tape(args.file)
    need_test_note(device, args.allow_notes)
    answer = run_action(device, args.plugin, "replay-pen", {"tape": tape}, args.timeout)
    return answer, str(answer.get("line", ""))


def command_plugin_install(device: Device, args: argparse.Namespace):
    config = read_plugin_config(args.file)
    name = os.path.basename(args.file)
    if plugin_view_shown(device):
        raise Failure(EXIT_UNEXPECTED_SCREEN, "unexpected_screen", PLUGIN_VIEW_OPEN)
    installed = [row for row in settled_plugin_rows(device, args.timeout) if row.get("pluginID") == config["id"]]
    same = bool(installed) and same_build(installed[0], config, installed[0].get("versionName"))
    if same and not args.same_version:
        raise Failure(EXIT_EXISTS, "exists", f"{config['id']} {config['version']} is already installed", PLUGIN_LIST_STEP)
    # A same-version update leaves the list unchanged, so PluginHost's own line, logged after
    # this moment, is the proof (#310).
    since = device.shell(f"date {shlex.quote(HELPER_DATE_FORMAT)}").strip() if same else None
    if bridge_installed(device):
        return install_through_bridge(device, args, config, installed, since)
    pushed = push_file(device, args.file, remote_path(f"{PLUGIN_FOLDER}/{name}"), args.overwrite)
    start_activity(device, f"-n {SETTINGS_ACTIVITY}")
    for step in PLUGIN_PATH_STEPS:
        press_element(device, expect_element(device, step, args.step_timeout))
    pick = expect_element(device, PLUGIN_PICK_STEP, args.step_timeout)
    limit = read_enabled_limit(device)
    print(f"plugins enabled: {limit['enabled']} of {limit['limit']}", file=sys.stderr, flush=True)
    press_element(device, pick)
    expect_element(device, PLUGIN_CONFIRM_STEP, args.step_timeout)  # the picker's own button: this is the picker
    turn_to_file(device, name, args.step_timeout)
    press_element(device, expect_element(device, f"text:{name}", args.step_timeout))
    press_element(device, expect_element(device, PLUGIN_CONFIRM_STEP, args.step_timeout))
    row = proven_row(device, config, args.timeout, installed, since, pushed["path"])
    removed = remove_package(device, pushed["path"])
    data = {
        "plugin": config["id"],
        "version": config["version"],
        "action": "updated" if installed else "installed",
        "route": "screen",
        "path": pushed["path"],
        **limit,
        "removed": removed,
        "row": row,
    }
    return data, f"{data['action']}: {config['id']} {config['version']}"


def resolve_plugin(device: Device, name: str) -> dict:
    """The one installed plugin a name points to, before anything is pressed."""
    found = find_plugins(plugin_rows(device), name)
    if not found:
        raise not_found(f"plugin {name}", PLUGIN_LIST_STEP)
    if len(found) > 1:
        raise Failure(EXIT_NOT_FOUND, "ambiguous", f"{len(found)} plugins answer to {name}; use its pluginID", PLUGIN_LIST_STEP, "more than one plugin answers to that name")
    return found[0]


def find_plugin_row(device: Device, row: dict, limit: int) -> dict:
    """The plugin's row in Settings › Apps › Plugins, by a name it shows, scrolled to on a long list."""
    for name in shown_plugin_names(row):
        selector = f"text:{name}"
        try:
            found = scroll_until_found(device, selector, limit)
        except Failure as failure:
            if failure.code != EXIT_NOT_FOUND:
                raise
            continue
        if len(find_selector(found["elements"], selector)) > 1:
            raise unexpected_screen(f"{selector} shows more than once on the plugin list")
        return found["found"]
    raise unexpected_screen(f"{row.get('pluginID', '')} has no row on the plugin list")


def open_plugin_page(device: Device, args: argparse.Namespace, row: dict) -> None:
    """Settings › Apps › Plugins › the plugin, through the same named steps as `plugin install`."""
    start_activity(device, f"-n {SETTINGS_ACTIVITY}")
    for step in PLUGIN_PATH_STEPS:
        press_element(device, expect_element(device, step, args.step_timeout))
    expect_element(device, PLUGIN_PICK_STEP, args.step_timeout)  # the list's own button: this is the plugin list
    press_element(device, find_plugin_row(device, row, args.max_steps))


def vertical_edges(element: dict) -> tuple[int, int]:
    _, top, _, bottom = element["bounds"]
    return top, bottom


def permission_label(state: dict, texts: list[dict]):
    """A permission row's label: the nearest text left of its state on the same line, else the nearest text above it.

    shortcut: the Permissions page's layout is not measured; confirm it with `inkctl snapshot` on the tablet (#191)."""
    beside = [text for text in texts if vertical_edges(text)[0] <= state["y"] <= vertical_edges(text)[1] and text["x"] < state["x"]]
    if beside:
        return max(beside, key=lambda text: text["x"])
    above = [text for text in texts if vertical_edges(text)[1] <= vertical_edges(state)[0]]
    return max(above, key=lambda text: vertical_edges(text)[1]) if above else None


def permission_rows(elements: list[dict]):
    """Each permission on the page with its state, or None when the screen is not a page of permission rows.
    The choices dialog reads as None too: its three choices share one label."""
    states = [element for element in elements if element["text"] in PERMISSION_STATES]
    texts = [element for element in elements if element["text"] and element["text"] not in PERMISSION_STATES]
    rows = []
    for state in states:
        label = permission_label(state, texts)
        if label is None:
            return None
        rows.append({"permission": label["text"], "state": state["text"], "element": state})
    labels = [row["permission"] for row in rows]
    return rows if rows and len(set(labels)) == len(labels) else None


def expect_permissions(device: Device, limit: float) -> list[dict]:
    return expect_screen(device, permission_rows, limit, f"no page of permission rows, each with one state of {', '.join(PERMISSION_STATES)}")


def permission_choices(elements: list[dict]):
    """The always-allow choice of the dialog a permission row opens: every choice shows once, and the screen is not the page."""
    if permission_rows(elements) is not None or any(len(find_selector(elements, f"text:{state}")) != 1 for state in PERMISSION_STATES):
        return None
    return find_selector(elements, f"text:{PERMISSION_ALWAYS}")[0]


def shown_permissions(rows: list[dict]) -> list[dict]:
    return [{"permission": row["permission"], "state": row["state"]} for row in rows]


def read_back_permissions(device: Device, limit: float) -> list[dict]:
    """The page once every permission shows the always-allow choice; a page that keeps another one is a failed write."""
    started = time.monotonic()
    while True:
        rows = expect_permissions(device, limit)
        left = [row["permission"] for row in rows if row["state"] != PERMISSION_ALWAYS]
        if not left:
            return rows
        if time.monotonic() - started >= limit:
            raise Failure(EXIT_FAILED, "device_error", f"after the presses, not on «{PERMISSION_ALWAYS}»: {', '.join(left)}", extra={"permissions": shown_permissions(rows)})
        time.sleep(WAIT_INTERVAL)


def reopen_permissions(device: Device, args: argparse.Namespace, row: dict) -> None:
    """Back to the plugin's permission rows after a choice. The tablet stays on the permission's own
    page (Allow / Ask Every Time / Don't Allow), and the hardware Back closes Settings instead of going
    up one level [measured, Manta, firmware 2559, 2026-11-27, #537]; so close it and walk the path again.
    shortcut: the page's own back arrow has no recorded selector; use it once `inkctl snapshot` names it."""
    device.shell("input keyevent BACK")
    open_plugin_page(device, args, row)
    press_element(device, expect_element(device, PLUGIN_PERMISSIONS_STEP, args.step_timeout))


def command_plugin_permissions(device: Device, args: argparse.Namespace):
    """Read a plugin's permissions in Settings, or set each one the page lists to the always-allow choice.
    The page lists only what the plugin declares, so nothing undeclared is granted."""
    row = resolve_plugin(device, args.plugin)
    open_plugin_page(device, args, row)
    press_element(device, expect_element(device, PLUGIN_PERMISSIONS_STEP, args.step_timeout))
    rows = expect_permissions(device, args.step_timeout)
    data = {"plugin": row.get("pluginID", "")}
    if args.choice:
        changed = []
        for label in [item["permission"] for item in rows if item["state"] != PERMISSION_ALWAYS]:
            current = [item for item in expect_permissions(device, args.step_timeout) if item["permission"] == label]
            if not current:
                raise unexpected_screen(f"the permission {label} left the page")
            press_element(device, current[0]["element"])
            press_element(device, expect_screen(device, permission_choices, args.step_timeout, f"no page with the choices {', '.join(PERMISSION_STATES)}"))
            changed.append(label)
            reopen_permissions(device, args, row)
        rows = read_back_permissions(device, args.step_timeout)
        data["changed"] = changed
    data["permissions"] = shown_permissions(rows)
    return data, "\n".join(f"{item['permission']}\t{item['state']}" for item in data["permissions"])


def uninstall_warning(elements: list[dict]):
    return next((element for element in elements if UNINSTALL_WARNING in element["text"]), None)


def wait_for_plugin_gone(device: Device, plugin_id: str, limit: float) -> None:
    """Prove the uninstall from the list. Right after one, the provider once gave no answer
    (docs/supernote.md › Plugins), so a read that fails is one more turn of the wait."""
    started = time.monotonic()
    while True:
        try:
            if not any(row.get("pluginID") == plugin_id for row in plugin_rows(device)):
                return
        except Failure as failure:
            if failure.code != EXIT_FAILED:
                raise
        if time.monotonic() - started >= limit:
            raise Failure(EXIT_TIMEOUT, "timeout", f"{plugin_id} is still in the plugin list after {limit:g} s")
        time.sleep(WAIT_INTERVAL)


def command_plugin_uninstall(device: Device, args: argparse.Namespace):
    row = resolve_plugin(device, args.plugin)
    plugin_id = row.get("pluginID", "")
    if not plugin_id:
        raise Failure(EXIT_FAILED, "device_error", "the plugin list has no pluginID column, so this uninstall cannot be proved")
    if bridge_installed(device):
        answer = bridge_call(device, "uninstall", pluginID=plugin_id)
        wait_for_plugin_gone(device, plugin_id, args.timeout)
        return {"plugin": plugin_id, "action": "uninstalled", "route": "bridge", "bridge": answer}, f"uninstalled: {plugin_id}"
    open_plugin_page(device, args, row)
    press_element(device, expect_element(device, PLUGIN_UNINSTALL_STEP, args.step_timeout))
    expect_screen(device, uninstall_warning, args.step_timeout, f"no confirmation saying «{UNINSTALL_WARNING}»")
    press_element(device, expect_element(device, UNINSTALL_CONFIRM_STEP, args.step_timeout))
    wait_for_plugin_gone(device, plugin_id, args.timeout)
    return {"plugin": plugin_id, "action": "uninstalled", "route": "screen"}, f"uninstalled: {plugin_id}"


def parse_log(line: str) -> dict:
    match = LOG_LINE.fullmatch(line)
    if not match:
        return {"message": line}
    return {**match.groupdict(), "tag": match["tag"].strip(), "pid": int(match["pid"])}


def period_seconds(text: str) -> int:
    match = PERIOD.fullmatch(text)
    if not match:
        raise bad_usage(f"a period is a number and s, m, h or d, such as 30m: {text}")
    return int(match[1]) * PERIOD_SECONDS[match[2]]


def log_start(device: Device, since: str) -> str:
    """A value for `logcat -T`: an exact device time as it is, or a period counted on the device's clock."""
    if LOG_TIME.fullmatch(since):
        return since
    seconds = period_seconds(since)
    return f"{int(device.shell('date +%s').strip()) - seconds}.000"


def logcat_call(device: Device, args: argparse.Namespace, mark: str) -> list[str]:
    """The `logcat` arguments for these filters. Never `logcat -c`: it fails on the Manta."""
    call = ["logcat", *([] if args.follow else ["-d"]), "-v", "time"]
    start = mark or (log_start(device, args.since) if args.since else "")
    if start:
        call += ["-T", start]
    else:
        call += ["-t", str(PLUGIN_LOG_WINDOW if args.plugin else args.lines)]
    if args.package:
        pids = device.shell(f"pidof {shlex.quote(args.package)} || true").split()
        if not pids:
            raise not_found(f"a running process of {args.package}", "inkctl apps")
        call.append(f"--pid={pids[0]}")  # shortcut: only the first process; widen when a package runs several
    elif args.pid:
        call.append(f"--pid={args.pid}")
    if args.tag:
        call += ["-s", f"{args.tag}:{args.level}" if args.level else args.tag]
    elif args.level:
        call.append(f"*:{args.level}")
    return call


def log_keeps(args: argparse.Namespace, mark: str, names: list[str]):
    """The test a device log line must pass, for what `logcat` cannot filter by itself. A plugin's
    lines carry no tag of their own (they log under ReactNativeJS in the shared host process), so a
    line counts as the plugin's when it holds one of the plugin's names (#192)."""
    text = (args.grep or "").lower()
    plugin = [name.lower() for name in names]

    def keeps(line: str) -> bool:
        lowered = line.lower()
        if line.startswith("---------") or text not in lowered:
            return False
        if plugin and not any(name in lowered for name in plugin) and not PLUGIN_DENIED.search(line):
            return False
        return not mark or parse_log(line).get("time", mark + "~") > mark  # logcat -T repeats the marked line

    return keeps


def log_entry(args: argparse.Namespace, line: str) -> dict:
    entry = parse_log(line)
    if args.plugin:
        entry["denied"] = bool(PLUGIN_DENIED.search(line))
    return entry


def read_log_mark() -> str:
    return LOG_MARK_FILE.read_text().strip() if LOG_MARK_FILE.is_file() else ""


def save_log_mark(lines: list[str]) -> None:
    """Remember the newest line read. Failing here only means the next read repeats some lines."""
    times = [parse_log(line).get("time", "") for line in lines]
    if not any(times):
        return
    try:
        LOG_MARK_FILE.parent.mkdir(parents=True, exist_ok=True)
        LOG_MARK_FILE.touch(mode=PRIVATE_FILE_MODE, exist_ok=True)
        LOG_MARK_FILE.write_text(max(times))
    except OSError as error:
        print(f"inkctl: the log mark was not saved: {error}", file=sys.stderr)


def follow_log(device: Device, args: argparse.Namespace, call: list[str], keeps):
    """Print new lines until the time limit; a quiet device is a normal end, not a failure."""
    entries = []
    for raw in device.stream(call, args.timeout):
        line = CREDENTIAL.sub(CREDENTIAL_MASK, raw)
        if keeps(line):
            entries.append(log_entry(args, line))
            if not args.json:
                print(line, flush=True)
    return {"lines": entries}, None


def command_logs(device: Device, args: argparse.Namespace):
    if args.follow and args.since_last:
        raise bad_usage("--follow already shows only new lines; drop --since-last")
    mark = read_log_mark() if args.since_last else ""
    names = plugin_log_names(device, args.plugin) if args.plugin else []
    keeps = log_keeps(args, mark, names)
    call = logcat_call(device, args, mark)
    if args.follow:
        return follow_log(device, args, call, keeps)
    done = device.adb(*call)
    if done.returncode != 0:
        raise Failure(EXIT_FAILED, "device_error", done.stderr.decode(errors="replace").strip() or "logcat failed")
    every = CREDENTIAL.sub(CREDENTIAL_MASK, done.stdout.decode(errors="replace")).splitlines()
    lines = [line for line in every if keeps(line)]
    if not (mark or args.since):
        lines = lines[-args.lines:]  # `logcat -t` counts per buffer, so it can return more than asked
    if args.since_last:
        save_log_mark(every)
    if args.tag and not lines and find_plugins(plugin_rows(device), args.tag):
        print(f"inkctl: a plugin logs under the tag {PLUGIN_LOG_TAG}, not {args.tag}; use --plugin {args.tag}", file=sys.stderr)
    return {"lines": [log_entry(args, line) for line in lines]}, "\n".join(lines)


def history_matches(run: dict, args: argparse.Namespace, cutoff) -> bool:
    if args.failures and run["exit"] == EXIT_OK:
        return False
    if args.name and run["command"] != args.name and not run["command"].startswith(f"{args.name} "):
        return False
    return cutoff is None or datetime.fromisoformat(run["time"]) >= cutoff


def command_history(device, args: argparse.Namespace):
    """Read the command's own log, which needs no device."""
    cutoff = datetime.now(timezone.utc) - timedelta(seconds=period_seconds(args.since)) if args.since else None
    try:
        lines = HISTORY_FILE.read_text(encoding="utf-8", errors="replace").splitlines() if HISTORY_FILE.is_file() else []
    except OSError as error:
        raise Failure(EXIT_FAILED, "log_error", f"cannot read {HISTORY_FILE}: {error}") from error
    runs, unreadable = [], 0
    for line in lines:
        try:
            run = json.loads(line)
            if history_matches(run, args, cutoff):
                runs.append(run)
        except (ValueError, KeyError, TypeError):
            unreadable += 1
    runs = runs[-args.limit:]
    text = "\n".join(f"{run['time']} {run['command']} exit={run['exit']} error={run['error']} {run['seconds']} s" for run in runs)
    if unreadable:
        print(f"inkctl: {unreadable} log lines could not be read", file=sys.stderr)
    return {"runs": runs, "unreadable": unreadable}, text


def wifi_serial(address: str) -> str:
    return address if ":" in address else f"{address}:{ADB_PORT}"


def open_device(args: argparse.Namespace, log: RunLog) -> Device:
    """The cable when one authorized tablet is attached, else Wi-Fi ADB (#171): the cable keeps
    working with the tablet's Wi-Fi off and after `wifi off`, and the result says which link it took."""
    try:
        address = read_address()
    except Failure:
        address = ""
    wifi = wifi_serial(address) if address else ""
    log.secrets = [secret for secret in (wifi, address) if secret]
    attached = usb_serials(Device("", log)) if args.connects else []
    if len(attached) == 1:
        log.secrets.append(attached[0])  # a serial number names the tablet, so the log masks it too
        return Device(attached[0], log, wifi, LINK_USB)
    if not wifi:
        read_address()  # raises the usage failure that names the address file
    return Device(wifi, log)


def usb_serials(device: Device) -> list[str]:
    """The tablets attached by USB and authorized: `adb devices` rows whose serial is no network address."""
    listing = device.adb("devices", serial=False).stdout.decode(errors="replace")
    rows = (line.split() for line in listing.splitlines()[1:])
    return [row[0] for row in rows if len(row) == 2 and row[1] == "device" and ":" not in row[0]]


def command_wifi_on(device: Device, args: argparse.Namespace):
    """`adb tcpip` over the cable opens the network port; the proof is a Wi-Fi connection that answers."""
    attached = usb_serials(device)
    if len(attached) != 1:
        found = "no tablet" if not attached else f"{len(attached)} devices"
        raise Failure(EXIT_FAILED, "no_usb", f"{found} on USB; connect one tablet with the cable and allow USB debugging")
    done = device.adb("-s", attached[0], "tcpip", str(ADB_PORT), serial=False)
    if done.returncode != 0:
        raise Failure(EXIT_FAILED, "device_error", (done.stdout + done.stderr).decode(errors="replace").strip())
    started = time.monotonic()
    while True:  # the tablet restarts its ADB daemon before the port answers
        try:
            device.connect()
            break
        except Failure:
            if time.monotonic() - started >= args.timeout:
                raise Failure(EXIT_TIMEOUT, "timeout", f"the port did not answer after {args.timeout:g} s") from None
            time.sleep(WAIT_INTERVAL)
    return {"wifi_adb": "on", "off": "inkctl wifi off"}, "Wi-Fi ADB is on. Turn it off when the work ends: inkctl wifi off"


def command_wifi_off(device: Device, args: argparse.Namespace):
    """`adb usb` closes the network port; the proof is that the port stops answering. Without a
    cable that would leave nothing to reach the tablet with, so it needs --leave-unreachable (#171)."""
    if device.link != LINK_USB and not args.leave_unreachable:
        raise Failure(EXIT_FAILED, "no_usb", "no tablet on USB: after wifi off nothing could reach it; attach the cable, or pass --leave-unreachable when the work ends")
    done = device.adb("usb")
    if done.returncode != 0:
        raise Failure(EXIT_FAILED, "device_error", (done.stdout + done.stderr).decode(errors="replace").strip())
    device.adb("disconnect", device.wifi, serial=False)
    started = time.monotonic()
    while not device.probe():
        if time.monotonic() - started >= args.timeout:
            raise Failure(EXIT_TIMEOUT, "timeout", f"the port still answers after {args.timeout:g} s")
        time.sleep(WAIT_INTERVAL)
    return {"wifi_adb": "off", "restore": USB_RESTORE}, f"Wi-Fi ADB is off. To turn it on again, {USB_RESTORE}"


def secret_path(provider: str) -> str:
    return f"{SIGN_IN_DROP_FOLDER}/{provider}.secret"


def parse_secret(raw: str) -> str:
    """sync-core's `parseSecret`: one trailing newline is dropped; empty or a control character is refused."""
    value = raw[:-2] if raw.endswith("\r\n") else raw[:-1] if raw.endswith("\n") else raw
    if value == "":
        raise bad_usage("the secret is empty; pipe it on standard input")
    if CONTROL_CHARACTER.search(value):
        raise bad_usage("the secret holds a control character")
    return value




def google_client_secret() -> str:
    """The Keychain client as the one-line JSON sync-core's `parseGoogleClient` reads; only its two fields."""
    client = google_client()
    return json.dumps({"client_id": client["client_id"], "client_secret": client["client_secret"]}, separators=(",", ":"))


def command_secret_set(device: Device, args: argparse.Namespace):
    if args.provider == GOOGLE_CLIENT_PROVIDER:
        raw = google_client_secret()
    elif sys.stdin.isatty():
        import getpass  # only when typed by hand, so nothing is echoed

        raw = getpass.getpass(f"{args.provider} secret: ")
    else:
        raw = sys.stdin.read()
    value = parse_secret(raw)
    device.log.secrets.append(value)
    path = shlex.quote(secret_path(args.provider))
    partial = shlex.quote(f"{secret_path(args.provider)}.partial")
    # The value goes on stdin: argv reaches `ps` and the history file. A temp name, then a rename, so a
    # lost connection never leaves half a secret.
    folder = shlex.quote(SIGN_IN_DROP_FOLDER)
    done = device.adb("shell", f"umask 077; mkdir -p {folder} && cat > {partial} && mv {partial} {path}", stdin=value.encode())
    if done.returncode != 0:
        device.shell(f"rm -f {partial}")
        problem = device.log.clean(done.stderr.decode(errors="replace").strip())
        raise Failure(EXIT_FAILED, "device_error", problem or f"the {args.provider} secret was not written")
    # No part of the secret is ever shown, not even its last characters (#433).
    data = {"provider": args.provider, "stored": True}
    return data, f"{args.provider}: waiting for Account Sync; it moves in on its next start or Sync now"


def command_secret_remove(device: Device, args: argparse.Namespace):
    path = secret_path(args.provider)
    existed = device.test(f"-f {shlex.quote(path)}")
    device.shell(f"rm -f {shlex.quote(path)}")
    if device.test(f"-e {shlex.quote(path)}"):
        raise Failure(EXIT_FAILED, "device_error", f"the {args.provider} secret is still there after rm")
    # Only a drop file Account Sync has not taken yet; a moved-in secret is signed out in its Settings.
    removed = f"{args.provider}: the waiting secret was removed"
    none = f"{args.provider}: nothing waiting; sign out in Account Sync Settings"
    return {"provider": args.provider, "removed": existed}, removed if existed else none


def command_secret_status(device: Device, args: argparse.Namespace):
    rows = []
    for provider in SECRET_PROVIDERS:
        path = shlex.quote(secret_path(provider))
        if not device.test(f"-f {path}"):
            rows.append({"provider": provider, "stored": False})
            continue
        # No part of the value crosses the connection or is shown (#433).
        rows.append({"provider": provider, "stored": True})
    lines = [f"{row['provider']}: waiting for Account Sync" if row["stored"] else f"{row['provider']}: nothing waiting" for row in rows]
    return {"providers": rows}, "\n".join(lines)


