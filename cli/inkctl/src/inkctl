def open_consent(address: str) -> None:
    """Open the consent page. $INKCTL_BROWSER, when set, is the only opener: the tests set it to a stub,
    so a test never reaches the person's real browser (#124)."""
    opener = os.environ.get("INKCTL_BROWSER")
    if opener:
        subprocess.Popen([opener, address], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    import webbrowser

    webbrowser.open(address)


def command_google_login(device, args: argparse.Namespace):
    import hmac
    import http.server
    import secrets

    client = google_client()
    state = secrets.token_urlsafe(STATE_BYTES)
    verifier, challenge = pkce_pair()
    outcome: dict = {}

    class Redirect(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            if not any(key in query for key in ("state", "code", "error")):
                self.send_error(http.HTTPStatus.NOT_FOUND)  # such as the browser's favicon request: keep waiting
                return
            failure = None
            try:
                outcome["result"] = finish(query)
            except Failure as refused:
                failure = outcome["failure"] = refused
            page = login_page(failure)
            self.send_response(http.HTTPStatus.OK if failure is None else http.HTTPStatus.BAD_REQUEST)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(page)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(page)

        def log_message(self, *ignored):
            pass  # the request line holds the code

    def finish(query: dict) -> dict:
        if not hmac.compare_digest(query.get("state", [""])[0], state):
            raise Failure(EXIT_FAILED, "google_denied", "the answer's state does not match this sign-in; nothing was stored")
        if "error" in query:
            raise Failure(EXIT_FAILED, "google_denied", f"Google did not sign in: {query['error'][0]}")
        tokens = google_exchange(client, query.get("code", [""])[0], redirect, verifier)
        granted = str(tokens.get("scope", "")).split()
        missing = [scope.rsplit("/", 1)[-1] for scope in GOOGLE_SCOPES if scope not in granted]
        if missing:
            raise Failure(EXIT_FAILED, "google_refused", f"the consent left out {', '.join(missing)}; tick every box and sign in again. Nothing was stored")
        token = tokens.get("refresh_token")
        if not isinstance(token, str) or not token:
            raise Failure(EXIT_FAILED, "google_refused", "Google answered no refresh token; nothing was stored")
        keychain_store_token(token)
        return {"length": len(token), "scopes": granted}

    with http.server.HTTPServer((LOOPBACK_HOST, 0), Redirect) as server:
        redirect = f"http://{LOOPBACK_HOST}:{server.server_port}"
        address = client["auth_uri"] + "?" + urllib.parse.urlencode({
            "client_id": client["client_id"], "redirect_uri": redirect, "response_type": "code",
            "scope": " ".join((*GOOGLE_SCOPES, GOOGLE_TEST_SCOPE)), "state": state, "code_challenge": challenge,
            "code_challenge_method": "S256", "access_type": "offline", "prompt": "consent",
        })
        # The address holds no secret: the client id is public and the state works once.
        print(f"inkctl: finish the sign-in in the browser; if none opened, open:\n{address}", file=sys.stderr, flush=True)
        open_consent(address)
        deadline = time.monotonic() + args.timeout
        while not outcome:
            left = deadline - time.monotonic()
            if left <= 0:
                raise Failure(EXIT_TIMEOUT, "timeout", f"no answer from the browser within {args.timeout:g} seconds", next_step=GOOGLE_LOGIN_STEP)
            server.timeout = left
            server.handle_request()
    if "failure" in outcome:
        raise outcome["failure"]
    result = outcome["result"]
    data = {
        "signed_in": True, "length": result["length"], "scopes": result["scopes"],
        "keychain": {"service": KEYCHAIN_SERVICE, "account": GOOGLE_TOKEN_ACCOUNT}, "next": GOOGLE_PUSH_STEP,
    }
    text = (
        f"google: signed in; refresh token (length {result['length']}) stored in the login Keychain "
        f"({KEYCHAIN_SERVICE} / {GOOGLE_TOKEN_ACCOUNT})\nnext, to send it to Account Sync: {GOOGLE_PUSH_STEP}"
    )
    return data, text


# Test sandboxes (#297, #566): one Todoist project, one Google calendar and one iCloud calendar named SANDBOX_NAME, for device
# rounds. Every call finds the object by that exact name and touches nothing else; every write is
# read back. Standing yes: docs/decisions.md, 2026-11-25.
SANDBOX_NAME = SERVICES["testObjectName"]
TODOIST_TOKEN_ACCOUNT = "ACCOUNT_SYNC_TODOIST_TOKEN"
API_TIMEOUT = 30.0


def api_call(service: str, method: str, url: str, token: str, body: dict | None = None):
    """One JSON call with a bearer token; the token never reaches the output."""
    data = None if body is None else json.dumps(body).encode()
    headers = {"Authorization": f"Bearer {token}", "Accept": "application/json"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, method=method, headers=headers)
    path = urllib.parse.urlsplit(url).path
    try:
        with urllib.request.urlopen(request, timeout=API_TIMEOUT) as answer:
            raw = answer.read()
    except urllib.error.HTTPError as refused:
        detail = refused.read().decode(errors="replace")[:ERROR_EXCERPT]
        scope = "insufficient" in detail.lower() and "scope" in detail.lower()
        raise Failure(
            EXIT_FAILED, "api_refused", f"{service} refused {method} {path} (HTTP {refused.code})",
            next_step=GOOGLE_LOGIN_STEP if scope else "", cause="the stored token lacks a scope" if scope else "",
            extra={"status": refused.code},
        ) from None
    except (urllib.error.URLError, OSError) as lost:
        raise Failure(EXIT_FAILED, "network_error", f"{service} did not answer: {lost}", cause=f"{service} could not be reached", next_step="check the Mac's network, then run the same command") from None
    try:
        return json.loads(raw) if raw.strip() else None
    except ValueError:
        raise Failure(EXIT_FAILED, "api_refused", f"{service} answered {method} {path} with no JSON") from None


def stored_secret(account: str, what: str) -> str:
    value = keychain_read(account)
    if not value:
        raise Failure(
            EXIT_NOT_FOUND, "not_found", f"no {what} in the Keychain item {KEYCHAIN_SERVICE} / {account}",
            next_step=f"security add-generic-password -s {KEYCHAIN_SERVICE} -a {account} -w",
        )
    return value


class TodoistSandbox:
    service = "Todoist"
    kind = "project"

    def __init__(self):
        self.token = stored_secret(TODOIST_TOKEN_ACCOUNT, "Todoist token")
        self.base = SERVICES["todoistApi"]

    def call(self, method: str, path: str, body: dict | None = None):
        return api_call(self.service, method, f"{self.base}{path}", self.token, body)

    def pages(self, path: str, query: dict) -> list[dict]:
        """Every row of a list, page by page (Todoist API v1's `next_cursor`)."""
        rows, cursor = [], None
        while True:
            page = {**query, **({"cursor": cursor} if cursor else {})}
            answer = self.call("GET", f"{path}?{urllib.parse.urlencode(page)}" if page else path) or {}
            rows += answer.get("results", [])
            if not (cursor := answer.get("next_cursor")):
                return rows

    def find(self) -> list[dict]:
        return [{"id": str(row["id"]), "name": row["name"]} for row in self.pages("/projects", {}) if row.get("name") == SANDBOX_NAME]

    def create(self) -> dict:
        row = self.call("POST", "/projects", {"name": SANDBOX_NAME})
        return {"id": str(row["id"]), "name": row["name"]}

    def items(self, found: dict) -> list[dict]:
        return [{"id": str(row["id"]), "title": row.get("content", "")} for row in self.pages("/tasks", {"project_id": found["id"]})]

    def remove(self, found: dict) -> None:
        self.call("DELETE", f"/projects/{urllib.parse.quote(found['id'], safe='')}")


class GoogleSandbox:
    service = "Google Calendar"
    kind = "calendar"

    def __init__(self):
        client = google_client()
        refresh = stored_secret(GOOGLE_TOKEN_ACCOUNT, "Google refresh token")
        self.token = google_access_token(client, refresh)
        self.base = SERVICES["googleCalendarApi"]

    def call(self, method: str, path: str, body: dict | None = None):
        return api_call(self.service, method, f"{self.base}{path}", self.token, body)

    def pages(self, path: str, query: dict) -> list[dict]:
        """Every item of a list, page by page (Calendar API's `nextPageToken`)."""
        rows, token = [], None
        while True:
            page = {**query, **({"pageToken": token} if token else {})}
            answer = self.call("GET", f"{path}?{urllib.parse.urlencode(page)}" if page else path) or {}
            rows += answer.get("items", [])
            if not (token := answer.get("nextPageToken")):
                return rows

    def find(self) -> list[dict]:
        return [{"id": row["id"], "name": row["summary"]} for row in self.pages("/users/me/calendarList", {}) if row.get("summary") == SANDBOX_NAME]

    def create(self) -> dict:
        row = self.call("POST", "/calendars", {"summary": SANDBOX_NAME})
        return {"id": row["id"], "name": row["summary"]}

    def items(self, found: dict) -> list[dict]:
        path = f"/calendars/{urllib.parse.quote(found['id'], safe='')}/events"
        # The API's default page is 250 events; `pages` follows nextPageToken past it.
        return [{"id": row["id"], "title": row.get("summary", "")} for row in self.pages(path, {})]

    def remove(self, found: dict) -> None:
        self.call("DELETE", f"/calendars/{urllib.parse.quote(found['id'], safe='')}")


ICLOUD_SIGN_IN_ACCOUNT = "ACCOUNT_SYNC_ICLOUD_SIGN_IN"
DAV = "DAV:"
CALDAV = "urn:ietf:params:xml:ns:caldav"


def propfind(props: str) -> str:
    """A PROPFIND body asking for `props`, written with the `d:` (DAV) and `c:` (CalDAV) prefixes."""
    return f'<d:propfind xmlns:d="{DAV}" xmlns:c="{CALDAV}"><d:prop>{props}</d:prop></d:propfind>'


def dav_call(method: str, url: str, sign_in: str, body: str = "", depth: str | None = None) -> tuple[int, bytes]:
    """One CalDAV call with Basic credentials (RFC 7617); they never reach the output."""
    import base64

    headers = {"Authorization": "Basic " + base64.b64encode(sign_in.encode()).decode(), "Content-Type": "application/xml; charset=utf-8"}
    if depth is not None:
        headers["Depth"] = depth
    request = urllib.request.Request(url, data=body.encode() if body else None, method=method, headers=headers)
    path = urllib.parse.urlsplit(url).path
    try:
        with urllib.request.urlopen(request, timeout=API_TIMEOUT) as answer:
            return answer.status, answer.read()
    except urllib.error.HTTPError as refused:
        raise Failure(
            EXIT_FAILED, "api_refused", f"iCloud refused {method} {path} (HTTP {refused.code})",
            cause="the stored sign-in is wrong or expired" if refused.code == http.HTTPStatus.UNAUTHORIZED else "",
            next_step=f"store `<Apple ID>:<app-specific password>` in the Keychain item {KEYCHAIN_SERVICE} / {ICLOUD_SIGN_IN_ACCOUNT}" if refused.code == http.HTTPStatus.UNAUTHORIZED else "",
            extra={"status": refused.code},
        ) from None
    except (urllib.error.URLError, OSError) as lost:
        raise Failure(EXIT_FAILED, "network_error", f"iCloud did not answer: {lost}", cause="iCloud could not be reached", next_step="check the Mac's network, then run the same command") from None


def dav_responses(raw: bytes) -> list:
    """The `response` elements of a 207 Multi-Status answer."""
    try:
        return ElementTree.fromstring(raw).findall(f"{{{DAV}}}response")
    except ElementTree.ParseError:
        raise Failure(EXIT_FAILED, "api_refused", "iCloud answered with no readable XML") from None


def xml_text(value: str) -> str:
    return value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


class ICloudSandbox:
    """The CalDAV test calendar (#566): found by its display name in the calendar home, as RFC 4791 and
    RFC 6764 discover it: the principal from the server root, then its calendar-home-set."""

    service = "iCloud"
    kind = "calendar"

    def __init__(self):
        self.sign_in = stored_secret(ICLOUD_SIGN_IN_ACCOUNT, "iCloud sign-in")
        if ":" not in self.sign_in:
            raise Failure(EXIT_NOT_FOUND, "not_found", f"the Keychain item {KEYCHAIN_SERVICE} / {ICLOUD_SIGN_IN_ACCOUNT} is not <Apple ID>:<app-specific password>")
        self.home = self.calendar_home()

    def href(self, base: str, prop: str, body: str) -> str:
        """The first `href` inside `prop` of a Depth 0 PROPFIND on `base`, as an absolute URL."""
        _status, raw = dav_call("PROPFIND", base, self.sign_in, body, depth="0")
        for response in dav_responses(raw):
            found = response.find(f".//{prop}/{{{DAV}}}href")
            if found is not None and found.text:
                return urllib.parse.urljoin(base, found.text.strip())
        raise Failure(EXIT_FAILED, "api_refused", f"iCloud named no {prop.split('}')[-1]}")

    def calendar_home(self) -> str:
        root = SERVICES["icloudCalDav"]
        principal = self.href(root, f"{{{DAV}}}current-user-principal", propfind("<d:current-user-principal/>"))
        return self.href(principal, f"{{{CALDAV}}}calendar-home-set", propfind("<c:calendar-home-set/>"))

    def find(self) -> list[dict]:
        body = propfind("<d:displayname/><d:resourcetype/>")
        _status, raw = dav_call("PROPFIND", self.home, self.sign_in, body, depth="1")
        rows = []
        for response in dav_responses(raw):
            name = response.findtext(f".//{{{DAV}}}displayname")
            calendar = response.find(f".//{{{DAV}}}resourcetype/{{{CALDAV}}}calendar") is not None
            href = response.findtext(f"{{{DAV}}}href")
            if calendar and href and name == SANDBOX_NAME:
                rows.append({"id": urllib.parse.urljoin(self.home, href.strip()), "name": name})
        return rows

    def create(self) -> dict:
        url = urllib.parse.urljoin(self.home, f"{uuid.uuid4()}/")
        body = (f'<c:mkcalendar xmlns:d="{DAV}" xmlns:c="{CALDAV}"><d:set><d:prop><d:displayname>{xml_text(SANDBOX_NAME)}</d:displayname>'
                f'<c:supported-calendar-component-set><c:comp name="VEVENT"/></c:supported-calendar-component-set></d:prop></d:set></c:mkcalendar>')
        dav_call("MKCALENDAR", url, self.sign_in, body)
        return {"id": url, "name": SANDBOX_NAME}

    def items(self, found: dict) -> list[dict]:
        body = (f'<c:calendar-query xmlns:d="{DAV}" xmlns:c="{CALDAV}"><d:prop><c:calendar-data/></d:prop>'
                f'<c:filter><c:comp-filter name="VCALENDAR"><c:comp-filter name="VEVENT"/></c:comp-filter></c:filter></c:calendar-query>')
        _status, raw = dav_call("REPORT", found["id"], self.sign_in, body, depth="1")
        rows = []
        for response in dav_responses(raw):
            data = response.findtext(f".//{{{CALDAV}}}calendar-data") or ""
            # An unfolded SUMMARY line is enough for a list: RFC 5545 folds only lines over 75 octets.
            title = next((line.split(":", 1)[1] for line in data.splitlines() if line.startswith("SUMMARY")), "")
            rows.append({"id": urllib.parse.urljoin(found["id"], (response.findtext(f"{{{DAV}}}href") or "").strip()), "title": title})
        return rows

    def remove(self, found: dict) -> None:
        dav_call("DELETE", found["id"], self.sign_in)


SANDBOXES = {"todoist": TodoistSandbox, "google": GoogleSandbox, "icloud": ICloudSandbox}


def google_access_token(client: dict, refresh: str) -> str:
    body = urllib.parse.urlencode({
        "client_id": client["client_id"], "client_secret": client["client_secret"],
        "refresh_token": refresh, "grant_type": "refresh_token",
    }).encode()
    request = urllib.request.Request(client["token_uri"], data=body, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=TOKEN_EXCHANGE_TIMEOUT) as answer:
            token = json.load(answer).get("access_token")
    except urllib.error.HTTPError as refused:
        raise Failure(EXIT_FAILED, "google_refused", f"Google refused the refresh token (HTTP {refused.code})", next_step=GOOGLE_LOGIN_STEP) from None
    except (urllib.error.URLError, OSError, ValueError) as lost:
        raise Failure(EXIT_FAILED, "network_error", f"Google's token endpoint did not answer: {lost}") from None
    if not isinstance(token, str) or not token:
        raise Failure(EXIT_FAILED, "google_refused", "Google answered no access token", next_step=GOOGLE_LOGIN_STEP)
    return token


def command_sandbox(device, args: argparse.Namespace):
    sandbox = SANDBOXES[args.service]()
    found = sandbox.find()
    label = f"{args.service}: {sandbox.kind} «{SANDBOX_NAME}»"
    if args.action == "create":
        if found:
            return {"service": args.service, "created": False, **found[0]}, f"{label} already exists ({found[0]['id']})"
        made = sandbox.create()
        if not any(row["id"] == made["id"] for row in sandbox.find()):
            raise Failure(EXIT_FAILED, "api_refused", f"{label} was created but does not read back")
        return {"service": args.service, "created": True, **made}, f"{label} created ({made['id']})"
    if args.action == "list":
        rows = [{**row, "items": sandbox.items(row)} for row in found]
        lines = [] if rows else [f"{label}: none"]
        for row in rows:
            lines += [f"{label} ({row['id']}): {len(row['items'])} items", *(f"  {item['title']}" for item in row["items"])]
        return {"service": args.service, "name": SANDBOX_NAME, "sandboxes": rows}, "\n".join(lines)
    for row in found:
        sandbox.remove(row)
    left = sandbox.find()
    if left:
        raise Failure(EXIT_FAILED, "api_refused", f"{label}: {len(left)} still there after the delete")
    removed = [row["id"] for row in found]
    return {"service": args.service, "removed": removed}, f"{label}: {len(removed)} removed" if removed else f"{label}: none to remove"


# A headless LocalSend peer on the Mac (#297): LocalGo (github.com/bethropolis/localgo, MIT), a
# LocalSend v2.2 command line, chosen over the official localsend-cli, whose receive mode asks a key
# for every sender that is not paired over https, and localsnd, which has no https. `receive` starts
# `localgo serve` in its own session, auto-accepting into a test folder, and `stop` ends it by the
# process id it recorded. https (LocalSend's default, with certificates) or plain http (`--http`),
# as the iPhone answers with Encryption off.
LOCALGO_INSTALL = "go install github.com/bethropolis/localgo/cmd/localgo@v0.6.9"
LOCALSEND_FOLDER = Path(__file__).resolve().parents[3] / ".scratch/localsend-received"
LOCALSEND_STATE = Path.home() / ".cache/inkctl/localsend.json"
LOCALSEND_ALIAS = SERVICES["testObjectName"]
LOCALSEND_PORT = 53317  # LocalSend's own default port; plugins/device-link/src/localsend/localsend-golden.json is its golden (#295)
LOCALSEND_INFO = "/api/localsend/v2/info"
LOCALSEND_START_TIMEOUT = 15.0


def localgo() -> str:
    found = os.environ.get("INKCTL_LOCALGO") or shutil.which("localgo")
    if not found:
        raise not_found("the localgo command", LOCALGO_INSTALL)
    return found


def localsend_running() -> dict | None:
    """The recorded peer, while its process still runs."""
    if not LOCALSEND_STATE.is_file():
        return None
    state = json.loads(LOCALSEND_STATE.read_text())
    try:
        os.kill(state["pid"], 0)  # shortcut: a reused process id reads as running; record the start time if that bites
    except ProcessLookupError:
        LOCALSEND_STATE.unlink()
        return None
    return state


def localsend_answers(protocol: str, port: int) -> bool:
    import ssl

    context = ssl.create_default_context()
    context.check_hostname, context.verify_mode = False, ssl.CERT_NONE  # LocalSend's certificate is self-signed
    try:
        with urllib.request.urlopen(f"{protocol}://127.0.0.1:{port}{LOCALSEND_INFO}", timeout=PROBE_TIMEOUT, context=context):
            return True
    except (urllib.error.URLError, OSError):
        return False


def command_localsend_receive(device, args: argparse.Namespace):
    if running := localsend_running():
        raise Failure(EXIT_BUSY, "busy", f"a LocalSend peer already runs (process {running['pid']}); stop it first", "inkctl localsend stop")
    protocol = "http" if args.http else "https"
    if localsend_answers("http", args.port) or localsend_answers("https", args.port):
        raise Failure(EXIT_BUSY, "busy", f"port {args.port} already answers LocalSend: quit the LocalSend app or pass --port")
    folder = Path(os.path.abspath(args.folder))
    folder.mkdir(parents=True, exist_ok=True)
    command = [
        localgo(), "serve", "--auto-accept", "--no-clipboard", "--quiet", "--alias", args.alias,
        "--port", str(args.port), "--dir", str(folder), "--history", str(folder / "history.jsonl"),
        *(["--http"] if args.http else []),
    ]
    with open(folder / "localgo.log", "ab") as output:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=output, stderr=output, start_new_session=True)
    state = {"pid": process.pid, "protocol": protocol, "port": args.port, "alias": args.alias, "folder": str(folder)}
    LOCALSEND_STATE.parent.mkdir(parents=True, exist_ok=True)
    LOCALSEND_STATE.write_text(json.dumps(state))
    started = time.monotonic()
    while not localsend_answers(protocol, args.port):
        if process.poll() is not None or time.monotonic() - started >= LOCALSEND_START_TIMEOUT:
            stop_localsend(state)
            raise Failure(EXIT_FAILED, "device_error", f"localgo did not answer on port {args.port}; see {folder / 'localgo.log'}")
        time.sleep(WAIT_INTERVAL)
    return state, f"LocalSend peer «{args.alias}» receives over {protocol} on port {args.port} into {folder} (process {process.pid})"


def received_files(folder: str) -> list[str]:
    root = Path(folder)
    kept = ("localgo.log", "history.jsonl")
    return sorted(str(path.relative_to(root)) for path in root.rglob("*") if path.is_file() and path.name not in kept)


def stop_localsend(state: dict) -> None:
    import signal

    try:
        os.killpg(state["pid"], signal.SIGTERM)  # its own session: the group is localgo alone
    except ProcessLookupError:
        pass
    deadline = time.monotonic() + LOCALSEND_START_TIMEOUT
    while time.monotonic() < deadline:
        try:
            os.kill(state["pid"], 0)
        except ProcessLookupError:
            break
        try:
            os.waitpid(state["pid"], os.WNOHANG)  # reaps it when this process started it
        except ChildProcessError:
            pass
        time.sleep(WAIT_INTERVAL)
    else:
        raise Failure(EXIT_TIMEOUT, "timeout", f"localgo (process {state['pid']}) still runs after the stop")
    LOCALSEND_STATE.unlink(missing_ok=True)


def command_localsend_stop(device, args: argparse.Namespace):
    state = localsend_running()
    if not state:
        return {"stopped": False}, "no LocalSend peer runs"
    stop_localsend(state)
    files = received_files(state["folder"])
    return {"stopped": True, **state, "received": files}, f"LocalSend peer stopped; {len(files)} files in {state['folder']}"


def command_localsend_send(device, args: argparse.Namespace):
    """Send files, or with --text one LocalSend text message: LocalGo's `--stdin` sends it with its
    preview, which a receiver reads as a text, where a .txt file is a file with no preview, refused by
    Device Link (403, device round 11, #289)."""
    if bool(args.to) == bool(args.ip):
        raise bad_usage("give the receiver as --to ALIAS or --ip ADDRESS")
    if bool(args.paths) == (args.text is not None):
        raise bad_usage("give FILE... or --text TEXT, not both")
    if args.text is not None and not args.text.strip():
        raise bad_usage("--text needs a text")
    for path in args.paths:
        if not os.path.exists(path):
            raise not_found(path)
    files = ["--stdin"] if args.text is not None else [part for path in args.paths for part in ("--file", path)]
    command = [localgo(), "send", *files, *(["--to", args.to] if args.to else ["--ip", args.ip])]
    try:
        done = subprocess.run(command, input=args.text, stdin=None if args.text is not None else subprocess.DEVNULL, capture_output=True, text=True, timeout=args.timeout, check=False)
    except subprocess.TimeoutExpired:
        raise Failure(EXIT_TIMEOUT, "timeout", f"the send took more than {args.timeout:g} s") from None
    if done.returncode != 0:
        raise Failure(EXIT_FAILED, "device_error", (done.stderr or done.stdout).strip()[:ERROR_EXCERPT] or "localgo send failed")
    target = args.to or args.ip
    if args.text is not None:
        return {"sent": [], "text": args.text, "to": target, "answer": done.stdout.strip()}, f"sent a text of {len(args.text)} characters to {target}"
    return {"sent": args.paths, "to": target, "answer": done.stdout.strip()}, f"sent {len(args.paths)} files to {target}"


def command_shell(device: Device, args: argparse.Namespace):
    done = device.adb("shell", *args.words, timeout=TRANSFER_TIMEOUT)
    sys.stdout.buffer.write(done.stdout)
    sys.stderr.buffer.write(done.stderr)
    raise SystemExit(done.returncode)


