def keychain_failure(message: str) -> Failure:
    return Failure(EXIT_FAILED, "keychain_error", message)


def keychain_read(account: str) -> str | None:
    """The item's secret, or None when there is none. The value never reaches argv or the output."""
    try:
        done = subprocess.run(
            ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-a", account, "-w"],
            stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=KEYCHAIN_TIMEOUT, check=False,
        )
    except FileNotFoundError:
        raise keychain_failure("`security` is missing: the Google sign-in runs on a Mac") from None
    except subprocess.TimeoutExpired:
        raise keychain_failure("the login Keychain did not answer; unlock it and try again") from None
    return done.stdout.rstrip("\n") if done.returncode == 0 else None


def keychain_store_token(token: str) -> None:
    """Store the refresh token through `security -i`: the command line goes on stdin, so the token is in no argv."""
    if not REFRESH_TOKEN_SHAPE.fullmatch(token):
        raise Failure(EXIT_FAILED, "google_refused", "Google answered a refresh token of an unexpected shape; nothing was stored")
    line = (
        f'add-generic-password -U -s {KEYCHAIN_SERVICE} -a {GOOGLE_TOKEN_ACCOUNT} '
        f'-l "{GOOGLE_TOKEN_LABEL}" -j "{GOOGLE_TOKEN_COMMENT}" -w {token}\n'
    )
    try:
        subprocess.run(["security", "-i"], input=line, capture_output=True, text=True, timeout=KEYCHAIN_TIMEOUT, check=False)
    except subprocess.TimeoutExpired:
        raise keychain_failure("the login Keychain did not answer; unlock it and try again") from None
    # `security -i` exits 0 even when a command inside it failed, so only the read-back proves the write.
    if keychain_read(GOOGLE_TOKEN_ACCOUNT) != token:
        raise keychain_failure(f"the refresh token was not stored in the Keychain item {KEYCHAIN_SERVICE} / {GOOGLE_TOKEN_ACCOUNT}")


def google_client() -> dict:
    raw = keychain_read(GOOGLE_CLIENT_ACCOUNT)
    if raw is None:
        raise Failure(
            EXIT_NOT_FOUND, "google_client",
            f"no Keychain item {KEYCHAIN_SERVICE} / {GOOGLE_CLIENT_ACCOUNT}: store the «Desktop app» client's JSON there",
        )
    try:
        client = json.loads(raw).get("installed")
    except (json.JSONDecodeError, AttributeError):
        client = None
    if not isinstance(client, dict) or not all(isinstance(client.get(key), str) for key in ("client_id", "client_secret", "auth_uri", "token_uri")):
        raise Failure(EXIT_FAILED, "google_client", "the Keychain client is not a «Desktop app» client's JSON (no `installed` block)")
    for key in ("auth_uri", "token_uri"):
        address = urllib.parse.urlsplit(client[key])
        # https only; plain http only to this computer, which the tests' fake endpoint uses.
        if not (address.scheme == "https" or (address.scheme == "http" and address.hostname == LOOPBACK_HOST)):
            raise Failure(EXIT_FAILED, "google_client", f"the client's {key} is not an https address")
    return client


def pkce_pair() -> tuple[str, str]:
    import base64
    import secrets

    verifier = secrets.token_urlsafe(VERIFIER_BYTES)
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
    return verifier, challenge


def google_exchange(client: dict, code: str, redirect: str, verifier: str) -> dict:
    body = urllib.parse.urlencode({
        "code": code, "client_id": client["client_id"], "client_secret": client["client_secret"],
        "redirect_uri": redirect, "grant_type": "authorization_code", "code_verifier": verifier,
    }).encode()
    request = urllib.request.Request(client["token_uri"], data=body, headers={"Accept": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=TOKEN_EXCHANGE_TIMEOUT) as answer:
            return json.load(answer)
    except urllib.error.HTTPError as refused:
        try:
            reason = json.load(refused).get("error", "")
        except (ValueError, AttributeError):
            reason = ""
        raise Failure(EXIT_FAILED, "google_refused", f"Google refused the code (HTTP {refused.code} {reason})".replace(" )", ")")) from None
    except (urllib.error.URLError, OSError, ValueError) as lost:
        raise Failure(EXIT_FAILED, "network_error", f"Google's token endpoint did not answer: {lost}", cause="Google's sign-in server could not be reached", next_step="inkctl google login") from None


def login_page(failure: Failure | None) -> bytes:
    try:
        icon = PROJECT_ICON.read_text()
    except OSError:
        icon = ""  # a copy of the command without the repository still shows the name
    if failure is None:
        fields = {
            "state": "signed-in", "mark": "&#10003;", "title": "Signed in to Google",
            "detail": "Account Sync may now read your calendars and add events. The sign-in is kept in this Mac's login Keychain.",
            "next": "Close this tab and go back to the terminal.",
        }
    else:
        fields = {
            "state": "failed", "mark": "&#10005;", "title": "Sign-in failed",
            "detail": html.escape(failure.message),
            "next": "Close this tab and run <code>inkctl google login</code> again in the terminal.",
        }
    return LOGIN_PAGE.format(icon=icon, **fields).encode()


def open_consent(address: str) -> None:
    """Open the consent page. $INKCTL_BROWSER, when set, is the only opener: the tests set it to a stub,
    so a test never reaches the person's real browser (#124)."""
    opener = os.environ.get("INKCTL_BROWSER")
    if opener:
        subprocess.Popen([opener, address], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return
    import webbrowser

    webbrowser.open(address)


def command_google_login(device, args: argparse.Namespace):
    import hmac
    import http.server
    import secrets

    client = google_client()
    state = secrets.token_urlsafe(STATE_BYTES)
    verifier, challenge = pkce_pair()
    outcome: dict = {}

    class Redirect(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            if not any(key in query for key in ("state", "code", "error")):
                self.send_error(http.HTTPStatus.NOT_FOUND)  # such as the browser's favicon request: keep waiting
                return
            failure = None
            try:
                outcome["result"] = finish(query)
            except Failure as refused:
                failure = outcome["failure"] = refused
            page = login_page(failure)
            self.send_response(http.HTTPStatus.OK if failure is None else http.HTTPStatus.BAD_REQUEST)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(page)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(page)

        def log_message(self, *ignored):
            pass  # the request line holds the code

    def finish(query: dict) -> dict:
        if not hmac.compare_digest(query.get("state", [""])[0], state):
            raise Failure(EXIT_FAILED, "google_denied", "the answer's state does not match this sign-in; nothing was stored")
        if "error" in query:
            raise Failure(EXIT_FAILED, "google_denied", f"Google did not sign in: {query['error'][0]}")
        tokens = google_exchange(client, query.get("code", [""])[0], redirect, verifier)
        granted = str(tokens.get("scope", "")).split()
        missing = [scope.rsplit("/", 1)[-1] for scope in GOOGLE_SCOPES if scope not in granted]
        if missing:
            raise Failure(EXIT_FAILED, "google_refused", f"the consent left out {', '.join(missing)}; tick every box and sign in again. Nothing was stored")
        token = tokens.get("refresh_token")
        if not isinstance(token, str) or not token:
            raise Failure(EXIT_FAILED, "google_refused", "Google answered no refresh token; nothing was stored")
        keychain_store_token(token)
        return {"length": len(token), "scopes": granted}

    with http.server.HTTPServer((LOOPBACK_HOST, 0), Redirect) as server:
        redirect = f"http://{LOOPBACK_HOST}:{server.server_port}"
        address = client["auth_uri"] + "?" + urllib.parse.urlencode({
            "client_id": client["client_id"], "redirect_uri": redirect, "response_type": "code",
            "scope": " ".join(GOOGLE_SCOPES), "state": state, "code_challenge": challenge,
            "code_challenge_method": "S256", "access_type": "offline", "prompt": "consent",
        })
        # The address holds no secret: the client id is public and the state works once.
        print(f"inkctl: finish the sign-in in the browser; if none opened, open:\n{address}", file=sys.stderr, flush=True)
        open_consent(address)
        deadline = time.monotonic() + args.timeout
        while not outcome:
            left = deadline - time.monotonic()
            if left <= 0:
                raise Failure(EXIT_TIMEOUT, "timeout", f"no answer from the browser within {args.timeout:g} seconds", next_step="inkctl google login")
            server.timeout = left
            server.handle_request()
    if "failure" in outcome:
        raise outcome["failure"]
    result = outcome["result"]
    data = {
        "signed_in": True, "length": result["length"], "scopes": result["scopes"],
        "keychain": {"service": KEYCHAIN_SERVICE, "account": GOOGLE_TOKEN_ACCOUNT}, "next": GOOGLE_PUSH_STEP,
    }
    text = (
        f"google: signed in; refresh token (length {result['length']}) stored in the login Keychain "
        f"({KEYCHAIN_SERVICE} / {GOOGLE_TOKEN_ACCOUNT})\nnext, to send it to Account Sync: {GOOGLE_PUSH_STEP}"
    )
    return data, text


def command_shell(device: Device, args: argparse.Namespace):
    done = device.adb("shell", *args.words, timeout=TRANSFER_TIMEOUT)
    sys.stdout.buffer.write(done.stdout)
    sys.stderr.buffer.write(done.stderr)
    raise SystemExit(done.returncode)


