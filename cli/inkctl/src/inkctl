def poll_seconds(value: str | None) -> float | None:
    """The poll interval $INKCTL_POLL_SECONDS gives, the default when it is unset, or None when it is not a number in range."""
    if value is None or value == "":
        return POLL_SECONDS_DEFAULT
    try:
        seconds = float(value)
    except ValueError:
        return None
    low, high = POLL_SECONDS_RANGE
    return seconds if low <= seconds <= high else None


