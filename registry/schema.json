{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/martonpaulo/ink-tools/registry/schema.json",
  "title": "The registry of Supernote internals (#294)",
  "description": "One file of registry/items/ per device area. scripts/registry.py validates every file against $defs.area and registry/registry.json against $defs.registry, then writes the readers.",
  "$defs": {
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "descriptor", "ceilings"],
      "properties": {
        "version": {"type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$", "description": "The registry's version, a date; the firmware watch's fingerprint holds it (#293)."},
        "descriptor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "version", "device"],
          "description": "The header of sn-adapter's descriptor.json, which the registry writes.",
          "properties": {
            "schema": {"type": "integer", "minimum": 1},
            "version": {"type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}$"},
            "device": {"type": "object"}
          }
        },
        "ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["2", "3", "4", "5"],
          "description": "The ratchet: at most this many items at each level below 1; a ceiling only goes down.",
          "properties": {
            "2": {"type": "integer", "minimum": 0},
            "3": {"type": "integer", "minimum": 0},
            "4": {"type": "integer", "minimum": 0},
            "5": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "items"],
      "properties": {
        "area": {"type": "string", "pattern": "^[a-z][a-z-]*$"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
      }
    },
    "tool": {
      "type": "string",
      "enum": ["sn-adapter", "ui-kit", "picture-search", "account-sync", "smart-pen", "image-editing", "device-transfer", "plugin-diagnostics", "word-lookup", "handwriting-language", "inktools-bridge", "inkctl", "ink-notebook-editor"]
    },
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "value": {
      "oneOf": [
        {"type": "string"},
        {"type": "integer"},
        {"type": "boolean"},
        {"type": "array", "items": {"type": "string"}},
        {"type": "array", "items": {"type": "integer"}}
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "level", "impact", "owner", "readers", "evidence", "upgradePath", "lastVerified", "publicApiRequest", "probe", "active", "values"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z-]*\\.[a-z][a-z0-9-]*$", "description": "<area>.<name>; the area is the file's."},
        "title": {"type": "string", "minLength": 1},
        "level": {"type": "integer", "minimum": 1, "maximum": 5, "description": "docs/architecture.md › Layer rules: 1 official or our own code, 2 internal data, 3 internal vendor code and screens, 4 screen automation, 5 behaviour learned from decompiled code."},
        "impact": {"type": "string", "enum": ["user", "tests"]},
        "owner": {"$ref": "#/$defs/tool"},
        "readers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tool"}, "description": "Every tool whose reader holds the item, the owner first."},
        "reason": {"type": "string", "minLength": 1, "description": "Why no higher level serves; required below level 1."},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "date"],
          "properties": {
            "source": {"type": "string", "minLength": 1, "description": "The decompiled class or method, the measurement or the document."},
            "version": {"type": "string", "description": "The vendor app's version the evidence was read in."},
            "date": {"$ref": "#/$defs/date"}
          }
        },
        "upgradePath": {"type": "string", "minLength": 1, "description": "What would move the item to a higher level."},
        "lastVerified": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "string", "enum": ["unverified"]}], "description": "The last day a device round or a probe saw the item hold."},
        "publicApiRequest": {"type": "string", "minLength": 1, "description": "What was asked of Ratta, or «not asked»."},
        "probe": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}}},
            {"type": "object", "additionalProperties": false, "required": ["unprobed"], "properties": {"unprobed": {"type": "string", "minLength": 1, "description": "Why no safe probe exists yet, and the accepted risk."}}}
          ]
        },
        "active": {"type": "string", "minLength": 1, "description": "The implementation that serves the item now."},
        "issues": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "values": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][A-Za-z0-9]*$"},
          "additionalProperties": {"$ref": "#/$defs/value"},
          "description": "The names a tool reads, each a string, an integer, a boolean or a list of strings or integers."
        },
        "descriptor": {"type": "object", "description": "A provider module of sn-adapter's descriptor.json, written there as it is."}
      }
    }
  }
}
