        215,
        293
      ],
      "values": {
        "install": 1,
        "uninstall": 5,
        "setEnable": 6,
        "updatePermissions": 9,
        "installMethod": "installPlugin",
        "uninstallMethod": "uninstallPlugin",
        "setEnableMethod": "setPluginEnable",
        "updatePermissionsMethod": "updatePluginPermissions"
      }
