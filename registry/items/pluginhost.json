      "level": 5,
      "impact": "tests",
      "owner": "inktools-bridge",
      "readers": [
        "inktools-bridge"
      ],
      "reason": "the numbers come from the decompiled AIDL; a reordered interface would run another method, so each call checks the name behind its number first",
      "evidence": {
        "source": "IPluginSetting$Stub, decompiled",
        "version": "PluginHost 1.00.2610150",
        "date": "2026-11-17"
      },
      "upgradePath": "read every number from the Stub's TRANSACTION_ constants at run time (level 3)",
      "lastVerified": "2026-11-17",
      "publicApiRequest": "not asked",
      "probe": {
        "name": "inktools-bridge call-number check"
      },
      "active": "inktools-bridge HostCalls.java",
