{
  "area": "todo",
  "items": [
    {
      "id": "todo.provider",
      "title": "The To-Do provider's authority, tables and columns",
      "level": 2,
      "impact": "user",
      "owner": "sn-adapter",
      "readers": [
        "sn-adapter",
        "ink-tools-probe",
        "inkctl"
      ],
      "reason": "sn-plugin-lib has no task API; the provider is the only way to read and write tasks",
      "evidence": {
        "source": "TaskContentProvider and DataBaseTools.insert, observed device behaviour (#212)",
        "version": "1.00.466",
        "date": "2026-11-17"
      },
      "upgradePath": "an official task API in sn-plugin-lib",
      "lastVerified": "2026-11-17",
      "publicApiRequest": "not asked",
      "probe": {
        "name": "sn-adapter probeCapability(todo)"
      },
      "active": "sn-adapter internals/todo.ts",
      "issues": [
        212,
        101
      ],
      "values": {},
      "descriptor": {
        "authority": "com.ratta.supernote.task.provider",
        "tables": {
          "tasks": {
            "path": "tasks_table",
            "columns": [
              "id",
              "taskListId",
              "taskId",
              "title",
              "detail",
              "lastModified",
              "recurrence",
              "isReminderOn",
              "status",
              "importance",
              "dueTime",
              "completedTime",
              "links",
              "deleted",
              "hasSync",
              "sort",
              "sortCompleted",
              "sortTime",
              "plannedSort",
              "plannedSortTime"
            ],
            "fields": {
              "rowId": "id",
              "listId": "taskListId",
              "taskId": "taskId",
              "title": "title",
              "detail": "detail",
              "modified": "lastModified",
              "status": "status",
              "due": "dueTime",
              "completedAt": "completedTime",
              "deleted": "deleted",
              "hasSync": "hasSync"
            }
          },
          "groups": {
            "path": "task_group_table",
            "columns": [
              "id",
              "taskListId",
              "userId",
              "title",
              "lastModified",
              "deleted",
              "hasSync",
              "createTime"
            ],
            "fields": {
              "rowId": "id"
            }
          }
        },
        "rules": {
          "requiredOnInsert": [
            "title",
            "taskId"
          ],
          "needsExistingList": true,
          "allowNoList": true,
          "writeHasSync": 0,
          "insertDefaults": {
            "deleted": 0,
            "isReminderOn": 0,
            "dueTime": 0,
            "completedTime": 0,
            "sort": 0,
            "sortCompleted": 0,
            "plannedSort": 0
          },
          "insertNow": [
            "lastModified",
            "sortTime",
            "plannedSortTime"
          ],
          "statusOpen": "needsAction",
          "statusCompleted": "completed",
          "timeUnit": "ms"
        }
      }
    },
