  "area": "calendar",
  "items": [
    {
      "id": "calendar.provider",
      "title": "The Calendar provider's authority, tables and columns",
      "level": 2,
      "impact": "user",
      "owner": "sn-adapter",
      "readers": [
        "sn-adapter",
        "ink-tools-probe",
        "inkctl"
      ],
      "reason": "sn-plugin-lib has no calendar API; the provider is the only way to read and write events",
      "evidence": {
        "source": "CalendarContentProvider, a real data_info row read on the tablet (#43)",
        "version": "1.00.532",
        "date": "2026-11-17"
      },
      "upgradePath": "an official calendar API in sn-plugin-lib",
      "lastVerified": "2026-11-17",
      "publicApiRequest": "not asked",
      "probe": {
        "name": "sn-adapter probeCapability(calendar)"
      },
      "active": "sn-adapter internals/calendar.ts",
      "issues": [
        43,
        101
      ],
      "values": {},
      "descriptor": {
        "authority": "com.ratta.supernote.calendar.provider",
        "tables": {
          "events": {
            "path": "data_info",
            "columns": [
              "id",
              "calendarId",
              "eventId",
              "tag",
              "state",
              "readOnly",
              "isAllDay",
              "isSelf",
              "title",
              "content",
              "startTime",
              "endTime",
              "startDate",
              "endDate",
              "lastModifiedTime",
              "status",
              "recurrence",
              "recurringEventId",
              "originalStartTime",
              "originalStartDate"
            ],
            "fields": {
              "rowId": "id",
              "eventId": "eventId",
              "calendarId": "calendarId",
              "tag": "tag",
              "readOnly": "readOnly",
              "allDay": "isAllDay",
              "title": "title",
              "content": "content",
              "start": "startTime",
              "end": "endTime",
              "startDate": "startDate",
              "endDate": "endDate",
              "modified": "lastModifiedTime",
              "status": "status",
              "state": "state"
            }
          },
          "config": {
            "path": "config_info",
            "columns": []
          }
        },
        "rules": {
          "writeTag": "task",
          "cancelledStatus": "cancelled",
          "writeStatus": "confirmed",
          "writeState": 0,
          "linkPrefix": "inktools:",
          "requiredOnInsert": [
            "calendarId",
            "tag",
            "state",
            "readOnly",
            "isAllDay",
            "title",
            "startTime",
            "endTime",
            "lastModifiedTime",
            "status"
          ]
        }
      }
    },
