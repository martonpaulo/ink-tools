    "photo"
   ]
  },
  "real-time-conversion": {
   "motif": [
    "text-recognition"
   ]
  },
  "lasso-actions": {
   "motif": [
    "search"
   ],
   "except": {
    "icon": "the plugin's own icon, the lasso, stands for every module; the motif marks Lookup's buttons",
    "translate-es-pt": "two language codes and their arrow fill the box",
    "translate-pt-es": "as translate-es-pt",
    "translate-pt-zh": "as translate-es-pt",
    "translate-zh-pt": "as translate-es-pt"
   }
  },
  "collection": {
   "motif": [
    "clipboard",
    "clipboard-list"
   ]
  },
  "headings": {
   "motif": [
    "letter-h"
   ]
