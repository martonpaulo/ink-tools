    "stethoscope"
   ]
  }
 },
 "badge": {
  "about": "A part marked `badge` is scaled by `scale` and moved by `at` into the bottom-right corner, and cuts the strokes drawn before it `gap` grid units around its box, as Tabler's own badged glyphs do (photo-search, file-export), so the base keeps its full size. A badge part may set its own `scale` and `at`; any part may keep some of its glyph's `paths` (indices).",
  "scale": 0.5,
  "at": [
   13,
   13
  ],
  "gap": 3
 }
